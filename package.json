  "devDependencies": {
    "@storybook-astro/framework": "^1.9.0",
    "@storybook/builder-vite": "^10.5.4",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "storybook": "^10.5.4",
    "vitest": "^4.1.10"
  }
