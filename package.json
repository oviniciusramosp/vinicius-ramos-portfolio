    "travel:photos:check": "python3 scripts/check-travel-photos.py",
    "travel:notion:pull": "node scripts/sync-travel-notion.mjs pull",
    "travel:notion:schema": "node scripts/sync-travel-notion.mjs schema",
    "travel:notion:sync": "node scripts/sync-travel-notion.mjs sync",
    "travel:notion:seed": "node scripts/sync-travel-notion.mjs seed",
    "travel:notion:seed:paris": "node scripts/sync-travel-notion.mjs seed src/data/paris-seed-dump.json",
    "travel:notion:migrate": "node scripts/sync-travel-notion.mjs migrate",
    "travel:notion:placeids": "node scripts/sync-travel-notion.mjs placeids",
    "travel:notion:seed-subcategories": "node scripts/sync-travel-notion.mjs seed-subcategories",
    "travel:notion:seed-photos": "node scripts/sync-travel-notion.mjs seed-photos",
