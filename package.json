  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@maplibre/maplibre-gl-leaflet": "^0.1.3",
    "astro": "^7.1.3",
    "leaflet": "^1.9.4",
    "lottie-web": "^5.12.2",
    "maplibre-gl": "^5.24.0",
    "sharp": "^0.35.3",
    "three": "^0.185.1"
