{
  "name": "vinicius-ramos-portfolio",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "travel:areas": "python3 scripts/fetch-travel-polygons.py",
    "travel:areas:force": "python3 scripts/fetch-travel-polygons.py --force",
