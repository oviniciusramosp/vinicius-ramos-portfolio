---
/**
 * Storybook stage for LogoWave — optional header chrome + intro mode.
 */
import LogoWave from '../components/LogoWave.astro';

interface Props {
  inHeader?: boolean;
  intro?: 'once' | 'always' | 'off';
  hint?: string;
}

const {
  inHeader = false,
  intro = 'always',
  hint = 'Hover the logo — radial width-wave (Blatant Bold alts)',
} = Astro.props;
---

<div class:list={['lw-stage', inHeader && 'lw-stage--header']}>
  {hint && <p class="lw-stage__hint">{hint}</p>}

  {
    inHeader ? (
      <div class="lw-stage__nav" aria-label="Navbar preview">
        <LogoWave intro={intro} />
        <div class="lw-stage__nav-links" aria-hidden="true">
          <span class="lw-stage__fake-link">Resume</span>
          <span class="lw-stage__fake-link">Contact</span>
        </div>
      </div>
    ) : (
      <LogoWave intro={intro} />
    )
  }
</div>

<style>
  .lw-stage {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    min-width: min(100%, 520px);
  }

  .lw-stage--header {
    min-width: min(100vw, 720px);
  }

  .lw-stage__hint {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.5;
    max-width: 42rem;
  }

  .lw-stage__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: 100%;
    height: var(--nav-height);
    padding: 0 24px;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(var(--blur-nav));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .lw-stage__nav-links {
    display: flex;
    gap: 24px;
    flex-shrink: 0;
  }

  .lw-stage__fake-link {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-soft);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
</style>
