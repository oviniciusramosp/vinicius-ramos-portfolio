---
/**
 * Storybook demo: Blatant width-wave on arbitrary uppercase text
 * (same engine as navbar logo + page-transition labels).
 */
interface Props {
  text?: string;
  color?: string;
  /** Play L→R sweep on mount */
  autoSweep?: boolean;
  hint?: string;
}

const {
  text = 'RESUME',
  color = '#008fff',
  autoSweep = true,
  hint = 'Width-wave on transition-style type. Hover after intro, or remount story to replay.',
} = Astro.props;
---

<div class="wt-stage" data-wave-text-stage data-text={text} data-auto-sweep={autoSweep ? '1' : '0'}>
  {hint && <p class="wt-stage__hint">{hint}</p>}
  <div
    class="wt-stage__label"
    data-wave-text-host
    style={`color: ${color}`}
    aria-label={text}
  >
  </div>
  <div class="wt-stage__actions">
    <button type="button" class="wt-stage__btn" data-wave-replay>Replay sweep</button>
  </div>
</div>

<script>
  import { mountWaveText, type WaveHandle } from '../scripts/logo-wave';
  import waveGlyphs from '../data/blatant-wave-glyphs.json';
  import type { LogoWaveData } from '../scripts/logo-wave';

  const data = waveGlyphs as LogoWaveData;
  const handles = new WeakMap<HTMLElement, WaveHandle>();

  function boot(root: ParentNode = document) {
    root.querySelectorAll<HTMLElement>('[data-wave-text-stage]').forEach((stage) => {
      if (stage.dataset.waveBooted === '1') return;
      stage.dataset.waveBooted = '1';

      const host = stage.querySelector<HTMLElement>('[data-wave-text-host]');
      const text = (stage.dataset.text || 'RESUME').toUpperCase();
      const auto = stage.dataset.autoSweep === '1';
      if (!host) return;

      const handle = mountWaveText(host, text, data, {
        intro: auto ? true : false,
        pointer: true,
        introDurationMs: 1600,
      });
      handles.set(stage, handle);

      stage.querySelector('[data-wave-replay]')?.addEventListener('click', () => {
        handles.get(stage)?.playSweep({ durationMs: 1600, peak: 0.95 });
      });
    });
  }

  boot();
  document.addEventListener('astro:page-load', () => boot());
</script>

<style>
  .wt-stage {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    min-width: min(100vw, 640px);
    padding: 32px 24px;
    border-radius: var(--radius-card);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .wt-stage__hint {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.5;
    max-width: 40rem;
  }

  .wt-stage__label {
    font-size: clamp(40px, 10vw, 96px);
    line-height: 1;
    color: var(--color-accent);
    width: max-content;
    max-width: 100%;
  }

  /* Same unscoped layout helpers as page-mask */
  .wt-stage__label :global(.logo-wave) {
    display: inline-flex;
    align-items: center;
    font-size: 1em;
    color: inherit;
    max-width: none;
  }

  .wt-stage__label :global(.logo-wave__sr) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }

  .wt-stage__label :global(.logo-wave__row) {
    display: inline-flex;
    align-items: center;
    column-gap: 0.4px;
    height: 1em;
  }

  .wt-stage__label :global(.logo-wave__letter),
  .wt-stage__label :global(.logo-wave__space) {
    display: block;
    flex: 0 0 auto;
    height: 1em;
  }

  .wt-stage__label :global(.logo-wave__letter svg) {
    display: block;
    width: 100%;
    height: 1em;
    overflow: visible;
  }

  .wt-stage__actions {
    display: flex;
    gap: 8px;
  }

  .wt-stage__btn {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 10px 14px;
    border-radius: var(--radius-btn);
    border: 1px solid var(--color-border-strong);
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
  }

  .wt-stage__btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
</style>
