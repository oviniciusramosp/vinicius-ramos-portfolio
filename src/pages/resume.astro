---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { resume, type ResumeIntroBlock } from '../data/resume';
import { site } from '../data/site';
import {
  breadcrumbJsonLd,
  jsonLdGraph,
  personJsonLd,
  webPageJsonLd,
  websiteJsonLd,
} from '../utils/seo';

function isRichIntro(
  block: ResumeIntroBlock,
): block is Extract<ResumeIntroBlock, { link: unknown }> {
  return typeof block === 'object' && block !== null && 'link' in block;
}

const pageTitle = `${site.name} · Resume`;
const pageDescription = site.pages.resume;

const jsonLd = jsonLdGraph([
  personJsonLd(),
  websiteJsonLd(),
  webPageJsonLd({
    path: '/resume',
    title: pageTitle,
    description: pageDescription,
    type: 'ProfilePage',
  }),
  breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Resume', path: '/resume' },
  ]),
]);
---

<BaseLayout title={pageTitle} description={pageDescription} jsonLd={jsonLd}>
  <article class="resume">
    <!-- Hero — screen: name/role/location → divider → about.
         Print/PDF: name full-width, then role+location | intro (classic resume). -->
    <header class="resume__hero">
      <div class="resume__title-row">
        <div class="resume__title-text">
          <h1 class="resume__name">{resume.name}</h1>
          <!-- Screen only: role/location under name (Framer). Print pulls
               .resume__identity (below) into a side column via grid. -->
          <div class="resume__identity resume__identity--screen no-print">
            <p class="resume__role">{resume.role}</p>
            <p class="resume__location">{resume.location}</p>
          </div>
        </div>
        <div class="resume__actions no-print">
          <Button
            label="Download PDF"
            variant="solid"
            class="resume__pdf-btn"
            href="/Vinicius-Ramos-Resume.pdf"
            download="Vinicius-Ramos-Resume.pdf"
          />
        </div>
      </div>

      <!-- Print-only identity column (same copy; screen uses --screen above) -->
      <div class="resume__identity resume__identity--print print-only">
        <p class="resume__role">{resume.role}</p>
        <p class="resume__location">{resume.location}</p>
      </div>

      <div class="resume__divider resume__divider--hero no-print" aria-hidden="true"></div>

      <section class="resume__intro" aria-label="About">
        {
          resume.intro.map((block) =>
            isRichIntro(block) ? (
              <p class="resume__intro-p">
                {block.before}
                <a class="resume__inline-link" href={block.link.href}>
                  {block.link.label}
                </a>
                {block.after}
              </p>
            ) : (
              <p class="resume__intro-p">{block}</p>
            ),
          )
        }
      </section>
    </header>

    <!-- Main Work Experience — Framer: SectionInitialStages -->
    <section class="resume__section resume__section--experience">
      <h2 class="section-title resume__section-title">Main Work Experience</h2>
      <ul class="resume-timeline">
        {
          resume.experience.map((job) => (
            <li class="resume-row resume-row--job">
              <div
                class="resume-row__duration resume-row__duration--job"
                aria-label={`${job.periodStart} ${job.periodEnd}`}
              >
                <span class="resume-row__period-line">{job.periodStart}</span>
                <span class="resume-row__period-line">{job.periodEnd}</span>
              </div>
              <div class="resume-row__content">
                <h3 class="resume-row__title">{job.title}</h3>
                <p class="resume-row__body">{job.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Divider between experience and skills — Framer: DividerArea -->
    <div class="resume__divider-area" aria-hidden="true">
      <div class="resume__divider"></div>
    </div>

    <!-- Skills + Education — Framer: SectionSkillsAndEducation -->
    <section class="resume__section resume__section--skills-edu">
      <div class="resume__skills">
        <h2 class="section-title resume__section-title">Skills</h2>
        <!-- Live: two SkillLists side-by-side (row, gap 24) -->
        <div class="skill-columns">
          <ul class="skill-list">
            {resume.skills.main.map((skill) => <li>-> {skill}</li>)}
          </ul>
          <div class="skill-list skill-list--other">
            <p class="skills-other-label">Other Skills:</p>
            <ul class="skill-list">
              {resume.skills.other.map((skill) => <li>-> {skill}</li>)}
            </ul>
          </div>
        </div>
      </div>

      <div class="resume__education">
        <h2 class="section-title resume__section-title">Education</h2>
        <ul class="resume-timeline resume-timeline--edu">
          {
            resume.education.map((item) => (
              <li class="resume-row resume-row--edu">
                <div class="resume-row__duration resume-row__duration--edu">
                  <span class="resume-row__period-line">{item.period}</span>
                </div>
                <div class="resume-row__content">
                  <p class="resume-row__title">{item.school}</p>
                  <p class="resume-row__body">{item.detail}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Contact — print/PDF footer (classic resume “Reach Me Out”) -->
    <section class="resume__section resume__section--contact print-only" aria-label="Contact">
      <div class="resume__divider resume__divider--contact" aria-hidden="true"></div>
      <h2 class="section-title resume__section-title">Reach Me Out</h2>
      <ul class="resume-contact">
        {
          (
            [
              resume.contact.email,
              resume.contact.whatsapp,
              resume.contact.linkedin,
              resume.contact.portfolio,
            ] as const
          ).map((item) => (
            <li class="resume-contact__item">
              <span class="resume-contact__label">{item.label}</span>
              <a class="resume-contact__value" href={item.href}>{item.value}</a>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</BaseLayout>

<style>
  /*
   * Resume — mapped from live Framer (viniciusramos.com/resume)
   * Breakpoints: ≤809 mobile · 810–1193 tablet · ≥1536 xl
   */

  .resume {
    width: 100%;
    max-width: var(--shell-max);
    margin-inline: auto;
  }

  /* —— Hero —— */
  .resume__hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    width: 100%;
    padding: 125px 250px 48px;
    box-sizing: border-box;
  }

  /*
   * TitleArea: name → role → location, gap 8px (live measured).
   * Name: Blatant 42 / 1.2 → 50.4px
   * Role: mono 22 / 1, weight 400 (strong on live)
   * Location: Inter 14 / 1.7, opacity 0.5
   */
  .resume__title-area {
    width: 100%;
  }

  .resume__title-row {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    width: 100%;
  }

  .resume__title-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 8px;
    min-width: 0;
  }

  .resume__identity {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .resume__actions {
    flex: none;
    padding-top: 4px;
  }

  /* Screen-only chrome; print-only blocks reverse this */
  .print-only {
    display: none !important;
  }

  .resume__name {
    margin: 0;
    padding: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 42px;
    line-height: 1.2em;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .resume__role {
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 22px;
    font-weight: 400; /* live strong → bold token 400 on mono preset */
    line-height: 1; /* 22px box — critical for 8px gap rhythm */
    letter-spacing: 0;
    color: #ffffff;
  }

  .resume__location {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.7em;
    color: #ffffff;
    opacity: 0.5; /* live Subtitle container */
  }

  /* 1px rule — live color #4b485e (--color-text-muted) */
  .resume__divider {
    width: 100%;
    height: 1px;
    flex: none;
    background: var(--color-text-muted);
  }

  .resume__divider-area {
    width: 100%;
    padding: 0 250px;
    box-sizing: border-box;
  }

  .resume__intro {
    display: flex;
    flex-direction: column;
    gap: 0;
    width: 100%;
  }

  .resume__intro-p {
    margin: 0;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.7em;
    color: #ffffff;
  }

  /* Framer jultdo --framer-paragraph-spacing: 20px */
  .resume__intro-p + .resume__intro-p {
    margin-top: 20px;
  }

  .resume__inline-link {
    color: #9cd4ff;
    text-decoration: none;
    transition:
      color var(--duration-base) var(--ease-smooth),
      text-decoration-color var(--duration-base) var(--ease-smooth);
  }

  .resume__inline-link:hover,
  .resume__inline-link:focus-visible {
    color: var(--color-accent);
    text-decoration: underline;
  }

  /* —— Sections —— */
  .resume__section {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
    padding: 48px 250px;
    box-sizing: border-box;
  }

  .resume__section--experience {
    gap: 20px;
  }

  .resume__section--skills-edu {
    gap: 32px;
  }

  /*
   * Section titles: same .section-title token as case studies
   * (Blatant Bold, uppercase, accent). Only spacing is local.
   */
  .resume__section-title {
    margin: 0;
  }

  /* —— Timeline rows (jobs + education) —— */
  .resume-timeline {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .resume-timeline--edu {
    gap: 12px;
  }

  .resume-row {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    width: 100%;
  }

  .resume-row--job {
    gap: 24px;
  }

  .resume-row--edu {
    gap: 12px;
  }

  /* Live Duration: white text @ opacity 0.5 (not muted hex) */
  .resume-row__duration {
    flex: none;
    display: flex;
    flex-direction: column;
    opacity: 0.5;
    color: #ffffff;
  }

  .resume-row__duration--job {
    width: 100px;
    align-items: flex-end;
    text-align: right;
  }

  .resume-row__duration--edu {
    width: 84px;
    align-items: flex-start;
    text-align: left;
  }

  .resume-row__period-line {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.7em;
    color: inherit;
    white-space: nowrap;
  }

  .resume-row__content {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .resume-row__title {
    margin: 0;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.7em;
    color: #ffffff;
  }

  .resume-row__body {
    margin: 0;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.7em;
    color: #ffffff;
  }

  /* —— Skills —— */
  .resume__skills,
  .resume__education {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    width: 100%;
  }

  /* Live: framer-1b8u3yf — row, gap 24, two equal SkillLists */
  .skill-columns {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 24px;
    width: 100%;
  }

  .skill-list {
    display: flex;
    flex-direction: column;
    flex: 1 1 0;
    width: 0;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 400;
    line-height: 2; /* 28px on 14px */
    color: #ffffff;
  }

  .skill-list--other {
    width: 0;
  }

  .skill-list--other > .skill-list {
    width: 100%;
    flex: none;
  }

  .skills-other-label {
    margin: 0;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    line-height: 2;
    color: #ffffff;
  }

  /* —— Responsive —— */

  @media (max-width: 1193px) {
    .resume__hero {
      padding: 125px 64px 48px;
    }

    .resume__section {
      padding: 48px 64px;
    }

    .resume__divider-area {
      padding: 0 64px;
    }
  }

  @media (max-width: 809px) {
    .resume__hero {
      min-height: 320px;
      padding: 80px 16px 24px;
    }

    .resume__section {
      padding: 24px 16px;
    }

    .resume__divider-area {
      padding: 0 16px;
    }

    .resume__title-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }

    .resume__name {
      font-size: clamp(28px, 8vw, 42px);
    }

    .resume-row--job {
      flex-direction: column;
      gap: 4px;
    }

    .resume-row__duration--job {
      width: 100%;
      flex-direction: row;
      justify-content: flex-start;
      align-items: baseline;
      gap: 0.35em;
      text-align: left;
    }

    .resume-row--edu {
      flex-direction: column;
      gap: 2px;
    }

    .resume-row__duration--edu {
      width: 100%;
    }

    /* Skills stack on mobile (live ≤809) */
    .skill-columns {
      flex-direction: column;
      gap: 24px;
    }

    .skill-list,
    .skill-list--other {
      width: 100%;
      flex: none;
    }
  }

  /* XL: Skills block | Education side by side (live ≥1536) */
  @media (min-width: 1536px) {
    .resume__hero {
      padding: 125px 240px 48px;
    }

    .resume__section {
      padding: 48px 240px;
    }

    .resume__divider-area {
      padding: 0 240px;
    }

    .resume__section--skills-edu {
      flex-direction: row;
      align-items: flex-start;
    }

    .resume__skills,
    .resume__education {
      flex: 1 1 0;
      width: 0;
      min-width: 0;
    }
  }

  /* ============================================================
   * Print / PDF — reverse-engineered from Resume.pdf (A4, 595×842).
   * Measured at 150dpi render + OCR:
   *   margins ≈ 37pt · name ≈ 19pt · titles ≈ 12pt · body ≈ 7pt
   *   hero cols ≈ 36% | 64% · date col ≈ 70pt · skills|edu 50/50
   * color-scheme:light — site meta is dark; without this Chrome paints
   * @page margins black even when body bg is white.
   * ============================================================ */
  @media print {
    @page {
      size: A4;
      /* ~37pt sides / ~28pt top from designed PDF */
      margin: 10mm 13mm 12mm 13mm;
    }

    /* Hide site chrome; show print-only blocks */
    :global(.site-header),
    :global(.site-footer),
    :global(.site-cursor),
    :global(.page-mask),
    :global(.banner),
    :global(.skip-link),
    :global([data-site-header]),
    .no-print,
    .resume__actions {
      display: none !important;
    }

    .print-only {
      display: block !important;
    }

    :global(html) {
      color-scheme: only light !important;
      background: #ffffff !important;
    }

    :global(html),
    :global(body) {
      background: #ffffff !important;
      color: #1b1b2f !important;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
      font-size: 7pt !important;
      line-height: 1.38 !important;
      min-height: 0 !important;
    }

    :global(.page-shell),
    :global(.page-main) {
      display: block !important;
      min-height: 0 !important;
      height: auto !important;
      background: #ffffff !important;
      color: #1b1b2f !important;
    }

    .resume {
      max-width: none;
      width: 100%;
      background: #ffffff !important;
      color: #1b1b2f !important;
      font-family: var(--font-body);
      font-size: 7pt;
      line-height: 1.38;
    }

    /* —— Hero: name full width → identity (36%) | intro (64%) —— */
    .resume__hero {
      display: grid !important;
      grid-template-columns: 0.36fr 0.64fr;
      grid-template-areas:
        'name name'
        'id intro';
      column-gap: 14px;
      row-gap: 10px;
      padding: 0 0 10px !important;
      min-height: 0 !important;
      align-items: start;
    }

    .resume__title-row {
      grid-area: name;
      display: block !important;
    }

    .resume__title-text {
      display: block;
    }

    .resume__name {
      display: block;
      margin: 0 !important;
      /* Ref PDF name glyph height ≈ 19pt */
      font-size: 19pt !important;
      line-height: 1.02 !important;
      letter-spacing: -0.02em;
      color: #1b1b2f !important;
    }

    .resume__identity--print {
      grid-area: id;
      display: flex !important;
      flex-direction: column;
      gap: 3px;
      padding-top: 1px;
      max-width: 100%;
    }

    .resume__role {
      font-family: var(--font-body) !important;
      font-size: 10pt !important;
      font-weight: 700 !important;
      line-height: 1.2 !important;
      color: #1b1b2f !important;
    }

    .resume__location {
      font-size: 7pt !important;
      line-height: 1.3 !important;
      color: #1b1b2f !important;
      opacity: 0.5;
    }

    .resume__intro {
      grid-area: intro;
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .resume__intro-p {
      margin: 0 !important;
      font-size: 7pt !important;
      line-height: 1.38 !important;
      color: #1b1b2f !important;
    }

    .resume__intro-p + .resume__intro-p {
      margin-top: 7px !important;
    }

    .resume__inline-link {
      color: #1b1b2f !important;
      text-decoration: underline;
    }

    /* —— Sections —— */
    .resume__section {
      padding: 9px 0 !important;
    }

    .resume__section--experience {
      gap: 7px !important;
      border-top: 0.75pt solid #d0d0d8;
      padding-top: 11px !important;
    }

    .resume__section--skills-edu {
      display: flex !important;
      flex-direction: row !important;
      align-items: flex-start !important;
      gap: 32px !important;
      padding: 11px 0 !important;
      border-top: 0.75pt solid #d0d0d8;
    }

    /* Skills ~52% | Education ~48% (ref: Education title ~x=309pt of 521 content) */
    .resume__skills {
      flex: 1.1 1 0 !important;
      width: 0 !important;
      min-width: 0;
      gap: 5px !important;
    }

    .resume__education {
      flex: 1 1 0 !important;
      width: 0 !important;
      min-width: 0;
      gap: 5px !important;
    }

    .resume__divider-area {
      display: none !important;
    }

    .resume__divider {
      background: #d0d0d8 !important;
    }

    /* Section titles 12pt — Inter bold, sentence case (not Blatant display) */
    .resume__section-title,
    :global(.section-title.resume__section-title) {
      margin: 0 0 7px !important;
      font-family: var(--font-body) !important;
      font-size: 12pt !important;
      font-weight: 700 !important;
      line-height: 1.15 !important;
      letter-spacing: 0 !important;
      text-transform: none !important;
      color: #1b1b2f !important;
    }

    /* —— Experience rows —— */
    .resume-timeline {
      gap: 9px !important;
    }

    .resume-timeline--edu {
      gap: 6px !important;
    }

    .resume-row--job {
      flex-direction: row !important;
      gap: 10px !important;
      align-items: flex-start !important;
    }

    .resume-row--edu {
      flex-direction: row !important;
      gap: 8px !important;
      align-items: flex-start !important;
    }

    .resume-row__duration {
      color: #1b1b2f !important;
      opacity: 0.45;
    }

    /* Date col ~70pt, right-aligned like ref */
    .resume-row__duration--job {
      width: 70px !important;
      flex-direction: column !important;
      align-items: flex-end !important;
      text-align: right !important;
      flex: none !important;
    }

    .resume-row__duration--edu {
      width: 62px !important;
      flex-direction: column !important;
      align-items: flex-start !important;
      text-align: left !important;
      flex: none !important;
    }

    .resume-row__period-line {
      font-size: 7pt !important;
      line-height: 1.3 !important;
      color: inherit !important;
    }

    .resume-row__title {
      font-size: 7pt !important;
      font-weight: 700 !important;
      line-height: 1.3 !important;
      color: #1b1b2f !important;
    }

    .resume-row__body {
      font-size: 7pt !important;
      font-weight: 400 !important;
      line-height: 1.38 !important;
      color: #1b1b2f !important;
    }

    /* —— Skills —— */
    .skill-columns {
      flex-direction: row !important;
      gap: 14px !important;
    }

    .skill-list,
    .skill-list--other {
      flex: 1 1 0 !important;
      width: 0 !important;
      min-width: 0;
      font-size: 7pt !important;
      line-height: 1.5 !important;
      color: #1b1b2f !important;
    }

    .skill-list--other > .skill-list {
      width: 100% !important;
      flex: none !important;
    }

    .skills-other-label {
      font-size: 7pt !important;
      font-weight: 700 !important;
      line-height: 1.5 !important;
      color: #1b1b2f !important;
    }

    /* —— Contact footer (Reach Me Out) —— */
    .resume__section--contact {
      padding: 10px 0 0 !important;
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .resume__divider--contact {
      width: 100%;
      height: 0.75pt;
      margin: 0 0 9px;
      background: #d0d0d8 !important;
    }

    .resume-contact {
      display: flex;
      flex-direction: row;
      flex-wrap: nowrap;
      gap: 10px 20px;
