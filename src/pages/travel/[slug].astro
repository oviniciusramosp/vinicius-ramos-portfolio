---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TravelPlaceCard from '../../components/travel/TravelPlaceCard.astro';
import TravelItineraryDayCard from '../../components/travel/TravelItineraryDayCard.astro';
import Tag from '../../components/Tag.astro';
import {
  getTravelCity,
  travelCities,
  travelUi,
  formatCityMeta,
  searchPlacesPlaceholder,
  cityCategoryKeys,
  googleMapsUrl,
  placeCategoryMeta,
  withResolvedArea,
  itineraryForCity,
  computeTripBudget,
  type PlaceCategory,
  type TravelPlace,
} from '../../data/travel';
import { categoryIconHtml } from '../../data/travel-categories';
import { site } from '../../data/site';

export function getStaticPaths() {
  return travelCities.map((city) => ({
    params: { slug: city.slug },
  }));
}

const { slug } = Astro.params;
const city = getTravelCity(slug!);

if (!city) {
  return Astro.redirect('/travel');
}

const pageTitle = `${city.name.en} · Travel · ${site.name}`;
const pageDescription = formatCityMeta(city, 'en');

/** Places with OSM-accurate polygons when available */
const places: TravelPlace[] = city.places.map(withResolvedArea);

const pins = places.map((place) => ({
  id: place.id,
  lat: place.lat,
  lng: place.lng,
  label: place.name.en,
  labelPt: place.name['pt-BR'],
  category: place.category,
  subcategories: place.subcategories ?? null,
  featured: place.featured === true,
  landmark: place.landmark ?? null,
  mapsUrl: googleMapsUrl(place, city),
  area: place.area ?? null,
  routeStops: place.routeStops
    ? place.routeStops.map((s) => ({
        name: s.name.en,
        namePt: s.name['pt-BR'],
        lat: s.lat,
        lng: s.lng,
      }))
    : null,
}));

/** Escape `<` so `</script>` inside string values cannot break the JSON script tag */
const pinsJson = JSON.stringify(pins).replace(/</g, '\\u003c');
const searchPlaceholder = searchPlacesPlaceholder(places.length);
const countryCrumbEn = `${city.country.en}/`;
const countryCrumbPt = `${city.country['pt-BR']}/`;
const categories = cityCategoryKeys(city);

const placesByCategory = categories.map((key) => ({
  key,
  places: places.filter((p: TravelPlace) => p.category === key),
  labelEn: travelUi.categories[key as PlaceCategory].en,
  labelPt: travelUi.categories[key as PlaceCategory]['pt-BR'],
}));

const itinerary = itineraryForCity(city.slug);
const placesById = new Map(places.map((p) => [p.id, p]));
const tripBudget = itinerary
  ? computeTripBudget(itinerary, placesById)
  : null;

function formatTripEur(n: number): string {
  const rounded = Math.round(n * 100) / 100;
  if (Number.isInteger(rounded)) return `€${rounded}`;
  return `€${rounded.toFixed(2).replace('.', ',')}`;
}
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  robots="noindex, nofollow"
  showFooter={false}
>
  {/*
    Desktop: left sidebar (places/itinerary) + full-height map.
    Mobile: map on top, list below (flex order).
  */}
  <section class="travel-city">
    <div
      class="travel-city__body"
      data-travel-places
      id="travel-city-sidebar"
    >
      <header class="travel__intro">
        <div class="travel-city__hero">
          <p class="travel-city__breadcrumb">
            <a
              class="travel-city__back"
              href="/travel"
              data-cursor="block"
              data-magnetic
              data-magnetic-range="3"
              data-i18n-en={travelUi.back.en}
              data-i18n-pt={travelUi.back['pt-BR']}
            >
              {travelUi.back.en}
            </a>
            <span
              class="travel-city__country"
              data-i18n-en={countryCrumbEn}
              data-i18n-pt={countryCrumbPt}
            >
              {countryCrumbEn}
            </span>
          </p>

          <h1
            class="travel__title display-title"
            data-i18n-en={city.name.en}
            data-i18n-pt={city.name['pt-BR']}
          >
            {city.name.en}
          </h1>
        </div>

        <div class="travel__search-row">
          <div class="travel__search">
            <label
              class="visually-hidden"
              for="travel-search-input"
              data-i18n-en="Search places"
              data-i18n-pt="Buscar lugares"
            >
              Search places
            </label>
            <ion-icon
              class="travel__search-icon"
              name="search-outline"
              aria-hidden="true"
            ></ion-icon>
            <input
              id="travel-search-input"
              type="search"
              class="travel__search-input"
              data-travel-search
              data-i18n-en={searchPlaceholder.en}
              data-i18n-pt={searchPlaceholder['pt-BR']}
              data-i18n-as="placeholder"
              placeholder={searchPlaceholder.en}
              autocomplete="off"
            />

            {/* Category filter: icon inside search field (right) */}
            <div
              class="travel__filter-wrap"
              data-travel-filter-mode="categories"
            >
              <button
                type="button"
                class="travel__filter-btn"
                data-travel-filter-toggle
                aria-haspopup="dialog"
                aria-expanded="false"
                aria-controls="travel-filter-popover"
                data-magnetic
                data-magnetic-range="3"
                data-cursor="block"
                data-i18n-en={travelUi.filterCategories.en}
                data-i18n-pt={travelUi.filterCategories['pt-BR']}
                data-i18n-as="aria-label"
                aria-label={travelUi.filterCategories.en}
                title={travelUi.filterCategories.en}
              >
                <span class="material-symbols-rounded" aria-hidden="true">
                  filter_list
                </span>
                <span
                  class="travel__filter-btn-badge"
                  data-travel-filter-count
                  hidden
                ></span>
              </button>

              <div
                class="travel__filter-popover"
                id="travel-filter-popover"
                data-travel-filter-popover
                role="dialog"
                aria-label={travelUi.filterCategories.en}
                data-i18n-en={travelUi.filterCategories.en}
                data-i18n-pt={travelUi.filterCategories['pt-BR']}
                data-i18n-as="aria-label"
                hidden
              >
                <ul class="travel__filter-list" role="group">
                  {
                    categories.map((key) => {
                      const onByDefault =
                        key !== 'commons' && key !== 'markets';
                      return (
                        <li class="travel__filter-item">
                          <label
                            class="travel__filter-option"
                            data-category={key}
                            style={`--cat-color: ${placeCategoryMeta[key].color}`}
                          >
                            <input
                              type="checkbox"
                              class="travel__filter-check"
                              data-travel-filter={key}
                              checked={onByDefault}
                            />
                            <span
                              class="travel__filter-option-icon"
                              aria-hidden="true"
                              set:html={categoryIconHtml(key)}
                            />
                            <span
                              class="travel__filter-option-label"
                              data-i18n-en={travelUi.categories[key].en}
                              data-i18n-pt={
                                travelUi.categories[key]['pt-BR']
                              }
                            >
                              {travelUi.categories[key].en}
                            </span>
                          </label>
                        </li>
                      );
                    })
                  }
                </ul>
              </div>
            </div>
          </div>

          <div
            class="travel__view-toggle"
            role="group"
            data-travel-view-toggle
            data-i18n-en={travelUi.viewModeGroup.en}
            data-i18n-pt={travelUi.viewModeGroup['pt-BR']}
            data-i18n-as="aria-label"
            aria-label={travelUi.viewModeGroup.en}
          >
            <button
              type="button"
              class="travel__view-btn is-active"
              data-travel-view="list"
              aria-pressed="true"
              data-magnetic
              data-magnetic-range="3"
              data-cursor="block"
              data-i18n-en={travelUi.viewList.en}
              data-i18n-pt={travelUi.viewList['pt-BR']}
              data-i18n-as="aria-label"
              aria-label={travelUi.viewList.en}
              title={travelUi.viewList.en}
            >
              <span class="material-symbols-rounded" aria-hidden="true">
                view_list
              </span>
            </button>
            <button
              type="button"
              class="travel__view-btn"
              data-travel-view="itinerary"
              aria-pressed="false"
              data-magnetic
              data-magnetic-range="3"
              data-cursor="block"
              data-i18n-en={travelUi.viewItinerary.en}
              data-i18n-pt={travelUi.viewItinerary['pt-BR']}
              data-i18n-as="aria-label"
              aria-label={travelUi.viewItinerary.en}
              title={travelUi.viewItinerary.en}
            >
              <span class="material-symbols-rounded" aria-hidden="true">
                route
              </span>
            </button>
          </div>
        </div>
      </header>

      <div class="travel-city__views" data-places-view="list">
        {/* List: grouped by category — expand label above groups */}
        <div class="travel-city__groups" data-view-panel="list">
          <div class="travel-city__list-actions">
            <button
              type="button"
              class="travel__expand-label"
              data-travel-expand-toggle
              data-expanded="false"
              aria-expanded="false"
              data-cursor="block"
              data-collapse-en={travelUi.collapseAll.en}
              data-collapse-pt={travelUi.collapseAll['pt-BR']}
              data-expand-en={travelUi.expandAll.en}
              data-expand-pt={travelUi.expandAll['pt-BR']}
              data-i18n-en={travelUi.expandAll.en}
              data-i18n-pt={travelUi.expandAll['pt-BR']}
            >
              {travelUi.expandAll.en}
            </button>
          </div>
          {
            placesByCategory.map((group) => (
              <details
                class="travel-group"
                data-travel-group
                data-category={group.key}
                style={`--cat-color: ${placeCategoryMeta[group.key as PlaceCategory].color}`}
              >
                <summary class="travel-group__summary">
                  <span
                    class="travel-group__tag"
                    data-i18n-en={group.labelEn}
                    data-i18n-pt={group.labelPt}
                    data-i18n-as="tag-label"
                  >
                    <Tag
                      label={group.labelEn}
                      variant="chip"
                      iconHtml={categoryIconHtml(group.key)}
                    />
                  </span>
                  <span class="travel-group__count" data-group-count>
                    {group.places.length}
                  </span>
                  <ion-icon
                    class="travel-group__chevron"
                    name="chevron-down-outline"
                    aria-hidden="true"
                  ></ion-icon>
                </summary>
                <div class="travel-city__list">
                  {group.places.map((place) => (
                    <TravelPlaceCard place={place} city={city} variant="list" />
                  ))}
                </div>
              </details>
            ))
          }
        </div>

        {/* Itinerary: day-by-day curated routes */}
        <div
          class="travel-city__itinerary"
          data-view-panel="itinerary"
          data-travel-itinerary
          data-on-map-en={travelUi.itineraryOnMap.en}
          data-on-map-pt={travelUi.itineraryOnMap['pt-BR']}
          data-slot-off-map-en={travelUi.itinerarySlotOffMap.en}
          data-slot-off-map-pt={travelUi.itinerarySlotOffMap['pt-BR']}
          hidden
        >
          {
            itinerary ? (
              <>
                <header class="travel-city__itinerary-head">
                  <h2
                    class="travel-city__itinerary-title"
                    data-i18n-en={itinerary.title.en}
                    data-i18n-pt={itinerary.title['pt-BR']}
                  >
                    {itinerary.title.en}
                  </h2>
                  {
                    tripBudget && (
                      <div
                        class="travel-day-card__budgets travel-city__itinerary-budgets"
                        role="group"
                        data-i18n-en={travelUi.itineraryTripBudgetGroup.en}
                        data-i18n-pt={travelUi.itineraryTripBudgetGroup['pt-BR']}
                        data-i18n-as="aria-label"
                        aria-label={travelUi.itineraryTripBudgetGroup.en}
                      >
                        <div
                          class="travel-day-card__budget-card travel-day-card__budget-card--food"
                          title={travelUi.itineraryFood.en}
                          data-i18n-en={travelUi.itineraryFood.en}
                          data-i18n-pt={travelUi.itineraryFood['pt-BR']}
                          data-i18n-as="title"
                        >
                          <span
                            class="material-symbols-rounded"
                            aria-hidden="true"
                          >
                            restaurant
                          </span>
                          <span class="travel-day-card__budget-card-value">
                            <strong>{formatTripEur(tripBudget.foodEur)}</strong>
                            <span
                              class="travel-day-card__budget-card-unit"
                              data-i18n-en={travelUi.itineraryPerPerson.en}
                              data-i18n-pt={travelUi.itineraryPerPerson['pt-BR']}
                            >
                              {travelUi.itineraryPerPerson.en}
                            </span>
                          </span>
                        </div>
                        <div
                          class="travel-day-card__budget-card travel-day-card__budget-card--ticket"
                          title={travelUi.itineraryParks.en}
                          data-i18n-en={travelUi.itineraryParks.en}
                          data-i18n-pt={travelUi.itineraryParks['pt-BR']}
                          data-i18n-as="title"
                        >
                          <span
                            class="material-symbols-rounded"
                            aria-hidden="true"
                          >
                            confirmation_number
                          </span>
                          <span class="travel-day-card__budget-card-value">
                            <strong>
                              {formatTripEur(tripBudget.ticketsEur)}
                            </strong>
                            <span
                              class="travel-day-card__budget-card-unit"
                              data-i18n-en={travelUi.itineraryPerPerson.en}
                              data-i18n-pt={travelUi.itineraryPerPerson['pt-BR']}
                            >
                              {travelUi.itineraryPerPerson.en}
                            </span>
                          </span>
                        </div>
                      </div>
                    )
                  }
                </header>
                <div class="travel-city__itinerary-days">
                  {itinerary.days.map((day) => (
                    <TravelItineraryDayCard
                      day={day}
                      city={city}
                      placesById={placesById}
                    />
                  ))}
                </div>
              </>
            ) : (
              <p
                class="travel-city__itinerary-empty"
                data-i18n-en={travelUi.itineraryEmpty.en}
                data-i18n-pt={travelUi.itineraryEmpty['pt-BR']}
              >
                {travelUi.itineraryEmpty.en}
              </p>
            )
          }
        </div>
      </div>

      <p
        class="travel__empty"
        data-travel-empty
        hidden
        data-i18n-en={travelUi.emptyPlaces.en}
        data-i18n-pt={travelUi.emptyPlaces['pt-BR']}
      >
        {travelUi.emptyPlaces.en}
      </p>
    </div>

    {/*
      Shell wraps map + place panel. Panel is a sibling of the map hero so
      overflow:hidden on the map does not clip the mobile form-sheet (fixed).
    */}
    <div class="travel__map-shell">
      <div class="travel__map-hero">
        <div
          class="travel-map"
          data-travel-map
          data-mode="places"
          data-center-lat={String(city.lat)}
          data-center-lng={String(city.lng)}
          data-zoom={String(city.zoom)}
          data-i18n-en={travelUi.cityMapAria.en}
          data-i18n-pt={travelUi.cityMapAria['pt-BR']}
          data-i18n-as="aria-label"
          data-fullscreen-enter={travelUi.fullscreenEnter.en}
          data-fullscreen-exit={travelUi.fullscreenExit.en}
          data-add-en={travelUi.addToRoute.en}
          data-add-pt={travelUi.addToRoute['pt-BR']}
          data-remove-en={travelUi.removeFromRoute.en}
          data-remove-pt={travelUi.removeFromRoute['pt-BR']}
          data-title-en={travelUi.routeTitle.en}
          data-title-pt={travelUi.routeTitle['pt-BR']}
          data-walk-en={travelUi.routeWalk.en}
          data-walk-pt={travelUi.routeWalk['pt-BR']}
          data-transit-en={travelUi.routeTransit.en}
          data-transit-pt={travelUi.routeTransit['pt-BR']}
          data-open-en={travelUi.routeOpenGoogle.en}
          data-open-pt={travelUi.routeOpenGoogle['pt-BR']}
          data-need-en={travelUi.routeNeedStops.en}
          data-need-pt={travelUi.routeNeedStops['pt-BR']}
          data-loading-en={travelUi.routeLoading.en}
          data-loading-pt={travelUi.routeLoading['pt-BR']}
          data-error-en={travelUi.routeError.en}
          data-error-pt={travelUi.routeError['pt-BR']}
          data-transit-hint-en={travelUi.routeTransitHint.en}
          data-transit-hint-pt={travelUi.routeTransitHint['pt-BR']}
          data-clear-en={travelUi.routeClear.en}
          data-clear-pt={travelUi.routeClear['pt-BR']}
          data-preview-en={travelUi.routePreviewLabel.en}
          data-preview-pt={travelUi.routePreviewLabel['pt-BR']}
          data-my-loc-en={travelUi.myLocation.en}
          data-my-loc-pt={travelUi.myLocation['pt-BR']}
          data-start-from-en={travelUi.startFromMyLocation.en}
          data-start-from-pt={travelUi.startFromMyLocation['pt-BR']}
          data-locating-en={travelUi.locating.en}
          data-locating-pt={travelUi.locating['pt-BR']}
          data-locate-denied-en={travelUi.locateDenied.en}
          data-locate-denied-pt={travelUi.locateDenied['pt-BR']}
          data-locate-unavailable-en={travelUi.locateUnavailable.en}
          data-locate-unavailable-pt={travelUi.locateUnavailable['pt-BR']}
          data-locate-far-en={travelUi.locateFar.en}
          data-locate-far-pt={travelUi.locateFar['pt-BR']}
          data-locate-label={travelUi.locateMe.en}
          aria-label={travelUi.cityMapAria.en}
        >
        </div>
        {/* Pins JSON outside attributes — large city payloads break / race SPA remounts when stuffed into data-pins */}
        <script
          type="application/json"
          data-travel-map-pins
          set:html={pinsJson}
        />
      </div>

      {/* Scrim: mobile form-sheet only (tap outside to close) */}
      <div
        class="travel-map-panel-scrim"
        data-travel-map-panel-scrim
        hidden
        aria-hidden="true"
      ></div>

      <aside
        class="travel-map-panel"
        data-travel-map-panel
        data-close-label={travelUi.closePanel.en}
        hidden
        aria-hidden="true"
        role="dialog"
        aria-modal="true"
      >
        {/*
          Sticky chrome: close stays fixed while body scrolls (desktop + mobile).
          Grab is mobile form-sheet only.
        */}
        <div class="travel-map-panel__chrome" data-travel-map-panel-chrome>
          <div
            class="travel-map-panel__grab"
            data-sheet-grab
            aria-hidden="true"
          >
            <span class="travel-map-panel__grab-pill"></span>
          </div>
          <button
            type="button"
            class="travel-map-panel__close"
            data-panel-close
            aria-label={travelUi.closePanel.en}
            data-i18n-en={travelUi.closePanel.en}
            data-i18n-pt={travelUi.closePanel['pt-BR']}
            data-i18n-as="aria-label"
            title={travelUi.closePanel.en}
          >
            <ion-icon name="close-outline" aria-hidden="true"></ion-icon>
          </button>
        </div>
        <div class="travel-map-panel__body" data-travel-map-panel-body></div>
      </aside>
    </div>

    {/*
      Desktop: collapse / expand left sidebar.
      Sibling of body + map so it can sit above the floating panel (z-index).
    */}
    <button
      type="button"
      class="travel-city__sidebar-toggle"
      data-travel-sidebar-toggle
      aria-expanded="true"
      aria-controls="travel-city-sidebar"
      data-magnetic
      data-magnetic-range="4"
      data-cursor="block"
      data-collapse-en={travelUi.collapseSidebar.en}
      data-collapse-pt={travelUi.collapseSidebar['pt-BR']}
      data-expand-en={travelUi.expandSidebar.en}
      data-expand-pt={travelUi.expandSidebar['pt-BR']}
      data-i18n-en={travelUi.collapseSidebar.en}
      data-i18n-pt={travelUi.collapseSidebar['pt-BR']}
      data-i18n-as="aria-label"
      aria-label={travelUi.collapseSidebar.en}
      title={travelUi.collapseSidebar.en}
    >
      <ion-icon
        class="travel-city__sidebar-toggle-icon"
        name="chevron-back-outline"
        aria-hidden="true"
        data-travel-sidebar-toggle-icon
      ></ion-icon>
    </button>
  </section>

  {/*
    Full place cards for map-panel cloning. Feed cards can be [hidden] /
    filtered-out; cloning those inherits display:none and the panel looks empty.
    Templates stay off-screen and never get filtered.
  */}
  <div
    class="travel-card-templates"
    data-travel-card-templates
    hidden
    aria-hidden="true"
  >
    {
      places.map((place) => (
        <TravelPlaceCard place={place} city={city} />
      ))
    }
  </div>
</BaseLayout>

<script>
  import { bootTravelI18n } from '../../scripts/travel-i18n';
  import { bootTravelMap, getTravelMapHandle } from '../../scripts/travel-map';
  import { bootTravelFilter } from '../../scripts/travel-filter';
  import { bootTravelPanel } from '../../scripts/travel-panel';
  import { bootTravelLive } from '../../scripts/travel-live';
  import { bootTravelPhotoSliders } from '../../scripts/travel-photo-slider';
  import { bootTravelRoute } from '../../scripts/travel-route-ui';
  import { bootTravelItinerary } from '../../scripts/travel-itinerary';
  import { bootTravelTheme } from '../../scripts/travel-theme';
  import '../../styles/travel-map.css';
  import '../../styles/travel-itinerary.css';

  const SIDEBAR_MQ = '(min-width: 901px)';
  const SIDEBAR_KEY = 'travel-city-sidebar-collapsed';

  /** Collapse / expand left list so the map can grow (desktop only). */
  const bootTravelSidebar = () => {
    const city = document.querySelector<HTMLElement>('.travel-city');
    const toggle = document.querySelector<HTMLButtonElement>(
      '[data-travel-sidebar-toggle]',
    );
    if (!city || !toggle) return;
    if (toggle.dataset.bound === '1') return;
    toggle.dataset.bound = '1';

    const icon = toggle.querySelector<HTMLElement>(
      '[data-travel-sidebar-toggle-icon]',
    );

    const isDesktop = () =>
      typeof window !== 'undefined' && window.matchMedia(SIDEBAR_MQ).matches;

    const labels = () => {
      const lang =
        document.documentElement.lang?.toLowerCase().startsWith('pt')
          ? 'pt'
          : 'en';
      const collapse =
        (lang === 'pt' ? toggle.dataset.collapsePt : toggle.dataset.collapseEn) ||
        'Collapse sidebar';
      const expand =
        (lang === 'pt' ? toggle.dataset.expandPt : toggle.dataset.expandEn) ||
        'Expand sidebar';
      return { collapse, expand };
    };

    const apply = (collapsed: boolean, persist = true) => {
      city.classList.toggle('is-sidebar-collapsed', collapsed);
      toggle.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
      const { collapse, expand } = labels();
      const label = collapsed ? expand : collapse;
      toggle.setAttribute('aria-label', label);
      toggle.title = label;
      toggle.setAttribute('data-i18n-en', collapsed
        ? (toggle.dataset.expandEn || 'Expand sidebar')
        : (toggle.dataset.collapseEn || 'Collapse sidebar'));
      toggle.setAttribute('data-i18n-pt', collapsed
        ? (toggle.dataset.expandPt || 'Expandir painel')
        : (toggle.dataset.collapsePt || 'Recolher painel'));
      if (icon) {
        // Icon rotates via CSS; keep name stable for a11y tree simplicity
        icon.setAttribute('name', 'chevron-back-outline');
      }
      if (persist && isDesktop()) {
        try {
          sessionStorage.setItem(SIDEBAR_KEY, collapsed ? '1' : '0');
        } catch {
          /* ignore */
        }
      }
      // Sidebar overlays the map — re-center free region after open/close
      requestAnimationFrame(() => {
        getTravelMapHandle()?.syncUiChrome({
          refit: true,
          animate: persist && isDesktop(),
        });
      });
    };

    // Restore last preference on desktop
    let startCollapsed = false;
    if (isDesktop()) {
      try {
        startCollapsed = sessionStorage.getItem(SIDEBAR_KEY) === '1';
      } catch {
        startCollapsed = false;
      }
    }
    apply(startCollapsed, false);

    toggle.addEventListener('click', (e) => {
      e.preventDefault();
      if (!isDesktop()) return;
      apply(!city.classList.contains('is-sidebar-collapsed'));
    });

    // Leaving desktop: force expanded layout so mobile stack is intact
    const mq = window.matchMedia(SIDEBAR_MQ);
    const onMq = () => {
      if (!mq.matches) {
        city.classList.remove('is-sidebar-collapsed');
        toggle.setAttribute('aria-expanded', 'true');
      } else {
        try {
          apply(sessionStorage.getItem(SIDEBAR_KEY) === '1', false);
        } catch {
          apply(false, false);
        }
      }
    };
    mq.addEventListener?.('change', onMq);
  };

  const boot = () => {
    bootTravelTheme();
    bootTravelI18n();
    bootTravelMap();
    bootTravelFilter();
    bootTravelPanel();
    bootTravelRoute();
    bootTravelItinerary();
    bootTravelLive();
    bootTravelPhotoSliders();
    bootTravelSidebar();
    // Desktop sidebar layout: map container size may settle after paint
    requestAnimationFrame(() => {
      window.dispatchEvent(new Event('resize'));
    });
  };

  boot();
  document.addEventListener('astro:page-load', boot);
</script>

