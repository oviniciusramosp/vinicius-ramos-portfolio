---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import EmbedModal from '../../components/EmbedModal.astro';
import NextProject from '../../components/NextProject.astro';
import OptimizedImg from '../../components/OptimizedImg.astro';
import {
  articles,
  getArticleById,
  getNextArticle,
  articleHref,
  isArticleHighlight,
  youtubeEmbedSrc,
  type ArticleParagraph,
} from '../../data/articles';
import { site } from '../../data/site';
import { optimizedUrl } from '../../utils/optimized-url';

export function getStaticPaths() {
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

interface Props {
  article: NonNullable<ReturnType<typeof getArticleById>>;
}

const { article } = Astro.props;
const next = getNextArticle(article.id);
const noteEmbed = article.note?.youtubeUrl
  ? youtubeEmbedSrc(article.note.youtubeUrl)
  : undefined;
const ogImage =
  (await optimizedUrl(article.image, { width: 1200, quality: 80, format: 'jpg' })) ??
  article.image;

/** CTAs that open embed modals (deduped by href) */
const embedModals = (article.links ?? [])
  .filter((l) => l.modal && l.href)
  .reduce<{ id: string; src: string }[]>((acc, link) => {
    if (acc.some((m) => m.src === link.href)) return acc;
    acc.push({
      id: `article-embed-${acc.length + 1}`,
      src: link.href,
    });
    return acc;
  }, []);

function embedModalIdForHref(href: string) {
  return embedModals.find((m) => m.src === href)?.id;
}

function paragraphParts(paragraph: ArticleParagraph) {
  return typeof paragraph === 'string' ? [paragraph] : paragraph;
}

const showVideoControls = Boolean(article.video?.controls);
const videoInsertAfter = article.video?.insertAfter;
const videoMidBody =
  article.video != null &&
  videoInsertAfter != null &&
  videoInsertAfter >= 0 &&
  videoInsertAfter < article.content.length - 1;
const bodyBeforeVideo = videoMidBody
  ? article.content.slice(0, videoInsertAfter! + 1)
  : article.content;
const bodyAfterVideo = videoMidBody
  ? article.content.slice(videoInsertAfter! + 1)
  : [];
---

<BaseLayout
  title={`${site.name} · ${article.title}`}
  description={article.description}
  image={ogImage}
  imageAlt={article.imageAlt ?? article.title}
>
  <article class="article-page">
    <header class="article-page__header">
      <h1 class="article-page__title display-title">{article.title}</h1>
      <p class="article-page__date">{article.date}</p>
    </header>

    {
      article.image && (
        <figure class="article-page__figure">
          <OptimizedImg
            class={[
              'article-page__image',
              article.imageFit === 'contain' && 'article-page__image--contain',
            ]
              .filter(Boolean)
              .join(' ')}
            src={article.image}
            alt={article.imageAlt ?? article.title}
            preset="full"
            loading="eager"
            decoding="async"
            objectFit={article.imageFit === 'contain' ? 'contain' : 'cover'}
            objectPosition={article.imageObjectPosition}
            style={
              article.imageScale != null && article.imageScale !== 1
                ? `transform: scale(${article.imageScale}); transform-origin: center`
                : undefined
            }
          />
        </figure>
      )
    }

    <div class="article-page__body">
      {
        bodyBeforeVideo.map((paragraph) => (
          <p class="article-page__p body-text">
            {paragraphParts(paragraph).map((part) =>
              isArticleHighlight(part) ? (
                <a
                  class="article-highlight"
                  href={part.href}
                  data-tooltip={part.tooltip}
                  data-transition-label={part.tooltip.replace(/^View Project:\s*/i, '')}
                  data-cursor="block"
                >
                  {part.text}
                </a>
              ) : (
                part
              ),
            )}
          </p>
        ))
      }
    </div>

    {
      article.video && (
        <div
          class:list={[
            'article-page__media',
            videoMidBody && 'article-page__media--inline',
          ]}
        >
          <div
            class:list={[
              'article-video-block',
              showVideoControls && 'article-video-block--controls',
            ]}
            data-article-video-block={showVideoControls ? '' : undefined}
            style={[
              article.video.maxWidth &&
                `--article-video-max: ${article.video.maxWidth}`,
              article.video.radiusRatio != null &&
                `--article-video-radius-ratio: ${article.video.radiusRatio}`,
              article.video.cropScale != null &&
                `--article-video-crop: ${article.video.cropScale}`,
            ]
              .filter(Boolean)
              .join('; ') || undefined}
          >
            <div
              class="article-video"
              style={
                article.video.aspect
                  ? `aspect-ratio: ${article.video.aspect}`
                  : undefined
              }
            >
              <video
                src={article.video.src}
                aria-label={article.video.alt ?? 'Article demo video'}
                autoplay
                muted
                loop
                playsinline
                preload="auto"
                data-article-video={showVideoControls ? '' : undefined}
                style={`object-fit: ${article.video.fit ?? 'cover'}`}
              />
            </div>
            {showVideoControls && (
              <div class="article-video-block__bar">
                <button
                  type="button"
                  class="article-video-block__toggle"
                  data-article-video-toggle
                  aria-label="Pause video"
                  aria-pressed="false"
                >
                  <ion-icon name="pause" data-article-video-icon aria-hidden="true" />
                </button>
              </div>
            )}
          </div>
        </div>
      )
    }

    {
      bodyAfterVideo.length > 0 && (
        <div class="article-page__body article-page__body--continued">
          {bodyAfterVideo.map((paragraph) => (
            <p class="article-page__p body-text">
              {paragraphParts(paragraph).map((part) =>
                isArticleHighlight(part) ? (
                  <a
                    class="article-highlight"
                    href={part.href}
                    data-tooltip={part.tooltip}
                    data-transition-label={part.tooltip.replace(/^View Project:\s*/i, '')}
                    data-cursor="block"
                  >
                    {part.text}
                  </a>
                ) : (
                  part
                ),
              )}
            </p>
          ))}
        </div>
      )
    }

    {
      article.links && article.links.length > 0 && (
        <div class="article-page__links">
          {article.linksIntro && (
            <p class="article-page__links-intro body-text">{article.linksIntro}</p>
          )}
          <div class="article-page__links-row">
            {article.links.map((link) => {
              const embedId =
                link.modal && link.href ? embedModalIdForHref(link.href) : undefined;
              return embedId ? (
                <Button
                  label={link.label}
                  variant="ghost"
                  embedOpen={embedId}
                  class="article-page__link-btn"
                />
              ) : (
                <Button
                  label={link.label}
                  href={link.href}
                  variant="ghost"
                  external
                  class="article-page__link-btn"
                />
              );
            })}
          </div>
        </div>
      )
    }

    {
      article.note && (
        <aside class="article-note" aria-label={article.note.label ?? 'Addition'}>
          <p class="article-note__label">{article.note.label ?? 'Addition'}</p>
          {article.note.paragraphs.map((p) => (
            <p class="article-note__p body-text">{p}</p>
          ))}
          {noteEmbed && (
            <div class="article-note__video">
              <iframe
                class="article-note__iframe"
                src={noteEmbed}
                title="Related video"
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
              />
            </div>
          )}
        </aside>
      )
    }
  </article>

  {
    next && (
      <NextProject
        label="NEXT"
        title={next.title}
        href={articleHref(next.id)}
      />
    )
  }

  {embedModals.map((modal) => <EmbedModal id={modal.id} src={modal.src} />)}
</BaseLayout>

<script>
  /**
   * Muted autoplay + optional pause control (same behavior as case study videos).
   * ClientRouter can leave new <video> nodes paused after SPA navigations.
   */
  function kickArticleVideos() {
    document
      .querySelectorAll<HTMLVideoElement>('.article-video video')
      .forEach((video) => {
        video.muted = true;
        video.defaultMuted = true;
        video.playsInline = true;
        video.setAttribute('playsinline', '');
        video.setAttribute('webkit-playsinline', '');

        const tryPlay = () => {
          if (video.paused) {
            void video.play().catch(() => undefined);
          }
        };

        if (video.readyState === 0 && video.src) {
          video.load();
        }

        if (video.readyState >= 2) {
          tryPlay();
        } else {
          video.addEventListener('canplay', tryPlay, { once: true });
          tryPlay();
        }
      });
  }

  function bindArticleVideoBlocks() {
    document
      .querySelectorAll<HTMLElement>('[data-article-video-block]')
      .forEach((block) => {
        const video = block.querySelector<HTMLVideoElement>('[data-article-video]');
        const btn = block.querySelector<HTMLButtonElement>('[data-article-video-toggle]');
        const icon = block.querySelector<HTMLElement>('[data-article-video-icon]');
        if (!video || !btn || !icon) return;
        if ((btn as HTMLButtonElement & { __bound?: boolean }).__bound) return;
        (btn as HTMLButtonElement & { __bound?: boolean }).__bound = true;

        const sync = () => {
          const paused = video.paused;
          icon.setAttribute('name', paused ? 'play' : 'pause');
          btn.setAttribute('aria-label', paused ? 'Play video' : 'Pause video');
          btn.setAttribute('aria-pressed', paused ? 'true' : 'false');
        };

        btn.addEventListener('click', () => {
          if (video.paused) {
            void video.play().catch(() => undefined);
          } else {
            video.pause();
          }
          requestAnimationFrame(sync);
        });

        video.addEventListener('play', sync);
        video.addEventListener('pause', sync);
        sync();
      });
  }

  function initArticleVideos() {
    kickArticleVideos();
    bindArticleVideoBlocks();
  }

  initArticleVideos();
  document.addEventListener('astro:page-load', initArticleVideos);
</script>

<style>
  .article-page {
    width: 100%;
    max-width: min(720px, var(--shell-max));
    margin-inline: auto;
    padding: var(--space-12) var(--page-pad-x) var(--space-10);
  }

  .article-page__header {
    display: grid;
    gap: var(--space-5);
    margin-bottom: var(--space-9);
  }

  .article-page__title {
    margin: 0;
    max-width: 18ch;
  }

  .article-page__date {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    line-height: 1.35;
    color: var(--color-accent);
  }

  .article-page__figure {
    margin: 0 0 var(--space-9);
    border-radius: 16px;
    overflow: hidden;
    background: var(--color-surface, #131219);
  }

  .article-page__image {
    display: block;
    width: 100%;
    height: auto;
    max-height: 360px;
  }

  .article-page__image :global(img) {
    display: block;
    width: 100%;
    height: auto;
    max-height: 360px;
    max-width: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Fit full art inside the slot (no crop) */
  .article-page__image--contain {
    height: 360px;
    max-height: 360px;
  }

  .article-page__image--contain :global(img) {
    height: 360px;
    max-height: 360px;
    object-fit: contain;
  }

  @media (max-width: 768px) {
    .article-page__image--contain {
      height: 240px;
      max-height: 240px;
    }

    .article-page__image--contain :global(img) {
      height: 240px;
      max-height: 240px;
    }
  }

  .article-page__body {
    display: flex;
    flex-direction: column;
    gap: 1.15em;
  }

  .article-page__p {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.75;
    color: var(--color-text-soft, rgba(255, 255, 255, 0.75));
  }

  /* Continued body after mid-post media */
  .article-page__body--continued {
    margin-top: var(--space-9);
  }

  /* Muted loop — width + radius scale with the rendered frame */
  .article-page__media {
    margin-top: var(--space-9);
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .article-page__media--inline {
    margin-block: var(--space-9);
  }

  .article-video-block {
    /* Container for cqi-based radius / control sizing */
    container-type: inline-size;
    container-name: article-video;
    /* Prefer data max, but never exceed viewport fraction */
    width: min(var(--article-video-max, 280px), 72vw, 100%);
    display: flex;
    flex-direction: column;
    gap: clamp(8px, 3.5cqi, 12px);
  }

  /* Phone-on-transparent: radius = ratio of frame width (scales per breakpoint) */
  .article-video {
    width: 100%;
    border-radius: calc(var(--article-video-radius-ratio, 0.14) * 100cqi);
    overflow: hidden;
    background: transparent;
    isolation: isolate;
  }

  .article-video video {
    display: block;
    width: 100%;
    height: 100%;
    object-position: center;
    background: transparent;
    /* cropScale is a unitless ratio — same crop fraction at every size */
    transform: scale(var(--article-video-crop, 1));
    transform-origin: center center;
  }

  .article-video-block__bar {
    display: flex;
    justify-content: flex-end;
    padding-inline: 2px;
  }

  .article-video-block__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* Scales with the phone width */
    width: clamp(32px, 14cqi, 40px);
    height: clamp(32px, 14cqi, 40px);
    margin: 0;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: var(--color-surface, #131219);
    color: var(--color-text, #fff);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12);
    cursor: pointer;
    transition:
      background 200ms var(--ease-smooth, cubic-bezier(0.44, 0, 0.56, 1)),
      transform 200ms var(--ease-smooth, cubic-bezier(0.44, 0, 0.56, 1));
  }

  .article-video-block__toggle:hover {
    background: #1c1b24;
  }

  .article-video-block__toggle:focus-visible {
    outline: 2px solid var(--color-accent, #008fff);
    outline-offset: 2px;
  }

  .article-video-block__toggle:active {
    transform: scale(0.96);
  }

  .article-video-block__toggle :global(ion-icon) {
    font-size: clamp(16px, 7cqi, 20px);
    pointer-events: none;
  }

  /* End-of-post CTAs (embed modals / external) — intro + compact labels */
  .article-page__links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
    margin-top: var(--space-9);
  }

  .article-page__links-intro {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.75;
    color: var(--color-text-soft, rgba(255, 255, 255, 0.75));
  }

  .article-page__links-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .article-page__links :global(.article-page__link-btn .btn__visual) {
    min-height: 30px;
    padding: 6px 12px;
  }

  .article-page__links :global(.article-page__link-btn .btn__label) {
    font-size: var(--text-xs, 12px);
  }

  /* Postscript / addition after original post */
  .article-note {
    margin-top: var(--space-10);
    padding-top: var(--space-9);
    border-top: 1px solid var(--color-border);
    display: grid;
    gap: var(--space-6);
    width: 100%;
  }

  .article-note__label {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 400;
    line-height: var(--lh-tight);
    letter-spacing: 0;
    text-transform: uppercase;
    /* Same tone as post body */
    color: var(--color-text-soft, rgba(255, 255, 255, 0.75));
  }

  .article-note__p {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.75;
    color: var(--color-text-soft, rgba(255, 255, 255, 0.75));
  }

  .article-note__video {
    position: relative;
    width: 100%;
    max-width: 100%;
    aspect-ratio: 16 / 9;
    /* Same radius as case bentos */
    border-radius: var(--radius-sm, 8px);
    overflow: hidden;
    background: #0a0a0c;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
  }

  .article-note__iframe {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* Marker highlight → project link */
  .article-highlight {
    position: relative;
    display: inline;
    color: var(--color-text, #fff);
    text-decoration: none;
    /* marker stroke under the words */
    background-image: linear-gradient(
      transparent 0 58%,
      rgba(0, 143, 255, 0.42) 58% 92%,
      transparent 92% 100%
    );
    background-repeat: no-repeat;
    background-size: 100% 100%;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    border-radius: 2px;
    transition:
      background-image 200ms ease,
      color 200ms ease;
  }

  .article-highlight:hover,
  .article-highlight:focus-visible {
    color: #fff;
    background-image: linear-gradient(
      transparent 0 50%,
      rgba(0, 143, 255, 0.72) 50% 96%,
      transparent 96% 100%
    );
    outline: none;
  }

  .article-highlight:focus-visible {
    box-shadow: 0 0 0 2px var(--color-accent);
    border-radius: 3px;
  }

  /* Tooltip above the highlight */
  .article-highlight::after {
    content: attr(data-tooltip);
    position: absolute;
    left: 50%;
    bottom: calc(100% + 10px);
    z-index: 5;
    transform: translateX(-50%) translateY(4px);
    padding: 8px 12px;
    border-radius: 8px;
    background: var(--color-surface-elevated, #17161d);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0;
    color: var(--color-text, #fff);
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 160ms ease,
      transform 160ms ease,
      visibility 160ms ease;
  }

  .article-highlight::before {
    content: '';
    position: absolute;
    left: 50%;
    bottom: calc(100% + 4px);
    z-index: 5;
    width: 8px;
    height: 8px;
    margin-left: -4px;
    background: var(--color-surface-elevated, #17161d);
    border-right: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    transform: translateY(4px) rotate(45deg);
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 160ms ease,
      transform 160ms ease,
      visibility 160ms ease;
  }

  .article-highlight:hover::after,
  .article-highlight:focus-visible::after {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  .article-highlight:hover::before,
  .article-highlight:focus-visible::before {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) rotate(45deg);
  }

  @media (max-width: 768px) {
    .article-page {
      padding: 48px 16px 40px;
    }

    .article-page__image,
    .article-page__image :global(img) {
      max-height: 240px;
    }

    .article-highlight::after {
      white-space: normal;
      max-width: min(240px, 70vw);
      text-align: center;
    }
  }

  @media (hover: none) {
    /* Touch: rely on focus/tap; keep tooltip out of the way until focus */
    .article-highlight:hover::after,
    .article-highlight:hover::before {
      opacity: 0;
      visibility: hidden;
    }
  }
</style>
