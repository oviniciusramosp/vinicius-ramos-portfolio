---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NextProject from '../../components/NextProject.astro';
import {
  articles,
  getArticleById,
  getNextArticle,
  articleHref,
  isArticleHighlight,
  youtubeEmbedSrc,
  type ArticleParagraph,
} from '../../data/articles';
import { site } from '../../data/site';

export function getStaticPaths() {
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

interface Props {
  article: NonNullable<ReturnType<typeof getArticleById>>;
}

const { article } = Astro.props;
const next = getNextArticle(article.id);
const noteEmbed = article.note?.youtubeUrl
  ? youtubeEmbedSrc(article.note.youtubeUrl)
  : undefined;

function paragraphParts(paragraph: ArticleParagraph) {
  return typeof paragraph === 'string' ? [paragraph] : paragraph;
}
---

<BaseLayout
  title={`${site.name} · ${article.title}`}
  description={article.description}
  image={article.image}
  imageAlt={article.imageAlt ?? article.title}
>
  <article class="article-page">
    <header class="article-page__header">
      <h1 class="article-page__title display-title">{article.title}</h1>
      <p class="article-page__date">{article.date}</p>
    </header>

    {
      article.image && (
        <figure class="article-page__figure">
          <img
            class="article-page__image"
            src={article.image}
            alt={article.imageAlt ?? article.title}
            loading="eager"
            decoding="async"
            style={
              article.imageObjectPosition
                ? `object-position: ${article.imageObjectPosition}`
                : undefined
            }
          />
        </figure>
      )
    }

    <div class="article-page__body">
      {
        article.content.map((paragraph) => (
          <p class="article-page__p body-text">
            {paragraphParts(paragraph).map((part) =>
              isArticleHighlight(part) ? (
                <a
                  class="article-highlight"
                  href={part.href}
                  data-tooltip={part.tooltip}
                  data-transition-label={part.tooltip.replace(/^View Project:\s*/i, '')}
                  data-cursor="block"
                >
                  {part.text}
                </a>
              ) : (
                part
              ),
            )}
          </p>
        ))
      }
    </div>

    {
      article.note && (
        <aside class="article-note" aria-label={article.note.label ?? 'Addition'}>
          <p class="article-note__label">{article.note.label ?? 'Addition'}</p>
          {article.note.paragraphs.map((p) => (
            <p class="article-note__p body-text">{p}</p>
          ))}
          {noteEmbed && (
            <div class="article-note__video">
              <iframe
                class="article-note__iframe"
                src={noteEmbed}
                title="MKBHD — Apple and the AI race"
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
              />
            </div>
          )}
        </aside>
      )
    }
  </article>

  {
    next && (
      <NextProject
        label="NEXT"
        title={next.title}
        href={articleHref(next.id)}
      />
    )
  }
</BaseLayout>

<style>
  .article-page {
    width: 100%;
    max-width: min(720px, var(--shell-max));
    margin-inline: auto;
    padding: var(--space-12) var(--page-pad-x) var(--space-10);
  }

  .article-page__header {
    display: grid;
    gap: var(--space-5);
    margin-bottom: var(--space-9);
  }

  .article-page__title {
    margin: 0;
    max-width: 18ch;
  }

  .article-page__date {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    line-height: 1.35;
    color: var(--color-accent);
  }

  .article-page__figure {
    margin: 0 0 var(--space-9);
    border-radius: 16px;
    overflow: hidden;
    background: var(--color-surface, #131219);
  }

  .article-page__image {
    display: block;
    width: 100%;
    height: auto;
    max-height: 360px;
    object-fit: cover;
    object-position: center;
  }

  .article-page__body {
    display: flex;
    flex-direction: column;
    gap: 1.15em;
  }

  .article-page__p {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.75;
    color: var(--color-text-soft, rgba(255, 255, 255, 0.75));
  }

  /* Postscript / addition after original post */
  .article-note {
    margin-top: var(--space-10);
    padding-top: var(--space-9);
    border-top: 1px solid var(--color-border);
    display: grid;
    gap: var(--space-6);
    width: 100%;
  }

  .article-note__label {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 400;
    line-height: var(--lh-tight);
    letter-spacing: 0;
    text-transform: uppercase;
    /* Same tone as post body */
    color: var(--color-text-soft, rgba(255, 255, 255, 0.75));
  }

  .article-note__p {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.75;
    color: var(--color-text-soft, rgba(255, 255, 255, 0.75));
  }

  .article-note__video {
    position: relative;
    width: 100%;
    max-width: 100%;
    aspect-ratio: 16 / 9;
    /* Same radius as case bentos */
    border-radius: var(--radius-sm, 8px);
    overflow: hidden;
    background: #0a0a0c;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
  }

  .article-note__iframe {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* Marker highlight → project link */
  .article-highlight {
    position: relative;
    display: inline;
    color: var(--color-text, #fff);
    text-decoration: none;
    /* marker stroke under the words */
    background-image: linear-gradient(
      transparent 0 58%,
      rgba(0, 143, 255, 0.42) 58% 92%,
      transparent 92% 100%
    );
    background-repeat: no-repeat;
    background-size: 100% 100%;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    border-radius: 2px;
    transition:
      background-image 200ms ease,
      color 200ms ease;
  }

  .article-highlight:hover,
  .article-highlight:focus-visible {
    color: #fff;
    background-image: linear-gradient(
      transparent 0 50%,
      rgba(0, 143, 255, 0.72) 50% 96%,
      transparent 96% 100%
    );
    outline: none;
  }

  .article-highlight:focus-visible {
    box-shadow: 0 0 0 2px var(--color-accent);
    border-radius: 3px;
  }

  /* Tooltip above the highlight */
  .article-highlight::after {
    content: attr(data-tooltip);
    position: absolute;
    left: 50%;
    bottom: calc(100% + 10px);
    z-index: 5;
    transform: translateX(-50%) translateY(4px);
    padding: 8px 12px;
    border-radius: 8px;
    background: var(--color-surface-elevated, #17161d);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0;
    color: var(--color-text, #fff);
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 160ms ease,
      transform 160ms ease,
      visibility 160ms ease;
  }

  .article-highlight::before {
    content: '';
    position: absolute;
    left: 50%;
    bottom: calc(100% + 4px);
    z-index: 5;
    width: 8px;
    height: 8px;
    margin-left: -4px;
    background: var(--color-surface-elevated, #17161d);
    border-right: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    transform: translateY(4px) rotate(45deg);
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 160ms ease,
      transform 160ms ease,
      visibility 160ms ease;
  }

  .article-highlight:hover::after,
  .article-highlight:focus-visible::after {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  .article-highlight:hover::before,
  .article-highlight:focus-visible::before {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) rotate(45deg);
  }

  @media (max-width: 768px) {
    .article-page {
      padding: 48px 16px 40px;
    }

    .article-page__image {
      max-height: 240px;
    }

    .article-highlight::after {
      white-space: normal;
      max-width: min(240px, 70vw);
      text-align: center;
    }
  }

  @media (hover: none) {
    /* Touch: rely on focus/tap; keep tooltip out of the way until focus */
    .article-highlight:hover::after,
    .article-highlight:hover::before {
      opacity: 0;
      visibility: hidden;
    }
  }
</style>
