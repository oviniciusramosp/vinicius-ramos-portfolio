---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import { site } from '../data/site';
import { getHomeProjects } from '../data/projects';
import {
  jsonLdGraph,
  personJsonLd,
  websiteJsonLd,
  webPageJsonLd,
} from '../utils/seo';

const projects = getHomeProjects();
// Filter chips hidden for now — re-enable with getHomeFilterTags() later

const jsonLd = jsonLdGraph([
  personJsonLd(),
  websiteJsonLd(),
  webPageJsonLd({
    path: '/',
    title: site.title,
    description: site.description,
    type: 'ProfilePage',
    image: site.ogImage,
  }),
]);
---

<BaseLayout title={site.title} description={site.description} jsonLd={jsonLd} showBanner>
  {/* Same frame as case study <header class="page-hero"> (crypto-bros etc.) */}
  <section class="page-hero">
    <div class="page-hero__main">
      <h1 class="hero__title display-title" data-cursor="text-title">{site.hero.title}</h1>
      <p class="hero__bio body-text" data-cursor="text">{site.hero.bio}</p>
    </div>
  </section>

  <ProjectGrid projects={projects} />
</BaseLayout>

<style>
  /* Frame size/padding come only from global .page-hero (shared with case headers). */
  .hero__title {
    max-width: 12ch;
  }

  .hero__bio {
    max-width: 720px;
  }
</style>
