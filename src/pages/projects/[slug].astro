---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tag from '../../components/Tag.astro';
import Button from '../../components/Button.astro';
import EmbedModal from '../../components/EmbedModal.astro';
import ScrollGallery from '../../components/ScrollGallery.astro';
import DeckSlider from '../../components/DeckSlider.astro';
import SocialFan from '../../components/SocialFan.astro';
import Device3D from '../../components/Device3D.astro';
import NextProject from '../../components/NextProject.astro';
import OptimizedImg from '../../components/OptimizedImg.astro';
import {
  getPublishedProjects,
  getProject,
  type Project,
  type CaseBlock,
  type CaseImage,
  type CaseBentoCell,
} from '../../data/projects';
import { site } from '../../data/site';
import { optimizedUrl } from '../../utils/optimized-url';

export function getStaticPaths() {
  return getPublishedProjects().map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const next = project.nextSlug ? getProject(project.nextSlug) : undefined;
const useBlocks = Boolean(project.blocks && project.blocks.length > 0);
/** Prefer front cover layer for share cards; fall back to back cover */
const ogSource = project.coverFront ?? project.cover;
const ogImage =
  (await optimizedUrl(ogSource, { width: 1200, quality: 80, format: 'jpg' })) ?? ogSource;

const quotes = project.quotes ?? [];
/** Quotes always use ScrollGallery (incentive-gallery-dark): paddlenav, no autoplay, all cards visible */
const quoteIncentiveItems = quotes.map((quote, index) => ({
  id: `${project.slug}-quote-${index}`,
  kind: 'quote' as const,
  /** role · author · optional avatar */
  label: quote.role,
  headline: quote.author,
  body: quote.text,
  avatar: quote.avatar,
}));

/** Section CTAs that open embed modals (deduped by href) */
const embedModals = (project.blocks ?? [])
  .filter(
    (b): b is Extract<CaseBlock, { type: 'section' }> =>
      b.type === 'section' && Boolean(b.cta?.modal && b.cta.href),
  )
  .map((b, i) => ({
    id: `${project.slug}-embed-${i}`,
    src: b.cta!.href,
  }));

function embedModalIdForHref(href: string) {
  return embedModals.find((m) => m.src === href)?.id;
}

/** Read public SVG at build/SSR time for reliable inlining (no client fetch race). */
function readPublicSvg(publicPath: string | undefined): string | undefined {
  if (!publicPath?.startsWith('/') || !publicPath.endsWith('.svg')) return undefined;
  try {
    const file = path.join(process.cwd(), 'public', publicPath.replace(/^\//, ''));
    return fs.readFileSync(file, 'utf8');
  } catch {
    return undefined;
  }
}

/** Render **bold** markers from case-study copy */
function inlineHtml(text: string) {
  return text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
}

function cellClass(cell: CaseBentoCell) {
  const span = cell.span ?? '1x1';
  const parts = [`case-bento__cell`, `case-bento__cell--${span}`];
  if (cell.kind === 'image' && cell.padded) parts.push('case-bento__cell--padded');
  if (cell.kind === 'image' && cell.spin) parts.push('case-bento__cell--spin');
  if (cell.kind === 'image' && cell.animate === 'logo-mark') {
    parts.push('case-bento__cell--logo-mark');
  }
  if (cell.kind === 'image' && cell.animate === 'layer-reveal') {
    parts.push('case-bento__cell--layer-reveal');
  }
  if (cell.kind === 'image' && cell.animate === 'logo-evolution') {
    parts.push('case-bento__cell--logo-evolution');
  }
  if (cell.kind === 'caption') parts.push('case-bento__cell--caption');
  if (cell.kind === 'social-fan') parts.push('case-bento__cell--social-fan');
  if (cell.kind === 'device-3d') parts.push('case-bento__cell--device-3d');
  if (cell.kind === 'icon-set') parts.push('case-bento__cell--icon-set');
  if (cell.surface === 'light') parts.push('case-bento__cell--light');
  if (cell.surface === 'brand') parts.push('case-bento__cell--brand');
  return parts.join(' ');
}
---

<BaseLayout
  title={`${site.name} · ${project.title}`}
  description={project.summary}
  image={ogImage}
  imageAlt={`${project.title} — project cover`}
>
  <article class="case">
    <header class="page-hero case__hero">
      <div class="page-hero__main case__hero-main">
        {/* Live Framer: year + tags share the same pill component */}
        <div class="case__tags" data-framer-name="Tags">
          <Tag label={project.year} />
          {project.tags.map((tag) => <Tag label={tag} />)}
        </div>
        <h1 class="display-title case__title">{project.title}</h1>
        <p class="case__summary body-text">{project.summary}</p>
      </div>
    </header>

    {
      useBlocks ? (
        project.blocks!.map((block: CaseBlock) => {
          if (block.type === 'bento') {
            const columns = block.columns ?? 4;
            const shell = block.shell ?? 'full';
            const layout = block.layout;
            return (
              <div
                class:list={[
                  'case__media',
                  'case__media--bento',
                  shell === 'content' && 'case__media--bento-content',
                ]}
              >
                <div
                  class:list={[
                    'case-bento',
                    columns === 3 && 'case-bento--cols-3',
                    columns === 5 && 'case-bento--cols-5',
                    layout === 'split-3-2' && 'case-bento--split-3-2',
                  ]}
                >
                  {block.cells.map((cell) =>
                    cell.kind === 'caption' ? (
                      <div class={cellClass(cell)}>
                        {cell.texture && (
                          <div
                            class="case-bento__texture"
                            aria-hidden="true"
                            style={`background-image: url('${cell.texture}')`}
                          />
                        )}
                        <div class="case-bento__caption-stack">
                          <div class="case-bento__chip case-bento__chip--text">
                            <p class="case-bento__caption">{cell.text}</p>
                          </div>
                          {cell.lottie && (
                            <div class="case-bento__chip case-bento__chip--lottie">
                              <div
                                class="case-bento__lottie"
                                data-lottie
                                data-src={cell.lottie}
                                data-speed={String(cell.lottieSpeed ?? 1)}
                              />
                            </div>
                          )}
                        </div>
                      </div>
                    ) : cell.kind === 'social-fan' ? (
                      <div class={cellClass(cell)}>
                        <SocialFan
                          images={cell.images.map((img) => ({
                            src: img.src,
                            alt: img.alt,
                            aspect: img.aspect ? Number(img.aspect) : undefined,
                          }))}
                          aspect={
                            cell.images[0]?.aspect
                              ? Number(cell.images[0].aspect)
                              : 0.75
                          }
                          ariaLabel={cell.ariaLabel ?? 'Social posts'}
                        />
                      </div>
                    ) : cell.kind === 'device-3d' ? (
                      <div class={cellClass(cell)}>
                        <Device3D
                          model={cell.model}
                          screen={cell.screen}
                          alt={cell.alt}
                          poster={cell.poster}
                        />
                      </div>
                    ) : cell.kind === 'icon-set' ? (
                      <div class={cellClass(cell)}>
                        <div
                          class="case-bento__icon-set"
                          role="group"
                          aria-label="App icons"
                        >
                          {cell.icons.map((icon, iconIndex) => (
                            <div
                              class:list={[
                                'case-bento__icon',
                                icon.glow && 'case-bento__icon--glow',
                                iconIndex === 0 && 'case-bento__icon--shadow-white',
                                iconIndex === 1 && 'case-bento__icon--shadow-orange',
                                iconIndex === 2 && 'case-bento__icon--shadow-blue',
                              ]}
                            >
                              <OptimizedImg
                                src={icon.src}
                                alt={icon.alt}
                                preset="icon"
                                loading="eager"
                                decoding="async"
                                draggable="false"
                                objectFit="contain"
                              />
                            </div>
                          ))}
                        </div>
                      </div>
                    ) : cell.kind === 'image' && cell.animate === 'logo-mark' ? (
                      <div class={cellClass(cell)}>
                        <div
                          class="case-bento__logo-mark"
                          data-logo-mark
                          data-src={cell.src}
                          role="img"
                          aria-label={cell.alt}
                          set:html={readPublicSvg(cell.src) ?? ''}
                        />
                      </div>
                    ) : cell.kind === 'image' && cell.animate === 'logo-evolution' ? (
                      <div class={cellClass(cell)}>
                        <div
                          class="case-bento__logo-evolution"
                          data-logo-evolution
                          data-src={cell.src}
                          data-cascade-index={
                            cell.kind === 'image' && cell.cascadeIndex != null
                              ? String(cell.cascadeIndex)
                              : undefined
                          }
                          role="img"
                          aria-label={cell.alt}
                          set:html={readPublicSvg(cell.src) ?? ''}
                        />
                      </div>
                    ) : cell.kind === 'image' && cell.animate === 'layer-reveal' ? (
                      <div class={cellClass(cell)}>
                        <div
                          class="case-bento__layered"
                          data-layer-reveal
                          role="img"
                          aria-label={cell.alt}
                        >
                          <OptimizedImg
                            class="case-bento__layered-bg"
                            src={cell.src}
                            alt=""
                            preset="hero"
                            loading="eager"
                            draggable="false"
                            objectFit={cell.fit ?? 'cover'}
                            objectPosition={cell.objectPosition}
                          />
                          {cell.front && (
                            <div class="case-bento__layered-front" aria-hidden="true">
                              <OptimizedImg
                                class="case-bento__layered-front-img"
                                src={cell.front}
                                alt=""
                                preset="hero"
                                loading="eager"
                                draggable="false"
                                objectFit="contain"
                              />
                            </div>
                          )}
                        </div>
                      </div>
                    ) : (
                      <div class={cellClass(cell)}>
                        {cell.texture && (
                          <div
                            class="case-bento__texture"
                            aria-hidden="true"
                            style={`background-image: url('${cell.texture}')`}
                          />
                        )}
                        <OptimizedImg
                          src={cell.src}
                          alt={cell.alt}
                          preset="hero"
                          loading="eager"
                          objectFit={cell.fit ?? 'cover'}
                          objectPosition={cell.objectPosition}
                          style={
                            cell.kind === 'image' && cell.scale
                              ? `transform: scale(${cell.scale})`
                              : undefined
                          }
                        />
                      </div>
                    ),
                  )}
                </div>
              </div>
            );
          }

          if (block.type === 'section') {
            const cta = block.cta;
            const embedId =
              cta?.modal && cta.href ? embedModalIdForHref(cta.href) : undefined;
            return (
              <section class="case__section">
                <div class="case__section-inner">
                  {block.title && <h2 class="section-title">{block.title}</h2>}
                  <div class="case__copy">
                    {block.paragraphs.map((p) => (
                      <p class="body-text" set:html={inlineHtml(p)} />
                    ))}
                    {cta && (
                      <div class="case__cta">
                        {embedId ? (
                          <Button
                            label={cta.label}
                            eyebrow={cta.eyebrow}
                            variant="ghost"
                            embedOpen={embedId}
                            icon={cta.icon}
                          />
                        ) : (
                          <Button
                            label={cta.label}
                            eyebrow={cta.eyebrow}
                            href={cta.href}
                            variant="ghost"
                            external
                            icon={cta.icon}
                          />
                        )}
                      </div>
                    )}
                  </div>
                </div>
              </section>
            );
          }

          if (block.type === 'gallery') {
            const isScroll = block.layout === 'scroll';
            const isStack = block.layout === 'stack';
            return (
              <div class={`case__media case__media--${block.layout}`}>
                {block.title && (
                  <h2 class="section-title case__gallery-title">{block.title}</h2>
                )}
                <div
                  class={`case-gallery case-gallery--${block.layout}`}
                  data-gallery-slider={isScroll ? '' : undefined}
                >
                  {block.images.map((img: CaseImage, imgIndex: number) => (
                    <figure
                      class:list={[
                        'case-gallery__item',
                        isStack && `case-gallery__item--stack-${imgIndex + 1}`,
                        img.hideOn === 'mobile' && 'case-gallery__item--hide-mobile',
                        img.card && 'case-gallery__item--card',
                        img.card && img.fit === 'contain' && 'case-gallery__item--card-padded',
                        img.card && img.cardAlign === 'end' && 'case-gallery__item--card-end',
                      ]}
                      style={[
                        img.aspect ? `aspect-ratio: ${img.aspect}` : null,
                        /* pair-height reads --pair-flex for column share (∝ aspect) */
                        block.layout === 'pair-height' && img.aspect
                          ? `--pair-flex: ${img.aspect}`
                          : null,
                      ]
                        .filter(Boolean)
                        .join('; ')}
                    >
                      <OptimizedImg
                        src={img.src}
                        alt={img.alt}
                        preset="gallery"
                        loading="lazy"
                        objectFit={img.fit ?? 'cover'}
                        objectPosition={img.objectPosition}
                      />
                    </figure>
                  ))}
                </div>
              </div>
            );
          }

          if (block.type === 'deck-slider') {
            const isPresentation = block.variant === 'presentation';
            return (
              <div
                class:list={[
                  'case__media',
                  isPresentation ? 'case__media--presentation' : 'case__media--decks',
                ]}
              >
                {block.title && (
                  <h2 class="section-title case__gallery-title">{block.title}</h2>
                )}
                <DeckSlider
                  decks={block.decks}
                  texture={block.texture}
                  variant={block.variant ?? 'wireframes'}
                  autoplay={
                    block.autoplay ??
                    (block.variant === 'presentation' || block.variant === 'slides'
                      ? false
                      : true)
                  }
                  ariaLabel={
                    block.title ??
                    (block.variant === 'presentation' || block.variant === 'slides'
                      ? 'Presentation'
                      : 'Wireframe decks')
                  }
                />
              </div>
            );
          }

          if (block.type === 'scroll-gallery') {
            return (
              <ScrollGallery
                id={`${project.slug}-scroll-${block.ariaLabel?.replace(/\s+/g, '-').toLowerCase() ?? 'gallery'}`}
                title={block.title}
                items={block.items}
                theme={block.theme ?? 'dark'}
                short={block.short ?? true}
                entrance={block.entrance ?? false}
                ariaLabel={block.ariaLabel ?? block.title ?? 'Gallery'}
              />
            );
          }

          if (block.type === 'video') {
            const showControls = Boolean(block.controls);
            return (
              <div class="case__media case__media--video">
                <div
                  class:list={['case-video-block', showControls && 'case-video-block--controls']}
                  data-case-video-block={showControls ? '' : undefined}
                >
                  <div
                    class="case-video"
                    style={block.aspect ? `aspect-ratio: ${block.aspect}` : undefined}
                  >
                    <video
                      src={block.src}
                      poster={block.poster}
                      aria-label={block.alt ?? 'Product demo video'}
                      autoplay
                      muted
                      loop
                      playsinline
                      preload="auto"
                      data-case-video={showControls ? '' : undefined}
                      style={`object-fit: ${block.fit ?? 'cover'}`}
                    />
                  </div>
                  {showControls && (
                    <div class="case-video-block__bar">
                      <button
                        type="button"
                        class="case-video-block__toggle"
                        data-case-video-toggle
                        aria-label="Pause video"
                        aria-pressed="false"
                      >
                        <ion-icon name="pause" data-case-video-icon aria-hidden="true" />
                      </button>
                    </div>
                  )}
                </div>
              </div>
            );
          }

          return null;
        })
      ) : (
        <>
          <div class="case__cover">
            <OptimizedImg
              src={project.cover}
              alt={`${project.title} cover`}
              preset="full"
              loading="eager"
              objectFit="cover"
            />
          </div>
          {project.sections.map((section) => (
            <section class="case__section">
              <div class="case__section-inner">
                <h2 class="section-title">{section.title}</h2>
                <div class="case__copy">
                  {section.paragraphs.map((p) => (
                    <p class="body-text">{p}</p>
                  ))}
                </div>
                {section.images && section.images.length > 0 && (
                  <div class="case__gallery" data-gallery-slider>
                    {section.images.map((src, i) => (
                      <figure class="case__figure">
                        <OptimizedImg
                          src={src}
                          alt={`${section.title} visual ${i + 1}`}
                          preset="gallery"
                          loading="lazy"
                          objectFit="cover"
                        />
                      </figure>
                    ))}
                  </div>
                )}
              </div>
            </section>
          ))}
        </>
      )
    }

    {
      quotes.length > 0 && (
        <ScrollGallery
          id={`${project.slug}-quotes`}
          items={quoteIncentiveItems}
          theme="dark"
          short={true}
          entrance={false}
          ariaLabel="Testimonials"
        />
      )
    }

    {
      project.note && (
        <p class="case__note body-text">{project.note}</p>
      )
    }

    {
      next && next.href && !next.soon && (
        <NextProject title={next.title} href={next.href} />
      )
    }

    {
      embedModals.map((modal) => (
        <EmbedModal id={modal.id} src={modal.src} />
      ))
    }
  </article>
</BaseLayout>

<script>
  /**
   * ClientRouter (view transitions) inserts new <video> nodes without
   * re-honoring the autoplay attribute. Full reloads work; SPA navigations
   * leave muted loops black until play() is called explicitly.
   */
  function kickCaseVideos() {
    document.querySelectorAll<HTMLVideoElement>('.case-video video').forEach((video) => {
      // Autoplay policies require muted + playsInline
      video.muted = true;
      video.defaultMuted = true;
      video.playsInline = true;
      video.setAttribute('playsinline', '');
      video.setAttribute('webkit-playsinline', '');

      const tryPlay = () => {
        if (video.paused) {
          void video.play().catch(() => undefined);
        }
      };

      // Resource may not have started after a DOM swap — nudge the media pipeline
      if (video.readyState === 0 && video.src) {
        video.load();
      }

      if (video.readyState >= 2) {
        tryPlay();
      } else {
        video.addEventListener('canplay', tryPlay, { once: true });
        // Also attempt immediately — some browsers start once muted is forced
        tryPlay();
      }
    });
  }

  function bindCaseVideoBlocks() {
    document.querySelectorAll<HTMLElement>('[data-case-video-block]').forEach((block) => {
      const video = block.querySelector<HTMLVideoElement>('[data-case-video]');
      const btn = block.querySelector<HTMLButtonElement>('[data-case-video-toggle]');
      const icon = block.querySelector<HTMLElement>('[data-case-video-icon]');
      if (!video || !btn || !icon) return;
      if ((btn as HTMLButtonElement & { __bound?: boolean }).__bound) return;
      (btn as HTMLButtonElement & { __bound?: boolean }).__bound = true;

      const sync = () => {
        const paused = video.paused;
        icon.setAttribute('name', paused ? 'play' : 'pause');
        btn.setAttribute('aria-label', paused ? 'Play video' : 'Pause video');
        btn.setAttribute('aria-pressed', paused ? 'true' : 'false');
      };

      btn.addEventListener('click', () => {
        if (video.paused) {
          void video.play().catch(() => undefined);
        } else {
          video.pause();
        }
        // play() is async; also listen to events
        requestAnimationFrame(sync);
      });

      video.addEventListener('play', sync);
      video.addEventListener('pause', sync);
      sync();
    });
  }

  function initCaseVideos() {
    kickCaseVideos();
    bindCaseVideoBlocks();
  }

  initCaseVideos();
  document.addEventListener('astro:page-load', initCaseVideos);
</script>

<style>
  /*
   * Case study layout — mapped from live Framer breakpoints:
   *   mobile  ≤809px
   *   tablet  810–1193px
   *   desktop ≥1194px
   *   xl      ≥1536px
   */

  /* Same shell as home nav / bento — all case pages share this */
  .case {
    width: 100%;
    max-width: var(--shell-max);
    margin-inline: auto;
  }

  /* —— Hero frame: global .page-hero (shared with homepage) —— */
  .case__tags {
    display: flex;
    flex-flow: row wrap;
    align-items: center;
    gap: 4px;
    width: 100%;
  }

  .case__title {
    text-transform: uppercase;
  }

  .case__summary {
    max-width: 720px;
  }

  /* —— Text sections —— */
  .case__section {
    width: 100%;
    padding: 24px 16px;
  }

  .case__section-inner {
    display: grid;
    gap: 16px;
    width: 100%;
    max-width: 920px;
  }

  /* 3-col grid on tablet+ so copy spans ~2/3 like Framer TextArea */
  @media (min-width: 810px) {
    .case__section-inner {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
      max-width: none;
    }

    .case__section-inner > .section-title,
    .case__section-inner > .case__copy {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1194px) {
    .case__section-inner > .section-title,
    .case__section-inner > .case__copy {
      grid-column: span 2;
    }
  }

  .case__section .section-title {
    margin: 0;
  }

  .case__copy {
    display: grid;
    gap: 1em;
  }

  .case__copy :global(strong) {
    font-weight: 600;
    color: var(--color-text);
  }

  .case__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 0.25em;
  }

  /* Match Quotes paddlenav glass chip (default fill, stronger on hover/magnetic) */
  .case__cta :global(.btn--ghost .btn__visual) {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(14px) saturate(160%);
  }

  .case__cta :global(.btn--ghost:hover .btn__visual),
  .case__cta :global(.btn--ghost:focus-visible .btn__visual),
  .case__cta :global(.btn--ghost.is-magnetic .btn__visual) {
    background: rgba(255, 255, 255, 0.16);
  }

  /* —— Media shells (galleries + bento) —— */
  .case__media {
    width: 100%;
    padding: 16px;
  }

  /* ImagesFull hero shell (edge pad). Content-shell strips keep .case__media pad. */
  .case__media--bento:not(.case__media--bento-content) {
    padding: 16px;
  }

  .case__gallery-title {
    margin: 0 0 16px;
    padding-inline: 0;
  }

  /*
   * Deck track is full-bleed for peeks; keep the eyebrow title on the same
   * content measure as section copy / active deck card (--pad-x in DeckSlider).
   */
  .case__media--decks > .case__gallery-title {
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    padding-inline: 16px;
  }

  /*
   * Hero bento (ImagesFull) — live Framer grid:
   *   mobile  ≤809.98  → 2 cols × rows 144px
   *   tablet  810–1193 → 4 cols × rows 150px
   *   desktop ≥1194    → 4 cols × rows 220px (height 692)
   *   xl      ≥1536    → 4 cols × rows 290px
   */
  .case-bento {
    display: grid;
    grid-template-columns: repeat(2, minmax(120px, 1fr));
    grid-template-rows: repeat(3, 144px);
    grid-auto-rows: 144px;
    gap: 8px;
    width: 100%;
  }

  /*
   * Split 3+2 (Identity kit): 2 equal columns × 6 equal tracks.
   * Left cards (1×2) match logo-evolution SVG viewBox 1083∶658.
   * Height from container width: each left card is colW × (colW·658/1083);
   * right cards (1×3) split that stack 50/50.
   */
  .case-bento--split-3-2 {
    --split-gap: 8px;
    container-type: inline-size;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(6, 1fr);
    grid-auto-rows: unset;
    /* colW = (cqw - gap) / 2; cardH = colW * 658/1083; total = 3·cardH + 2·gap */
    height: calc(
      3 * ((100cqw - var(--split-gap)) / 2) * 658 / 1083 + 2 * var(--split-gap)
    );
  }

