  .case-bento__logo-mark {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 0;
    --mx: 50%;
    --my: 50%;
    --logo-mark-radius: 0px;
  }

  .case-bento__logo-mark :global(svg) {
