---
import BaseLayout from '../layouts/BaseLayout.astro';
import LogoWave from '../components/LogoWave.astro';
import { links } from '../data/links';
import { site } from '../data/site';
import {
  jsonLdGraph,
  personJsonLd,
  webPageJsonLd,
  websiteJsonLd,
} from '../utils/seo';

const pageTitle = `${site.name} · Links`;
const pageDescription = site.pages.links;

const jsonLd = jsonLdGraph([
  personJsonLd(),
  websiteJsonLd(),
  webPageJsonLd({
    path: '/links',
    title: pageTitle,
    description: pageDescription,
    type: 'ProfilePage',
  }),
]);
---

{/*
  Full-viewport clone of the mobile menu (Header .site-menu):
  top bar with wordmark, large centered Blatant links, 2-line mono footer.
  No site header/footer chrome — that would fight this layout.
*/}
<BaseLayout
  title={pageTitle}
  description={pageDescription}
  jsonLd={jsonLd}
  showHeader={false}
  showFooter={false}
>
  <section class="links" data-links-page>
    <header class="links__top">
      <LogoWave />
    </header>

    <h1 class="sr-only">Links</h1>

    <nav class="links__nav" aria-label="Links">
      {
        links.map((item, i) => {
          const isExternal =
            item.external ?? /^https?:\/\//i.test(item.href);
          return (
            <a
              class="links__link"
              href={item.href}
              data-transition-label={item.label.toUpperCase()}
              data-cursor="block"
              style={`--i: ${i}`}
              {...(isExternal
                ? { target: '_blank', rel: 'noopener noreferrer' }
                : {})}
            >
              <span class="links__link-label">{item.label}</span>
            </a>
          );
        })
      }
    </nav>

    <div class="links__footer">
      <a
        class="links__social"
        href={site.social.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        data-cursor="block"
      >
        linkedin
      </a>
      <p class="links__note" data-cursor="block">
        made with
        <span class="links__heart" aria-hidden="true">
          <ion-icon name="heart"></ion-icon>
        </span>
        in Brazil
      </p>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /*
   * Fill the shell like .site-menu (fixed fullscreen panel).
   * Global so we can size against .page-main without fighting scoped attrs.
   */
  .page-main:has([data-links-page]) {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 100dvh;
  }
</style>

<style>
  /* —— Layout: same structure as Header .site-menu —— */
  .links {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 100dvh;
    height: 100%;
    padding:
      0
      24px
      max(28px, env(safe-area-inset-bottom, 0px));
    box-sizing: border-box;
    background: #000;
  }

  /* Top bar — same optical height as site nav */
  .links__top {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    height: var(--nav-height);
    min-height: var(--nav-height);
    width: 100%;
    max-width: var(--content-max);
    margin-inline: auto;
    padding-block: 12px;
    box-sizing: border-box;
  }

  /* Centered stack of large display titles */
  .links__nav {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(4px, 1.5vh, 12px);
    min-height: 0;
    width: 100%;
    text-align: center;
  }

  .links__link {
    display: block;
    width: 100%;
    max-width: 16ch;
    padding: 0.12em 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(42px, 12.5vw, 72px);
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--color-text);
    text-decoration: none;
    text-align: center;
    -webkit-tap-highlight-color: transparent;
    -webkit-user-select: none;
    user-select: none;
    outline: none;
    transition: color 200ms ease;
  }

  .links__link:focus,
  .links__link:focus-visible {
    outline: none;
  }

  .links__link:hover,
  .links__link:active {
    color: var(--color-accent);
  }

  .links__link:focus-visible {
    color: var(--color-accent);
  }

  .links__link-label {
    display: block;
  }

  /* 2-line centered meta — same as .site-menu__footer */
  .links__footer {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding-top: 16px;
    text-align: center;
  }

  .links__social {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text);
    text-decoration: none;
    letter-spacing: -0.02em;
    -webkit-tap-highlight-color: transparent;
    -webkit-user-select: none;
    user-select: none;
    outline: none;
    transition: color 200ms ease;
  }

  .links__social:focus,
  .links__social:focus-visible {
    outline: none;
  }

  .links__social:hover,
  .links__social:active {
    color: var(--color-accent);
  }

  .links__social:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .links__note {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45em;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    cursor: none;
    -webkit-user-select: none;
    user-select: none;
    transition: color 0.2s ease;
  }

  .links__heart {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1em;
    line-height: 1;
    color: currentColor;
    transform-origin: center center;
    transition: color 0.2s ease;
  }

  .links__heart :global(ion-icon) {
    display: block;
    width: 1em;
    height: 1em;
    pointer-events: none;
  }

  .links__note:hover {
    color: #009c3b; /* Brazil flag green */
  }

  .links__note:hover .links__heart {
    color: #ffdf00; /* Brazil flag yellow */
    animation: links-heart-pulse 1.1s ease-in-out infinite;
  }

  @keyframes links-heart-pulse {
    0% {
      transform: scale(1);
    }
    12% {
      transform: scale(1.32);
    }
    24% {
      transform: scale(1);
    }
    36% {
      transform: scale(1.22);
    }
    50% {
      transform: scale(1);
    }
    100% {
      transform: scale(1);
    }
  }

  @media (max-width: 640px) {
    .links__top {
      padding-inline: 0;
      padding-block: 10px;
    }

    .links__top :global(.logo-wave) {
      font-size: 24px;
      height: 24px;
      line-height: 1;
    }

    .links__top :global(.logo-wave__row),
    .links__top :global(.logo-wave__letter),
    .links__top :global(.logo-wave__space),
    .links__top :global(.logo-wave__letter svg) {
      height: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .links__note:hover .links__heart {
      animation: none;
      transform: scale(1.1);
    }
  }
</style>
