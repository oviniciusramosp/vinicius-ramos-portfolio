---
/**
 * Lab: full map of Blatant width alternates (aalt) + morph compatibility.
 * Route: /preview/blatant-widths
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import data from '../../data/blatant-width-alts.json';

const { summary, families, view } = data;
const maxW = view.maxWidth;
const viewH = view.height;
const padY = view.padY;

const kindMeta: Record<
  string,
  { label: string; hint: string; tone: string }
> = {
  full: {
    label: 'full morph',
    hint: 'default ↔ alt1 ↔ alt2 (paths compatíveis)',
    tone: 'full',
  },
  alts_only: {
    label: 'alts only',
    hint: 'default incompatível; alt1 ↔ alt2 morpha',
    tone: 'alts',
  },
  partial: {
    label: 'partial',
    hint: 'só parte da cadeia morpha',
    tone: 'partial',
  },
  none: {
    label: 'swap only',
    hint: 'tem alt, mas contornos incompatíveis',
    tone: 'none',
  },
};
---

<BaseLayout
  title="Preview · Blatant width alts"
  description="Mapa completo dos glifos Blatant com alternates de largura e compatibilidade de morph."
  robots="noindex, nofollow"
>
  <section class="lab" data-lab>
    <header class="lab__header">
      <p class="lab__eyebrow">Preview · tipografia</p>
      <h1 class="lab__title">Blatant · width alts</h1>
      <p class="lab__lede">
        Inventário de glifos com versões de largura (OpenType <code>aalt</code>).
        Mesma face, mesma “versão” do desenho — não é eixo de weight. Paths extraídos do OTF
        Regular.
      </p>
      <p class="lab__links">
        <a href="/preview/blatant-e">← prova da letra E</a>
      </p>
    </header>

    <!-- Summary -->
    <div class="stats" role="list">
      <div class="stat" role="listitem">
        <span class="stat__n">{summary.totalWithAlts}</span>
        <span class="stat__l">com alts</span>
      </div>
      <div class="stat stat--full" role="listitem">
        <span class="stat__n">{summary.counts.full}</span>
        <span class="stat__l">full morph</span>
      </div>
      <div class="stat stat--alts" role="listitem">
        <span class="stat__n">{summary.counts.alts_only}</span>
        <span class="stat__l">alts only</span>
      </div>
      <div class="stat stat--none" role="listitem">
        <span class="stat__n">{summary.counts.none}</span>
        <span class="stat__l">swap only</span>
      </div>
    </div>

    <!-- Morph stage -->
    <div class="player">
      <div class="player__top">
        <div>
          <h2 class="player__title">Morph</h2>
          <p class="player__sub" id="player-sub">Selecione um glifo morphável abaixo.</p>
        </div>
        <div class="player__pick" id="player-pick" hidden>
          <span class="player__char" id="player-char"></span>
          <span class="player__base" id="player-base"></span>
          <span class="badge" id="player-badge"></span>
        </div>
      </div>

      <div class="player__stage" id="player-stage" data-empty="true">
        <svg
          id="morph-svg"
          class="player__svg"
          viewBox={`0 0 ${maxW} ${viewH}`}
          preserveAspectRatio="xMidYMid meet"
          aria-hidden="true"
        >
          <g transform={`translate(0 ${viewH - padY}) scale(1 -1)`}>
            <path id="morph-path" fill="currentColor" d=""></path>
          </g>
        </svg>
        <p class="player__empty" id="player-empty">Clique num card com morph.</p>
        <div class="player__readout" id="player-readout" hidden>
          <span id="morph-label">—</span>
          <span id="morph-width">—</span>
        </div>
      </div>

      <div class="player__controls" id="player-controls" hidden>
        <label class="slider">
          <span class="slider__label">Largura</span>
          <input id="width-slider" class="slider__input" type="range" min="0" max="1000" value="0" />
          <span class="slider__ticks" id="slider-ticks"></span>
        </label>
        <div class="player__actions">
          <button type="button" id="btn-play" class="btn" data-playing="true">Pausar</button>
          <button type="button" id="btn-reset" class="btn btn--ghost">Reset</button>
        </div>
      </div>
    </div>

    <!-- Filters -->
    <div class="filters" role="toolbar" aria-label="Filtrar por tipo de morph">
      <button type="button" class="chip is-active" data-filter="all">Todos ({summary.totalWithAlts})</button>
      <button type="button" class="chip" data-filter="full">
        Full ({summary.counts.full})
      </button>
      <button type="button" class="chip" data-filter="alts_only">
        Alts only ({summary.counts.alts_only})
      </button>
      <button type="button" class="chip" data-filter="none">
        Swap only ({summary.counts.none})
      </button>
    </div>

    <!-- Legend -->
    <ul class="legend">
      {
        Object.entries(kindMeta).map(([k, m]) =>
          summary.counts[k as keyof typeof summary.counts] > 0 ? (
            <li class={`legend__item legend__item--${m.tone}`}>
              <strong>{m.label}</strong>
              <span>{m.hint}</span>
            </li>
          ) : null,
        )
      }
    </ul>

    <!-- Family grid -->
    <div class="grid" id="family-grid">
      {
        families.map((fam) => {
          const meta = kindMeta[fam.morphKind] ?? kindMeta.none;
          const canMorph = fam.morphableStages.length >= 2;
          return (
            <article
              class={`fam fam--${meta.tone}`}
              data-kind={fam.morphKind}
              data-base={fam.base}
              data-morphable={canMorph ? '1' : '0'}
            >
              <button
                type="button"
                class="fam__hit"
                disabled={!canMorph}
                data-select={fam.base}
                aria-label={
                  canMorph
                    ? `Morph ${fam.char ?? fam.base}`
                    : `${fam.char ?? fam.base} sem morph`
                }
              >
                <div class="fam__head">
                  <span class="fam__char" aria-hidden="true">
                    {fam.char ?? '?'}
                  </span>
                  <div class="fam__ids">
                    <span class="fam__base">{fam.base}</span>
                    <span class={`badge badge--${meta.tone}`}>{meta.label}</span>
                  </div>
                </div>

                <div class="fam__stages">
                  {fam.stages.map((stageName) => {
                    const v = fam.variants[stageName as keyof typeof fam.variants];
                    const inMorph = fam.morphableStages.includes(stageName);
                    return (
                      <div
                        class:list={['stage', !inMorph && fam.morphKind === 'alts_only' && stageName === fam.base && 'stage--excluded']}
                        title={stageName}
                      >
                        <svg
                          class="stage__svg"
                          viewBox={`0 0 ${maxW} ${viewH}`}
                          preserveAspectRatio="xMidYMid meet"
                        >
                          <g transform={`translate(0 ${viewH - padY}) scale(1 -1)`}>
                            <path d={v.path} fill="currentColor" />
                          </g>
                        </svg>
                        <span class="stage__name">{stageName.replace(`${fam.base}`, '').replace(/^\./, '') || 'default'}</span>
                        <span class="stage__w">{v.width}</span>
                      </div>
                    );
                  })}
                </div>

                <p class="fam__meta">
                  {canMorph ? (
                    <>
                      morph: {fam.morphableStages.join(' → ')}
                    </>
                  ) : (
                    <>alts incompatíveis (só troca discreta)</>
                  )}
                </p>
              </button>
            </article>
          );
        })
      }
    </div>

    <!-- Table dump -->
    <div class="table-wrap">
      <h2 class="table-title">Tabela</h2>
      <table class="table">
        <thead>
          <tr>
            <th>Char</th>
            <th>Base</th>
            <th>Stages</th>
            <th>Morph</th>
            <th>Advances</th>
            <th>Ratio max/min</th>
          </tr>
        </thead>
        <tbody>
          {
            families.map((fam) => {
              const widths = fam.stages.map((s) => fam.variants[s as keyof typeof fam.variants].width);
              const ratio = (Math.max(...widths) / Math.min(...widths)).toFixed(2);
              return (
                <tr data-kind={fam.morphKind}>
                  <td class="table__char">{fam.char ?? '—'}</td>
                  <td>
                    <code>{fam.base}</code>
                  </td>
                  <td>
                    <code>{fam.stages.length}</code>
                  </td>
                  <td>
                    <span class={`badge badge--${kindMeta[fam.morphKind]?.tone ?? 'none'}`}>
                      {kindMeta[fam.morphKind]?.label ?? fam.morphKind}
                    </span>
                  </td>
                  <td class="table__nums">{widths.join(' · ')}</td>
                  <td class="table__nums">{ratio}×</td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>

    <aside class="lab__notes">
      <h2 class="lab__notes-title">Como ler</h2>
      <ul>
        <li>
          <strong>full morph</strong> — default, alt1 e alt2 compartilham a mesma estrutura de
          path; dá para interpolar as 3 larguras.
        </li>
        <li>
          <strong>alts only</strong> — o default foi desenhado com outra topologia; só alt1↔alt2
          morpham (ainda assim útil).
        </li>
        <li>
          <strong>swap only</strong> — existe alternate (ex. <code>l.alt1</code>), mas os
          contornos não batem; no browser seria troca seca, não morph.
        </li>
        <li>
          Sem alts de largura: I, X, Y e quase todo lowercase (exceto l, t) + dígitos (exceto 1,
          7).
        </li>
        <li>
          Dados: <code>src/data/blatant-width-alts.json</code>
        </li>
      </ul>
    </aside>
  </section>
</BaseLayout>

<script define:vars={{ familiesPayload: families, kindMetaPayload: kindMeta }}>
  const families = familiesPayload;
  const kindMeta = kindMetaPayload;
  const byBase = Object.fromEntries(families.map((f) => [f.base, f]));

  const grid = document.getElementById('family-grid');
  const filters = document.querySelectorAll('[data-filter]');
  const pathEl = document.getElementById('morph-path');
  const labelEl = document.getElementById('morph-label');
  const widthEl = document.getElementById('morph-width');
  const slider = document.getElementById('width-slider');
  const ticks = document.getElementById('slider-ticks');
  const btnPlay = document.getElementById('btn-play');
  const btnReset = document.getElementById('btn-reset');
  const playerSub = document.getElementById('player-sub');
  const playerPick = document.getElementById('player-pick');
  const playerChar = document.getElementById('player-char');
  const playerBase = document.getElementById('player-base');
  const playerBadge = document.getElementById('player-badge');
  const playerControls = document.getElementById('player-controls');
  const playerReadout = document.getElementById('player-readout');
  const playerEmpty = document.getElementById('player-empty');
  const playerStage = document.getElementById('player-stage');

  /** @type {{ name: string, width: number, flat: number[][], opSig: string[] }[]} */
  let masters = [];
  let playing = true;
  let raf = 0;
  let start = performance.now();
  const cycleMs = 4200;
  let selectedBase = null;

  function rebuildPath(opSig, flat) {
    let i = 0;
    let d = '';
    for (const op of opSig) {
      if (op === 'M') {
        const [x, y] = flat[i++];
        d += `M${x.toFixed(2)} ${y.toFixed(2)}`;
      } else if (op === 'L') {
        const [x, y] = flat[i++];
        d += `L${x.toFixed(2)} ${y.toFixed(2)}`;
      } else if (op === 'C') {
        const [x1, y1] = flat[i++];
        const [x2, y2] = flat[i++];
        const [x3, y3] = flat[i++];
        d += `C${x1.toFixed(2)} ${y1.toFixed(2)} ${x2.toFixed(2)} ${y2.toFixed(2)} ${x3.toFixed(2)} ${y3.toFixed(2)}`;
      } else if (op === 'Z') {
        d += 'Z';
      }
    }
    return d;
  }

  function sampleAt(t) {
    const maxT = masters.length - 1;
    const clamped = Math.min(maxT, Math.max(0, t));
    const i0 = Math.floor(clamped);
    const i1 = Math.min(maxT, i0 + 1);
    const local = clamped - i0;
    const a = masters[i0];
    const b = masters[i1];
    const flat = a.flat.map((p, idx) => [
      p[0] + (b.flat[idx][0] - p[0]) * local,
      p[1] + (b.flat[idx][1] - p[1]) * local,
    ]);
    const width = a.width + (b.width - a.width) * local;
    let name = a.name;
    if (local < 0.03) name = a.name;
    else if (local > 0.97) name = b.name;
    else name = `${a.name} → ${b.name}`;
    return { flat, width, name, opSig: a.opSig, t: clamped, maxT };
  }

  function applyT(t) {
    if (!masters.length || !pathEl) return;
    const s = sampleAt(t);
    pathEl.setAttribute('d', rebuildPath(s.opSig, s.flat));
    if (labelEl) labelEl.textContent = s.name;
    if (widthEl) widthEl.textContent = `advance ${Math.round(s.width)}`;
    if (slider) slider.value = String(Math.round((t / s.maxT) * 1000));
  }

  function tick(now) {
    if (!playing || masters.length < 2) return;
    const maxT = masters.length - 1;
    const elapsed = (now - start) % cycleMs;
    const phase = elapsed / cycleMs;
    // triangle 0 → maxT → 0
    const tri = phase < 0.5 ? phase * 2 * maxT : (1 - phase) * 2 * maxT;
    applyT(tri);
    raf = requestAnimationFrame(tick);
  }

  function selectFamily(base) {
    const fam = byBase[base];
    if (!fam || fam.morphableStages.length < 2) return;

    selectedBase = base;
    masters = fam.morphableStages.map((stage) => {
      const v = fam.variants[stage];
      return {
        name: stage,
        width: v.width,
        flat: v.flat,
        opSig: v.opSig,
      };
    });

    // UI
    document.querySelectorAll('.fam.is-selected').forEach((el) => el.classList.remove('is-selected'));
    document.querySelector(`.fam[data-base="${base}"]`)?.classList.add('is-selected');

    if (playerPick) playerPick.hidden = false;
    if (playerControls) playerControls.hidden = false;
    if (playerReadout) playerReadout.hidden = false;
    if (playerEmpty) playerEmpty.hidden = true;
    if (playerStage) playerStage.dataset.empty = 'false';
    if (playerChar) playerChar.textContent = fam.char ?? '';
    if (playerBase) playerBase.textContent = fam.base;
    if (playerBadge) {
      const m = kindMeta[fam.morphKind];
      playerBadge.textContent = m?.label ?? fam.morphKind;
      playerBadge.className = `badge badge--${m?.tone ?? 'none'}`;
    }
    if (playerSub) playerSub.textContent = mHint(fam);
    if (ticks) {
      ticks.innerHTML = fam.morphableStages
        .map((s) => `<span>${s.replace(fam.base, '').replace(/^\./, '') || 'default'}</span>`)
        .join('');
      ticks.style.justifyContent =
        fam.morphableStages.length === 2 ? 'space-between' : 'space-between';
    }

    start = performance.now();
    playing = true;
    if (btnPlay) {
      btnPlay.dataset.playing = 'true';
      btnPlay.textContent = 'Pausar';
    }
    cancelAnimationFrame(raf);
    applyT(0);
    raf = requestAnimationFrame(tick);
  }

  function mHint(fam) {
    if (fam.morphKind === 'full') return `${fam.char ?? fam.base} · morph em ${fam.morphableStages.length} estágios`;
    if (fam.morphKind === 'alts_only')
      return `${fam.char ?? fam.base} · default fora; morph só ${fam.morphableStages.join(' → ')}`;
    return fam.morphKind;
  }

  // filters
  filters.forEach((btn) => {
    btn.addEventListener('click', () => {
      filters.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      const f = btn.getAttribute('data-filter');
      grid?.querySelectorAll('.fam').forEach((card) => {
        const kind = card.getAttribute('data-kind');
        const show = f === 'all' || kind === f;
        card.hidden = !show;
      });
    });
  });

  // select
  grid?.addEventListener('click', (e) => {
    const t = e.target;
    if (!(t instanceof Element)) return;
    const btn = t.closest('[data-select]');
    if (!btn || btn.hasAttribute('disabled')) return;
    selectFamily(btn.getAttribute('data-select'));
  });

  slider?.addEventListener('input', () => {
    if (masters.length < 2) return;
    playing = false;
    if (btnPlay) {
      btnPlay.dataset.playing = 'false';
      btnPlay.textContent = 'Play';
    }
    cancelAnimationFrame(raf);
    const maxT = masters.length - 1;
    applyT((Number(slider.value) / 1000) * maxT);
  });

  btnPlay?.addEventListener('click', () => {
    if (masters.length < 2) return;
    playing = !playing;
    if (btnPlay) {
      btnPlay.dataset.playing = playing ? 'true' : 'false';
      btnPlay.textContent = playing ? 'Pausar' : 'Play';
    }
    if (playing) {
      const maxT = masters.length - 1;
      const t = (Number(slider?.value ?? 0) / 1000) * maxT;
      // place cycle near current t (approx on rising edge)
      start = performance.now() - (t / maxT / 2) * cycleMs;
      raf = requestAnimationFrame(tick);
    } else {
      cancelAnimationFrame(raf);
    }
  });

  btnReset?.addEventListener('click', () => {
    start = performance.now();
    applyT(0);
    if (playing) {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(tick);
    }
  });

  // Auto-select E (known good demo)
  if (byBase.E) selectFamily('E');
</script>

<style>
  .lab {
    width: 100%;
    max-width: var(--content-max);
    margin-inline: auto;
    padding: var(--space-10) var(--page-pad-x-sm) var(--space-12);
  }

  .lab__header {
    max-width: 42rem;
    margin-bottom: var(--space-8);
  }

  .lab__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 300;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 var(--space-4);
  }

  .lab__title {
    font-family: var(--font-display);
    font-size: clamp(28px, 4vw, 42px);
    line-height: var(--lh-tight);
    text-transform: uppercase;
    margin: 0 0 var(--space-5);
  }

  .lab__lede {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--lh-body);
    color: var(--color-text-soft);
  }

  .lab__lede code,
  .lab__notes code,
  .table code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--color-accent-alt);
  }

  .lab__links {
    margin: var(--space-5) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .lab__links a {
    color: var(--color-text-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .lab__links a:hover {
    color: var(--color-accent);
  }

  /* stats */
  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  @media (min-width: 640px) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stat {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .stat__n {
    font-family: var(--font-display);
    font-size: 28px;
    line-height: 1;
  }

  .stat__l {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .stat--full .stat__n {
    color: #5dffa8;
  }
  .stat--alts .stat__n {
    color: #ffd166;
  }
  .stat--none .stat__n {
    color: var(--color-text-muted);
  }

  /* player */
  .player {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: var(--space-7);
    margin-bottom: var(--space-8);
  }

  .player__top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-5);
    margin-bottom: var(--space-6);
  }

  .player__title {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: 300;
    color: var(--color-accent);
    margin: 0 0 var(--space-2);
  }

  .player__sub {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-soft);
  }

  .player__pick {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .player__char {
    font-family: var(--font-display);
    font-size: 32px;
    line-height: 1;
  }

  .player__base {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .player__stage {
    position: relative;
    min-height: 240px;
    display: grid;
    place-items: center;
    padding: var(--space-7) var(--space-4);
    border-radius: var(--radius-sm);
    background: #0a0a0c;
    border: 1px solid var(--color-border);
    margin-bottom: var(--space-6);
  }

  .player__stage[data-empty='true'] .player__svg {
    opacity: 0.15;
  }

  .player__svg {
    width: min(100%, 760px);
    max-height: 280px;
    color: #fff;
  }

  .player__empty {
    position: absolute;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .player__readout {
    position: absolute;
    left: var(--space-5);
    bottom: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .player__readout span:first-child {
    color: var(--color-accent);
  }

  .player__readout span:last-child {
    color: var(--color-text-muted);
  }

  .player__controls {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  @media (min-width: 640px) {
    .player__controls {
      flex-direction: row;
      align-items: flex-end;
      gap: var(--space-8);
    }
  }

  .slider {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .slider__label {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
