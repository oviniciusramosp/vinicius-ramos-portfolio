---
interface Props {
  href?: string;
  label: string;
  variant?: 'ghost' | 'solid' | 'submit';
  active?: boolean;
  type?: 'button' | 'submit';
  external?: boolean;
  class?: string;
}

const {
  href,
  label,
  variant = 'ghost',
  active = false,
  type = 'button',
  external = false,
  class: className = '',
} = Astro.props;

const Tag = href ? 'a' : 'button';
const attrs = href
  ? {
      href,
      ...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {}),
    }
  : { type };
---

<Tag
  class:list={['btn', `btn--${variant}`, active && 'is-active', className]}
  {...attrs}
>
  <span class="btn__label">{label}</span>
</Tag>

<style>
  .btn {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 34px;
    padding: 8px 16px;
    border-radius: var(--radius-btn);
    border: 1px solid transparent;
    background: transparent;
    cursor: pointer;
    transition:
      background-color var(--duration-base) var(--ease-smooth),
      border-color var(--duration-base) var(--ease-smooth),
      color var(--duration-base) var(--ease-smooth),
      transform var(--duration-fast) var(--ease-smooth);
  }

  .btn__label {
    font-family: var(--font-mono);
    font-size: var(--text-md);
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-text);
    transition: color var(--duration-base) var(--ease-smooth);
  }

  /* Ghost — Resume / Contact / LinkedIn */
  .btn--ghost {
    border-color: var(--color-border-strong);
    background: rgba(255, 255, 255, 0);
  }

  .btn--ghost:hover,
  .btn--ghost:focus-visible {
    background: var(--color-white-10);
    border-color: rgba(255, 255, 255, 0.35);
  }

  .btn--ghost.is-active {
    background: var(--color-white-10);
    border-color: rgba(255, 255, 255, 0.4);
  }

  .btn--solid,
  .btn--submit {
    background: var(--color-text);
    border-color: var(--color-text);
  }

  .btn--solid .btn__label,
  .btn--submit .btn__label {
    color: var(--color-bg);
  }

  .btn--solid:hover,
  .btn--solid:focus-visible,
  .btn--submit:hover,
  .btn--submit:focus-visible {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .btn--solid:hover .btn__label,
  .btn--solid:focus-visible .btn__label,
  .btn--submit:hover .btn__label,
  .btn--submit:focus-visible .btn__label {
    color: var(--color-text);
  }

  .btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>
