---
import { site } from '../data/site';
import Button from './Button.astro';
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <Button href={site.social.linkedin} label="linkedin" external />
    <p class="site-footer__note" data-cursor="block">
      made with
      <span class="site-footer__heart" aria-hidden="true">
        <ion-icon name="heart"></ion-icon>
      </span>
      in Brazil
    </p>
  </div>
</footer>

<style>
  /*
   * Live Framer footer (all pages):
   *   desktop  width 1200 · padding 72px 250px 24px
   *   tablet   padding 48px 64px 24px   (≈810–1193)
   *   mobile   padding 32px 16px 24px   (≤809)
   * Same frame as nav (--content-max), not the 1920 shell.
   */
  .site-footer {
    width: 100%;
    -webkit-user-select: none;
    user-select: none;
  }

  .site-footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-7); /* 20px — live gap */
    flex-wrap: wrap;
    width: 100%;
    max-width: var(--content-max);
    margin-inline: auto;
    padding: 72px 250px 24px;
    box-sizing: border-box;
  }

  .site-footer a,
  .site-footer button {
    -webkit-user-select: none;
    user-select: none;
  }

  .site-footer__note {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    cursor: none;
    -webkit-user-select: none;
    user-select: none;
    transition: color 0.2s ease;
  }

  /* Wrapper: ion-icon uses contain:paint, so scale must live on a parent */
  .site-footer__heart {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-inline: 0.2em;
    font-size: 1.15em;
    line-height: 1;
    color: currentColor;
    transform-origin: center center;
    transition: color 0.2s ease;
  }

  .site-footer__heart ion-icon {
    display: block;
    width: 1em;
    height: 1em;
    pointer-events: none;
  }

  /* Hover anywhere on the label → green text + yellow pulsing heart */
  .site-footer__note:hover {
    color: #009c3b; /* Brazil flag green */
  }

  .site-footer__note:hover .site-footer__heart {
    color: #ffdf00; /* Brazil flag yellow */
    /* lub-dub: two quick beats, then rest */
    animation: heart-pulse 1.1s ease-in-out infinite;
  }

  @keyframes heart-pulse {
    0% {
      transform: scale(1);
    }
    12% {
      transform: scale(1.32);
    }
    24% {
      transform: scale(1);
    }
    36% {
      transform: scale(1.22);
    }
    50% {
      transform: scale(1);
    }
    100% {
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer__note:hover .site-footer__heart {
      animation: none;
      transform: scale(1.1);
    }
  }

  /* Tablet — live Framer v-1lbs7qo */
  @media (max-width: 1193px) {
    .site-footer__inner {
      padding: 48px 64px 24px;
    }
  }

  /* Mobile — live Framer v-1vx248r */
  @media (max-width: 809px) {
    .site-footer__inner {
      padding: 32px 16px 24px;
    }
  }
</style>
