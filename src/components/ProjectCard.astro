---
import type { Project } from '../data/projects';
import Tag from './Tag.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const isLink = Boolean(project.href) && !project.soon;
const TagEl = isLink ? 'a' : 'div';
const attrs = isLink ? { href: project.href } : {};
---

<!--
  Layers (depth, front → back):
  1. content (title/tags) — appears on hover, strongest parallax
  2. scrim (dark + blur)
  3. image — “far” layer, scales down on hover

  Shell: magnetic withOffset (range 3) + card multi-layer parallax
-->
<div
  class="project-card-shell"
  data-magnetic
  data-magnetic-range="3"
  data-card-parallax
  data-cursor="block"
>
  <TagEl
    class:list={[
      'project-card',
      `project-card--${project.size}`,
      project.soon && 'is-soon',
    ]}
    data-magnetic-visual
    {...attrs}
    aria-label={`${project.title}${project.soon ? ' (coming soon)' : ''}`}
  >
    <!-- Back layer: image -->
    <div class="project-card__media" data-parallax-depth="back">
      <img
        class="project-card__image"
        src={project.cover}
        alt=""
        loading="lazy"
        decoding="async"
      />
    </div>

    <!-- Mid: dark scrim + blur (live Backdrop + Blur) -->
    <div class="project-card__scrim" aria-hidden="true"></div>

    <!-- Front: title + tags — hidden until hover -->
    <div class="project-card__content" data-parallax-depth="front">
      <h2 class="project-card__title">{project.title}</h2>
      <div class="project-card__tags">
        {project.tags.map((tag) => <Tag label={tag} />)}
        {project.soon && <Tag label="SOON" tone="accent" />}
      </div>
    </div>
  </TagEl>
</div>

<style>
  .project-card-shell {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .project-card {
    --card-ease: cubic-bezier(0.44, 0, 0.56, 1);
    --card-dur: 420ms;
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    min-height: 220px;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-surface);
    color: var(--color-text);
    isolation: isolate;
    cursor: default;
    will-change: transform;
  }

  a.project-card {
    cursor: pointer;
  }

  .project-card--lg,
  .project-card--tall {
    min-height: 448px;
  }

  .project-card--wide,
  .project-card--sm,
  .project-card--md {
    min-height: 220px;
  }

  /* —— Back: image —— */
  .project-card__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    border-radius: inherit;
    will-change: transform;
    transition: transform var(--card-dur) var(--card-ease);
  }

  .project-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Rest: slightly large (live ~1.02). Hover: push “back” to ~0.8 */
    transform: scale(1.02);
    filter: saturate(1);
    transition:
      transform var(--card-dur) var(--card-ease),
      filter var(--card-dur) var(--card-ease);
  }

  /* —— Mid: scrim —— */
  .project-card__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(0px);
    -webkit-backdrop-filter: blur(0px);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity var(--card-dur) var(--card-ease),
      backdrop-filter var(--card-dur) var(--card-ease),
      -webkit-backdrop-filter var(--card-dur) var(--card-ease);
  }

  /* —— Front: title + tags (hidden at rest) ——
     Opacity via CSS; translate via card-parallax (no transform conflict) */
  .project-card__content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-4);
    padding: 24px;
    opacity: 0;
    pointer-events: none;
    will-change: transform, opacity;
    transition: opacity var(--card-dur) var(--card-ease);
  }

  .project-card__title {
    font-family: var(--font-display);
    font-size: clamp(20px, 2.2vw, var(--text-xl));
    font-weight: 400;
    line-height: 1;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* —— Hover / focus / magnetic active —— */
  .project-card-shell:hover .project-card__content,
  .project-card-shell:focus-within .project-card__content,
  .project-card-shell.is-magnetic .project-card__content {
    opacity: 1;
  }

  .project-card-shell:hover .project-card__scrim,
  .project-card-shell:focus-within .project-card__scrim,
  .project-card-shell.is-magnetic .project-card__scrim {
    opacity: 1;
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .project-card-shell:hover .project-card__image,
  .project-card-shell:focus-within .project-card__image,
  .project-card-shell.is-magnetic .project-card__image {
    /* Live ImageBg: scale ~0.8 + saturate */
    transform: scale(0.82);
    filter: saturate(1.56);
  }

  .project-card.is-soon {
    cursor: default;
  }

  .project-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  @media (max-width: 768px) {
    .project-card,
    .project-card--lg,
    .project-card--tall,
    .project-card--wide,
    .project-card--sm,
    .project-card--md {
      min-height: 260px;
    }

    /* Touch: keep content visible (no hover) */
    .project-card__content {
      opacity: 1;
      transform: none;
    }

    .project-card__scrim {
      opacity: 0.55;
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }

    .project-card__image {
      transform: scale(1);
      filter: saturate(1.15);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-card__media,
    .project-card__image,
    .project-card__scrim,
    .project-card__content {
      transition: none;
      will-change: auto;
    }
  }
</style>
