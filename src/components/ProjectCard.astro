---
import fs from 'node:fs';
import path from 'node:path';
import type { Project } from '../data/projects';
import Tag from './Tag.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const isLink = Boolean(project.href) && !project.soon;
const TagEl = isLink ? 'a' : 'div';
const attrs = isLink ? { href: project.href } : {};
const fit = project.imageFit ?? 'cover';
const hasFront = Boolean(project.coverFront);
const animateCoverLines = project.coverAnimate === 'draw-lines';
const animateFrontLines =
  project.coverFrontAnimate === 'draw-lines' && Boolean(project.coverFront);

/** Read public SVG at build/SSR time for reliable inlining (no client fetch race). */
function readPublicSvg(publicPath: string | undefined): string | undefined {
  if (!publicPath?.startsWith('/') || !publicPath.endsWith('.svg')) return undefined;
  try {
    const file = path.join(process.cwd(), 'public', publicPath.replace(/^\//, ''));
    return fs.readFileSync(file, 'utf8');
  } catch {
    return undefined;
  }
}

const coverSvgInline = animateCoverLines ? readPublicSvg(project.cover) : undefined;
const frontSvgInline = animateFrontLines ? readPublicSvg(project.coverFront) : undefined;

const tagList = [
  // SOON first on mobile (desktop hides it — cursor pill handles that)
  ...(project.soon ? [{ label: 'SOON', tone: 'soon' as const }] : []),
  ...project.tags.map((label) => ({ label, tone: 'default' as const })),
];
---

<div
  class:list={['project-card-shell', project.soon && 'is-soon']}
  data-magnetic
  data-magnetic-range="3"
  data-card-parallax
  data-card-reveal
  data-cursor={project.soon ? 'soon' : 'block'}
>
  <TagEl
    class:list={[
      'project-card',
      `project-card--${project.size}`,
      `project-card--fit-${fit}`,
      `project-card--slug-${project.slug}`,
      hasFront && 'has-dual-image',
      project.soon && 'is-soon',
    ]}
    data-magnetic-visual
    {...attrs}
    aria-label={`${project.title}${project.soon ? ' (coming soon)' : ''}`}
  >
    <div class="project-card__media-stack" aria-hidden="true">
      <div
        class="project-card__layer project-card__layer--back"
        data-parallax-depth="img-back"
      >
        {
          animateCoverLines ? (
            <div
              class="project-card__image project-card__image--svg"
              data-cover-lines
              data-src={project.cover}
              set:html={coverSvgInline ?? ''}
            />
          ) : (
            <img
              class="project-card__image"
              src={project.cover}
              alt=""
              loading="lazy"
              decoding="async"
            />
          )
        }
      </div>
      {
        project.coverFront && (
          <div
            class="project-card__layer project-card__layer--mid"
            data-parallax-depth="img-mid"
          >
            {
              animateFrontLines ? (
                <div
                  class="project-card__image project-card__image--svg"
                  data-cover-lines
                  data-src={project.coverFront}
                  set:html={frontSvgInline ?? ''}
                />
              ) : (
                <img
                  class="project-card__image"
                  src={project.coverFront}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              )
            }
          </div>
        )
      }
    </div>

    <div class="project-card__scrim" aria-hidden="true"></div>

    <!--
      Parallax layer fills the card.
      Inner stack is ONLY as tall as the title and is grid-centered,
      so the title is always the true visual center.
      Tags are position:absolute under the title (out of flow).
    -->
    <div class="project-card__content" data-parallax-depth="front">
      <div class="project-card__stack">
        <h2 class="project-card__title">{project.title}</h2>
        <div class="project-card__tags">
          {
            tagList.map((tag, i) => (
              <span
                class:list={[
                  'project-card__tag-item',
                  tag.tone === 'soon' && 'project-card__tag-item--soon',
                ]}
                style={`--delay: ${80 + i * 70}ms`}
              >
                <Tag label={tag.label} tone={tag.tone} variant="reveal" />
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </TagEl>
</div>

<style>
  .project-card-shell {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .project-card {
    --card-ease: cubic-bezier(0.44, 0, 0.56, 1);
    --card-dur: 0.42s;
    --tag-stagger: 0.07s;
    --img-scale: 1.18;
    --img-scale-hover-back: 1.24;
    --img-scale-hover-mid: 1.22;
    /* Inlined SVG covers — default slightly larger than raster */
    --img-scale-svg: 1.42;
    --img-scale-svg-hover: 1.48;
    /*
     * Scroll-reveal image parallax — desktop / multi-col (default): soft + slow.
     * Ease-out only. Enter = rest − delta × travel.
     * --reveal-travel is inverse to cell footprint so large cards don’t “pop”
     * more than small ones (absolute motion stays comparable).
     */
    --reveal-ease: cubic-bezier(0.16, 1, 0.3, 1); /* ease-out */
    --reveal-img-dur-back: 2.2s;
    --reveal-img-dur-mid: 1.7s;
    --reveal-travel: 1;
    --reveal-delta-back: 0.01;
    --reveal-delta-mid: 0.015;
    --img-scale-enter-back: calc(
      var(--img-scale) - var(--reveal-delta-back) * var(--reveal-travel)
    );
    --img-scale-enter-mid: calc(
      var(--img-scale) - var(--reveal-delta-mid) * var(--reveal-travel)
    );
    --img-scale-svg-enter-back: calc(
      var(--img-scale-svg) - var(--reveal-delta-back) * var(--reveal-travel)
    );
    --img-scale-svg-enter-mid: calc(
      var(--img-scale-svg) - var(--reveal-delta-mid) * var(--reveal-travel)
    );
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-surface);
    color: var(--color-text);
    isolation: isolate;
    cursor: default;
    will-change: transform;
  }

  a.project-card {
    cursor: pointer;
  }

  /*
   * Travel ∝ 1 / √(col×row) so pixel motion stays similar across sizes.
   * 1×1 → 1 · 2×1/1×2 → ~0.71 · 2×2 → 0.5 · 2×3 → ~0.41
   */
  .project-card--sm,
  .project-card--md {
    --reveal-travel: 1;
  }

  .project-card--wide,
  .project-card--tall {
    --reveal-travel: 0.71;
  }

  .project-card--lg {
    --reveal-travel: 0.5;
  }

  .project-card--xl {
    --reveal-travel: 0.41;
  }

  /* —— Images —— */
  .project-card__media-stack {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: grid;
    grid-template: 1fr / 1fr;
    border-radius: inherit;
    overflow: hidden;
    pointer-events: none;
  }

  .project-card__layer {
    grid-area: 1 / 1;
    position: relative;
    width: 100%;
    height: 100%;
    overflow: visible;
    will-change: transform;
  }

  .project-card__layer--back {
    z-index: 0;
  }
  .project-card__layer--mid {
    z-index: 1;
  }

  .project-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(var(--img-scale));
    transform-origin: center;
    transition: transform var(--card-dur) var(--card-ease);
    display: block;
  }

  /*
   * Contain: product cutouts / logos keep aspect (no stretch).
   * Defaults are mobile-safe; desktop bumps scale via min-width media.
   * Per-slug overrides (moove / booking) tune crop-sensitive assets.
   */
  .project-card--fit-contain {
    --img-scale: 1.05;
    --img-scale-hover-back: 1.1;
    --img-scale-hover-mid: 1.08;
    --img-scale-svg: 0.9;
    --img-scale-svg-hover: 0.94;
  }

  .project-card--fit-contain .project-card__image {
    object-fit: contain;
    object-position: center;
  }

  .project-card--fit-contain .project-card__image--svg :global(svg) {
    object-fit: contain;
  }

  /* —— Moove: wide logo mark — never clip sides on narrow mobile cells —— */
  .project-card--slug-moove {
    --img-scale-svg: 0.82;
    --img-scale-svg-hover: 0.86;
  }

  /*
   * Booking: full mock visible (contain @ scale 1), sit on the card floor.
   * No inset overscan — that was blowing layout and cropping the phone.
   * Parallax Y is dampened in card-parallax.ts for fit-contain so edges stay covered.
   */
  /* Booking default = mobile: full mock @ contain, no extra zoom */
  .project-card--slug-booking {
    --img-scale: 1;
    --img-scale-hover-back: 1.03;
    --img-scale-hover-mid: 1.02;
  }

  .project-card--slug-booking .project-card__image {
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
    transform-origin: center bottom;
  }

  /* Desktop / multi-col: roomier cells → fuller scale (mobile stays conservative) */
  @media (min-width: 769px) {
    .project-card--fit-contain {
      --img-scale: 1.14;
      --img-scale-hover-back: 1.2;
      --img-scale-hover-mid: 1.18;
      --img-scale-svg: 1.22;
      --img-scale-svg-hover: 1.28;
    }

    /* Wide bento cell — logo can breathe larger without side clip */
    .project-card--slug-moove {
      --img-scale-svg: 1.28;
      --img-scale-svg-hover: 1.34;
    }

    /* Booking desktop only: ~20% larger than contain fit */
    .project-card--slug-booking {
      --img-scale: 1.2;
      --img-scale-hover-back: 1.24;
      --img-scale-hover-mid: 1.23;
    }
  }

  /* Phone single-column: Moove full-width — keep mark fully inside */
  @media (max-width: 768px) {
    .project-card--slug-moove {
      --img-scale-svg: 0.78;
      --img-scale-svg-hover: 0.82;
    }

    .project-card--slug-booking {
      --img-scale: 1;
      --img-scale-hover-back: 1.03;
      --img-scale-hover-mid: 1.02;
    }
  }

  /*
   * Inlined cover SVG (mark + construction lines).
   * Slightly larger base scale than raster covers (logo was reading small).
   */
  .project-card__image--svg {
    display: block;
    pointer-events: none;
    transform: scale(var(--img-scale-svg));
  }

  .project-card-shell:hover .project-card__layer--back .project-card__image--svg,
  .project-card-shell:focus-within .project-card__layer--back .project-card__image--svg,
  .project-card-shell.is-magnetic .project-card__layer--back .project-card__image--svg,
  .project-card-shell:hover .project-card__layer--mid .project-card__image--svg,
  .project-card-shell:focus-within .project-card__layer--mid .project-card__image--svg,
  .project-card-shell.is-magnetic .project-card__layer--mid .project-card__image--svg {
    transform: scale(var(--img-scale-svg-hover));
  }

  .project-card__image--svg :global(svg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
  }

  /*
   * Construction-line draw (cover-lines.ts sets --cover-line-len / delay).
   * Transition lives in CSS so hover reliably animates dashoffset.
   */
  .project-card__image--svg :global(.cover-line) {
    fill: none !important;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: stroke-dashoffset 0.85s cubic-bezier(0.44, 0, 0.56, 1)
      var(--cover-line-delay, 0ms);
    will-change: stroke-dashoffset;
  }

  .project-card__image--svg.is-drawn :global(.cover-line) {
    /* dashoffset set to 0 by JS; class gates the “drawn” state */
  }

  .project-card__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.12) 0%,
      rgba(0, 0, 0, 0.4) 100%
    );
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--card-dur) var(--card-ease);
  }

  /*
   * Content fills the card and centers the STACK (title only in-flow).
   * Parallax translate is applied to this node — layout stays centered.
   */
  .project-card__content {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: grid;
    place-items: center;
    pointer-events: none;
    will-change: transform;
  }

  /* Only as tall as the title → place-items:center puts title at true center */
  .project-card__stack {
    position: relative;
    display: block;
    width: max-content;
    max-width: min(100%, 90vw);
  }

  .project-card__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(20px, 2.2vw, var(--text-xl));
    font-weight: 400;
    line-height: 1;
    text-transform: uppercase;
    color: #fff;
    text-align: center;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(10px);
    /* Soft contrast halo — high blur, low opacity */
    text-shadow:
      0 0 24px rgba(0, 0, 0, 0.35),
      0 0 48px rgba(0, 0, 0, 0.2);
    transition:
      opacity var(--card-dur) var(--card-ease),
      transform var(--card-dur) var(--card-ease);
  }

  /*
   * Tags hang under the title (absolute → no layout shift).
   * Stack is position:relative so this anchors to the title box.
   */
  .project-card__tags {
    position: absolute;
    top: 100%;
    left: 50%;
    margin-top: 14px;
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: max-content;
    transform: translateX(-50%);
    z-index: 2;
  }

  /* Desktop / tablet: never show SOON badge (cursor pill handles it) */
  .project-card__tag-item--soon {
    display: none !important;
  }

  /* No opacity on tags — “fade” is color on .tag; only slide here */
  .project-card__tag-item {
    display: inline-flex;
    flex-shrink: 0;
    transform: translateY(12px);
    transition: transform 0.38s var(--card-ease);
    transition-delay: 0s;
  }

  /* Stagger color/blur transitions on the tag itself */
  .project-card__tag-item :global(.tag),
  .project-card__tag-item :global(.tag__glass) {
    transition-delay: 0s;
  }

  /* —— Active state (hover OR magnetic) —— */
  .project-card-shell:hover .project-card__scrim,
  .project-card-shell:focus-within .project-card__scrim,
  .project-card-shell.is-magnetic .project-card__scrim {
    opacity: 1;
  }

  .project-card-shell:hover .project-card__layer--back .project-card__image,
  .project-card-shell:focus-within .project-card__layer--back .project-card__image,
  .project-card-shell.is-magnetic .project-card__layer--back .project-card__image {
    transform: scale(var(--img-scale-hover-back));
  }

  .project-card-shell:hover .project-card__layer--mid .project-card__image,
  .project-card-shell:focus-within .project-card__layer--mid .project-card__image,
  .project-card-shell.is-magnetic .project-card__layer--mid .project-card__image {
    transform: scale(var(--img-scale-hover-mid));
  }

  .project-card-shell:hover .project-card__title,
  .project-card-shell:focus-within .project-card__title,
  .project-card-shell.is-magnetic .project-card__title {
    opacity: 1;
    transform: translateY(0);
  }

  .project-card-shell:hover .project-card__tag-item,
  .project-card-shell:focus-within .project-card__tag-item,
  .project-card-shell.is-magnetic .project-card__tag-item {
    transform: translateY(0);
    transition-delay: var(--delay, 80ms);
  }

  .project-card-shell:hover .project-card__tag-item :global(.tag),
  .project-card-shell:focus-within .project-card__tag-item :global(.tag),
  .project-card-shell.is-magnetic .project-card__tag-item :global(.tag),
  .project-card-shell:hover .project-card__tag-item :global(.tag__glass),
  .project-card-shell:focus-within .project-card__tag-item :global(.tag__glass),
  .project-card-shell.is-magnetic .project-card__tag-item :global(.tag__glass) {
    transition-delay: var(--delay, 80ms);
  }

  .project-card.is-soon {
    cursor: default;
  }

  .project-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  /*
   * Scroll-reveal · dual-layer scale-up (all viewports).
   * Each layer has its own duration + enter scale so depth reads as parallax.
   * Armed only when JS sets [data-card-reveal-ready]; settles on .is-inview.
   */
  .project-card-shell[data-card-reveal-ready] .project-card__layer--back .project-card__image {
    transform: scale(var(--img-scale-enter-back));
    transition: transform var(--reveal-img-dur-back) var(--reveal-ease);
  }

  .project-card-shell[data-card-reveal-ready] .project-card__layer--mid .project-card__image {
    transform: scale(var(--img-scale-enter-mid));
    transition: transform var(--reveal-img-dur-mid) var(--reveal-ease);
  }

  .project-card-shell[data-card-reveal-ready] .project-card__layer--back .project-card__image--svg {
    transform: scale(var(--img-scale-svg-enter-back));
    transition: transform var(--reveal-img-dur-back) var(--reveal-ease);
  }

  .project-card-shell[data-card-reveal-ready] .project-card__layer--mid .project-card__image--svg {
    transform: scale(var(--img-scale-svg-enter-mid));
    transition: transform var(--reveal-img-dur-mid) var(--reveal-ease);
  }

  .project-card-shell.is-inview .project-card__layer--back .project-card__image,
  .project-card-shell.is-inview .project-card__layer--mid .project-card__image {
    transform: scale(var(--img-scale));
  }

  .project-card-shell.is-inview .project-card__layer--back .project-card__image--svg,
  .project-card-shell.is-inview .project-card__layer--mid .project-card__image--svg {
    transform: scale(var(--img-scale-svg));
  }

  /* After settle, hover/magnetic still boost (desktop) — snappy card-dur */
  .project-card-shell.is-inview:hover .project-card__layer--back .project-card__image,
  .project-card-shell.is-inview:focus-within .project-card__layer--back .project-card__image,
  .project-card-shell.is-inview.is-magnetic .project-card__layer--back .project-card__image {
    transform: scale(var(--img-scale-hover-back));
    transition-duration: var(--card-dur);
    transition-timing-function: var(--card-ease);
  }

  .project-card-shell.is-inview:hover .project-card__layer--mid .project-card__image,
  .project-card-shell.is-inview:focus-within .project-card__layer--mid .project-card__image,
  .project-card-shell.is-inview.is-magnetic .project-card__layer--mid .project-card__image {
    transform: scale(var(--img-scale-hover-mid));
    transition-duration: var(--card-dur);
    transition-timing-function: var(--card-ease);
  }

  .project-card-shell.is-inview:hover .project-card__layer--back .project-card__image--svg,
  .project-card-shell.is-inview:focus-within .project-card__layer--back .project-card__image--svg,
  .project-card-shell.is-inview.is-magnetic .project-card__layer--back .project-card__image--svg,
  .project-card-shell.is-inview:hover .project-card__layer--mid .project-card__image--svg,
  .project-card-shell.is-inview:focus-within .project-card__layer--mid .project-card__image--svg,
  .project-card-shell.is-inview.is-magnetic .project-card__layer--mid .project-card__image--svg {
    transform: scale(var(--img-scale-svg-hover));
    transition-duration: var(--card-dur);
    transition-timing-function: var(--card-ease);
  }

  /*
   * Mobile: title + tags always on, bottom-left.
   * Soft radial scrim. Stronger / snappier layer parallax than desktop.
   */
  @media (max-width: 768px) {
    .project-card {
      /*
       * Stronger enter deltas; equal card height on mobile so travel = 1
       * (still uses size class if we ever reintroduce multi-span mobile).
       */
      --reveal-travel: 1;
      --reveal-delta-back: 0.1;
      --reveal-delta-mid: 0.2;
      --reveal-img-dur-back: 1.2s;
      --reveal-img-dur-mid: 0.72s;
      --reveal-title-dur: 0.55s;
      --reveal-scrim-dur: 1s;
      --scrim-opacity-enter: 1;
      --scrim-opacity-rest: 0.72;
    }

    .project-card__content {
      place-items: end start;
      align-content: end;
      padding: 20px 16px 16px;
    }

    .project-card__stack {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      width: 100%;
      max-width: 100%;
    }

    .project-card__title {
      text-align: left;
      font-size: clamp(22px, 6.2vw, 28px);
      white-space: normal;
      /* Hidden only while scroll-reveal is armed (data-card-reveal-ready) */
      opacity: 0;
      transform: translateY(14px);
      transition:
        opacity var(--reveal-title-dur) var(--reveal-ease),
        transform var(--reveal-title-dur) var(--reveal-ease);
      transition-delay: 0s;
    }

    /* No-JS / pre-init: keep copy + image at rest */
    .project-card-shell:not([data-card-reveal-ready]) .project-card__title,
    .project-card-shell:not([data-card-reveal-ready]) .project-card__tag-item {
      opacity: 1;
      transform: none;
    }

    .project-card-shell:not([data-card-reveal-ready]) .project-card__image {
      transform: scale(var(--img-scale));
    }

    .project-card-shell:not([data-card-reveal-ready]) .project-card__image--svg {
      transform: scale(var(--img-scale-svg));
    }

    .project-card-shell:not([data-card-reveal-ready]) .project-card__scrim {
      opacity: var(--scrim-opacity-rest);
    }

    .project-card__tags {
      position: static;
      top: auto;
      left: auto;
      margin-top: 10px;
      transform: none;
      justify-content: flex-start;
      flex-wrap: wrap;
      gap: 6px;
      width: auto;
      max-width: 100%;
    }

    .project-card__tag-item {
      opacity: 0;
      transform: translateY(10px);
      transition:
        opacity 0.45s var(--reveal-ease),
        transform 0.45s var(--reveal-ease);
      transition-delay: 0s;
    }

    /* Slightly smaller pills on mobile */
    .project-card__tag-item :global(.tag) {
      padding: 4px 9px;
    }

    .project-card__tag-item :global(.tag__label) {
      font-size: 10px;
      letter-spacing: 0.8px;
    }

    .project-card__tag-item :global(.tag),
    .project-card__tag-item :global(.tag__glass) {
      transition:
        color 0.38s var(--card-ease),
        border-color 0.38s var(--card-ease),
        background-color 0.38s var(--card-ease),
        backdrop-filter 0.38s var(--card-ease),
        -webkit-backdrop-filter 0.38s var(--card-ease);
      transition-delay: 0s;
    }

    /*
