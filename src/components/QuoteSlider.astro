---
/**
 * Quote carousel — same chrome as DeckSlider (wireframes):
 * full-bleed track · side peeks · fades · arrows · Apple AAP dots/play.
 *
 * Card layout:
 *   [role          ] [avatar?]
 *   [name · Blatant] [avatar?]
 *   ─────────────────────────
 *   quote body
 */
import type { ProjectQuote } from '../data/projects';
import { preventOrphans } from '../utils/prevent-orphans';
import OptimizedImg from './OptimizedImg.astro';
import '../styles/aap-media-card-gallery.css';

interface Props {
  quotes: ProjectQuote[];
  ariaLabel?: string;
  autoplay?: boolean;
  /** Apple --autoplay-persist-duration ≈ 6150ms */
  interval?: number;
  loop?: boolean;
  class?: string;
}

const {
  quotes,
  ariaLabel = 'Testimonials',
  autoplay = true,
  interval = 6150,
  loop = true,
  class: className = '',
} = Astro.props;

const displayQuotes = quotes.map((q) => ({
  ...q,
  role: preventOrphans(q.role),
  author: preventOrphans(q.author),
  text: preventOrphans(q.text),
}));
---

{
  quotes.length > 0 && (
    <div class:list={['quote-slider-shell', className]}>
      <div
        class="quote-slider aap-root"
        data-deck-slider
        data-media-card-gallery
        data-deck-autoplay={autoplay ? 'true' : 'false'}
        data-deck-interval={String(interval)}
        data-deck-loop={loop ? 'true' : 'false'}
        role="region"
        aria-roledescription="carousel"
        aria-label={ariaLabel}
        style={`--autoplay-persist-duration: ${interval}ms; --animation-duration: ${interval}ms; --autoplay-progress: 0;`}
      >
        <div class="quote-slider__fade quote-slider__fade--left" aria-hidden="true" />
        <div class="quote-slider__fade quote-slider__fade--right" aria-hidden="true" />

        <div class="quote-slider__viewport" data-deck-viewport tabindex="0">
          <div class="quote-slider__track">
            {displayQuotes.map((quote, i) => (
              <article
                class="quote-card"
                data-deck
                data-deck-index={String(i)}
              >
                <header class="quote-card__header">
                  <div class="quote-card__identity">
                    <span class="quote-card__role">{quote.role}</span>
                    <strong class="quote-card__author">{quote.author}</strong>
                  </div>
                  {quote.avatar && (
                    <OptimizedImg
                      class="quote-card__avatar"
                      src={quote.avatar}
                      alt={quote.author}
                      preset="avatar"
                      width={48}
                      height={48}
                      loading="lazy"
                      draggable="false"
                      objectFit="cover"
                    />
                  )}
                </header>
                <div class="quote-card__divider" aria-hidden="true" />
                <p class="quote-card__text">{quote.text}</p>
              </article>
            ))}
          </div>
        </div>

        <div class="quote-slider__arrows">
          <button
            type="button"
            class="quote-slider__arrow"
            data-deck-prev
            data-magnetic
            data-cursor="block"
            aria-label="Previous"
          >
            <span class="quote-slider__arrow-visual" data-magnetic-visual>
              <svg width="40" height="40" viewBox="0 0 40 40" aria-hidden="true">
                <path
                  fill="none"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M22.5 12.5 15 20l7.5 7.5"
                />
              </svg>
            </span>
          </button>
          <button
            type="button"
            class="quote-slider__arrow"
            data-deck-next
            data-magnetic
            data-cursor="block"
            aria-label="Next"
          >
            <span class="quote-slider__arrow-visual" data-magnetic-visual>
              <svg width="40" height="40" viewBox="0 0 40 40" aria-hidden="true">
                <path
                  fill="none"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17.5 12.5 25 20l-7.5 7.5"
                />
              </svg>
            </span>
          </button>
        </div>

        {/*
          Apple structure (same as DeckSlider / #aap-media-card-gallery):
          container >
            .all-access-pass.aap-media-card-gallery
              .all-access-pass__intro-element
              .play-pause-button-wrapper  (order:2 → right)
              .aap-media-card-gallery__timed-dotnav  (dots left)
        */}
        <div class="all-access-pass__container">
          <div
            class="all-access-pass aap-media-card-gallery inactive"
            data-deck-aap
            data-aap-name="highlights-gallery"
            data-component-list="MediaCardGalleryControl"
          >
            <div class="all-access-pass__intro-element" aria-hidden="true"></div>

            <div class="all-access-pass__element play-pause-button-wrapper">
              <span class="all-access-pass__background" aria-hidden="true"></span>
              <button
                type="button"
                class="play-pause-button all-access-pass__play-pause-button aap-media-card-gallery__button"
                data-deck-play
                data-magnetic
                data-cursor="block"
                aria-label="Play testimonials"
              >
                <span class="play-pause-button__visual" data-magnetic-visual>
                  <span class="icons">
                    <svg
                      class="icon-control svg-icon play-icon"
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 56 56"
                      aria-hidden="true"
                    >
                      <path
                        d="m23.7555 36.6237c.4478 0 .8598-.1343 1.4241-.4568l10.9178-6.3322c.8598-.5016 1.3614-1.021 1.3614-1.8361 0-.8061-.5016-1.3255-1.3614-1.8271l-10.9178-6.3322c-.5643-.3314-.9762-.4657-1.4241-.4657-.9315 0-1.7555.7165-1.7555 1.9435v13.3629c0 1.227.824 1.9435 1.7555 1.9435z"
                      ></path>
                    </svg>
                    <svg
                      class="icon-control svg-icon pause-icon"
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 56 56"
                      aria-hidden="true"
                    >
                      <path
                        d="m21.7334 36.67h2.5342c1.1483 0 1.7324-.5796 1.7324-1.7193v-13.9015c0-1.12-.5841-1.6898-1.7324-1.7193h-2.5342c-1.1483 0-1.7324.5698-1.7324 1.7193v13.9015c-.0297 1.1396.5544 1.7193 1.7324 1.7193zm9.9992 0h2.5347c1.1485 0 1.7327-.5796 1.7327-1.7193v-13.9015c0-1.12-.5842-1.7193-1.7327-1.7193h-2.5347c-1.1485 0-1.7327.5698-1.7327 1.7193v13.9015c0 1.1396.5545 1.7193 1.7327 1.7193z"
                      ></path>
                    </svg>
                    <svg
                      class="icon-control svg-icon replay-icon"
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 56 56"
                      aria-hidden="true"
                    >
                      <path
                        d="m36.2448 26.6447c-1.1073 0-2.0052.8978-2.0052 2.0052 0 3.4405-2.7992 6.2397-6.2397 6.2397s-6.2397-2.7992-6.2397-6.2397 2.7992-6.2397 6.2397-6.2397c.0283 0 .0546-.0072.0825-.0083l-1.2839 1.2841c-.7833.7828-.7833 2.0526 0 2.8354.3911.3916.9047.5874 1.4177.5874s1.0266-.1958 1.4177-.5874l4.4406-4.4406c.7833-.7828.7833-2.0526 0-2.8354l-4.657-4.657c-.7823-.7833-2.0531-.7833-2.8354 0-.7833.7828-.7833 2.0526 0 2.8354l.9973.9974c-5.4561.223-9.8295 4.7189-9.8295 10.2287 0 5.6517 4.5983 10.25 10.25 10.25s10.25-4.5983 10.25-10.25c0-1.1073-.8978-2.0052-2.0052-2.0052z"
                      ></path>
                    </svg>
                  </span>
                </span>
              </button>
            </div>

            <div class="all-access-pass__element aap-media-card-gallery__timed-dotnav">
              <span class="all-access-pass__background" aria-hidden="true"></span>
              <div class="tablist-wrapper">
                <div class="dotnav">
                  <ul
                    role="tablist"
                    aria-label={`${ariaLabel} tablist`}
                    class="dotnav-items"
                    style={`--dotnav-count: ${quotes.length}`}
                  >
                    {quotes.map((quote, i) => (
                      <li
                        role="presentation"
                        class:list={[
                          'dotnav-item',
                          'aap-media-card-gallery__dotnav-item',
                          i === 0 && 'current',
                        ]}
                        style={`--item-index: ${i}`}
                      >
                        <button
                          type="button"
                          class:list={['dotnav-link', i === 0 && 'current']}
                          data-deck-dot={String(i)}
                          role="tab"
                          aria-label={`Quote by ${quote.author}`}
                          aria-current={i === 0 ? 'true' : 'false'}
                          style={`--item-index: ${i}`}
                        >
                          <span class="visuallyhidden">{quote.author}</span>
                        </button>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  )
}

<style>
  /*
   * Shell mirrors DeckSlider: full-bleed peeks, content inset via --pad-x.
   * Card measure is fixed 600px (live quote containers), not full content column.
   */
  .quote-slider-shell {
    width: 100%;
    max-width: 100%;
    padding: 0;
    margin-inline: auto;
    container-type: inline-size;
    container-name: quote-slider;
    --pad-x: 16px;
    --quote-width: min(600px, calc(100cqi - 2 * var(--pad-x)));
  }

  @media (min-width: 810px) {
    .quote-slider-shell {
      --pad-x: 64px;
    }
  }

  @media (min-width: 1194px) {
    .quote-slider-shell {
      /* live SectionQuotes desktop pad ≈ 220–250 */
      --pad-x: 220px;
    }
  }

  @media (min-width: 1536px) {
    .quote-slider-shell {
      --pad-x: 240px;
    }
  }

  .quote-slider {
    --quote-gap: 24px;
    position: relative;
    width: 100%;
    /* live: 48px top; room for AAP chrome below */
    padding-block: 48px 96px;
    overflow: hidden;
  }

  @media (max-width: 809.98px) {
    .quote-slider {
      padding-block: 24px 96px;
    }
  }

  .quote-slider__fade {
    pointer-events: none;
    position: absolute;
    top: 0;
    bottom: 96px;
    width: clamp(48px, 8cqi, 105px);
    z-index: 3;
  }

  .quote-slider__fade--left {
    left: 0;
    background: linear-gradient(90deg, #000 0%, #0000 100%);
  }

  .quote-slider__fade--right {
    right: 0;
    background: linear-gradient(90deg, #0000 0%, #000 100%);
  }

  .quote-slider__viewport {
    position: relative;
    z-index: 1;
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    cursor: grab;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-y;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--pad-x);
    outline: none;
  }

  .quote-slider__viewport::-webkit-scrollbar {
    display: none;
  }

  .quote-slider__viewport.is-dragging,
  .quote-slider__viewport.is-animating {
    cursor: grabbing;
    user-select: none;
    scroll-snap-type: none;
  }

  .quote-slider__viewport:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  .quote-slider__track {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--quote-gap);
    width: max-content;
    padding-inline: var(--pad-x);
  }

  /*
   * Quote card:
   *   header row → role + name (left) · optional avatar (right)
   *   hairline divider
   *   quote body
   */
  .quote-card {
    position: relative;
    flex: 0 0 var(--quote-width);
    width: var(--quote-width);
    max-width: var(--quote-width);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    gap: 20px;
    min-height: 260px;
    height: auto;
    padding: 28px 32px;
    background-color: var(--color-surface);
    border-radius: 12px;
    overflow: hidden;
    scroll-snap-align: center;
    scroll-snap-stop: always;
    user-select: none;
    opacity: 0.45;
    transition: opacity 0.35s var(--ease-smooth, ease);
  }

  .quote-card.is-active {
    opacity: 1;
  }

  .quote-card__header {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    min-width: 0;
  }

  .quote-card__identity {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 4px;
    min-width: 0;
    flex: 1 1 auto;
  }

  .quote-card__role {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 400;
    line-height: 1.35;
    text-align: left;
    /* Accent blue — clearer than muted purple-gray on dark surface */
    color: var(--color-accent);
    white-space: normal;
    word-break: break-word;
  }

  .quote-card__author {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(22px, 3.2cqi, 28px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0;
    text-align: left;
    text-transform: uppercase;
    color: var(--color-text);
    white-space: normal;
    word-break: break-word;
  }

  .quote-card__avatar {
    flex: 0 0 auto;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    overflow: hidden;
    background-color: var(--color-surface-elevated);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
  }

  .quote-card__avatar :global(img) {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .quote-card__divider {
    flex: none;
    width: 100%;
    height: 1px;
    margin: 0;
    background-color: rgba(255, 255, 255, 0.08);
  }

  .quote-card__text {
    margin: 0;
    width: 100%;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.7;
    text-align: left;
    color: var(--color-text);
    white-space: pre-wrap;
    word-break: break-word;
  }

  @media (max-width: 809.98px) {
    .quote-card {
      padding: 20px;
      gap: 16px;
      min-height: 220px;
    }

    .quote-card__avatar {
      width: 40px;
      height: 40px;
    }

    .quote-card__author {
      font-size: 20px;
    }
  }

  .quote-slider__arrows {
    position: absolute;
    inset: clamp(48px, 12%, 100px) clamp(16px, 4vw, 100px) 100px;
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: space-between;
    pointer-events: none;
  }

  .quote-slider__arrow {
    pointer-events: auto;
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    margin: 0;
    padding: 0;
    border: none;
    border-radius: 40px;
    background: transparent;
    color: #fff;
    cursor: pointer;
    appearance: none;
    overflow: visible;
  }

  .quote-slider__arrow-visual {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(14px) saturate(160%);
    will-change: transform;
    transition: background-color 200ms cubic-bezier(0.44, 0, 0.56, 1);
  }

  .quote-slider__arrow:hover:not(:disabled) .quote-slider__arrow-visual,
  .quote-slider__arrow.is-magnetic .quote-slider__arrow-visual {
    background: rgba(255, 255, 255, 0.16);
  }

  .quote-slider__arrow:disabled,
  .quote-slider__arrow.is-disabled {
    opacity: 0.35;
    cursor: default;
  }

  .quote-slider__arrow svg {
    display: block;
  }

  @supports not (width: 1cqi) {
    .quote-slider-shell {
      --quote-width: min(600px, calc(100% - 2 * var(--pad-x)));
    }
  }
</style>

<script>
  import { bootDeckSliders } from '../scripts/deck-slider';

  const boot = () => bootDeckSliders();
  boot();
  document.addEventListener('astro:page-load', boot);
</script>
