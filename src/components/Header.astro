---
import { site } from '../data/site';
import Button from './Button.astro';
import LogoWave from './LogoWave.astro';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!--
  transition:persist — header never re-mounts on ClientRouter navigations,
  so it stays out of the page-transition animation entirely.
  Active states are synced in page-mask.ts (syncNavActive).
-->
<header class="site-header" transition:persist="site-header" data-site-header>
  <nav class="site-nav" aria-label="Primary">
    <LogoWave />
    <div class="nav-links">
      {
        site.nav.map((item) => (
          <Button
            href={item.href}
            label={item.label}
            active={pathname === item.href || pathname.startsWith(item.href + '/')}
          />
        ))
      }
    </div>
  </nav>
  <div class="nav-border" aria-hidden="true"></div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    /* Below .page-mask (10060) during transitions; above page content */
    z-index: 10050;
    width: 100%;
    overflow: visible;
    /* Full-bleed bar; inner nav matches live Framer (1200 / --content-max) */
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(var(--blur-nav));
    -webkit-backdrop-filter: blur(var(--blur-nav));
  }

  .site-nav {
    display: flex;
    align-items: center; /* vertical center: logo + links */
    justify-content: space-between;
    gap: var(--space-7);
    height: var(--nav-height);
    width: 100%;
    /* Live Framer nav: width 1200px, padding 12px 24px */
    max-width: var(--content-max);
    margin-inline: auto;
    padding: 12px 24px;
    overflow: visible;
  }

  .nav-links {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-8);
    flex-shrink: 0;
  }

  .nav-border {
    height: 1px;
    width: 100%;
    background: var(--color-border);
  }

  @media (max-width: 640px) {
    .site-nav {
      padding: 12px 16px;
    }

    .nav-links {
      gap: var(--space-3);
    }
  }
</style>
