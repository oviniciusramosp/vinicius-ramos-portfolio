---
import type { TravelCity, TravelPlace } from '../../data/travel';
import {
  googleMapsUrl,
  placeCategoryMeta,
  travelUi,
  formatMoney,
  formatDuration,
  formatTicketPromo,
  priceLevelFromMoney,
} from '../../data/travel';
import {
  mapsIconHtml,
  placePinIconHtml,
} from '../../data/travel-categories';
import {
  placeSubcategoryMeta,
  type PlaceSubcategory,
} from '../../data/travel-subcategories';
import StarRating from './StarRating.astro';
import PriceLevel from './PriceLevel.astro';
import '../../styles/travel-place-card.css';

interface Props {
  place: TravelPlace;
  city: TravelCity;
  /**
   * Feed presentation:
   * - `list` — under category groups (subs only)
   * Omit for map-panel clones (full details).
   */
  variant?: 'list';
}

const { place, city, variant } = Astro.props;
const catEn = travelUi.categories[place.category].en;
const catPt = travelUi.categories[place.category]['pt-BR'];
const ratingGoogleEn = travelUi.ratingGoogle.en;
const ratingGooglePt = travelUi.ratingGoogle['pt-BR'];
const ratingMineEn = travelUi.ratingMine.en;
const ratingMinePt = travelUi.ratingMine['pt-BR'];
const mapsHref = googleMapsUrl(place, city);
const catColor = placeCategoryMeta[place.category].color;
const catIcon = placePinIconHtml(place.category, place.subcategories);
const mapsIcon = mapsIconHtml();
const visit = place.visit;

const v = travelUi.visit;
// Card (right panel + feed): full min–max range when authored.
// Day budget in the itinerary sidebar uses moneyTypicalEur (min/typical only).
const avgPriceEn = visit?.avgPricePerPerson
  ? formatMoney(visit.avgPricePerPerson, 'en')
  : null;
const avgPricePt = visit?.avgPricePerPerson
  ? formatMoney(visit.avgPricePerPerson, 'pt-BR')
  : null;
const avgPriceLevel = visit?.avgPricePerPerson
  ? priceLevelFromMoney(visit.avgPricePerPerson)
  : null;
const pricePerNightEn = visit?.pricePerNight
  ? formatMoney(visit.pricePerNight, 'en')
  : null;
const pricePerNightPt = visit?.pricePerNight
  ? formatMoney(visit.pricePerNight, 'pt-BR')
  : null;
const ticketEn = visit?.ticket ? formatMoney(visit.ticket, 'en') : null;
const ticketPt = visit?.ticket ? formatMoney(visit.ticket, 'pt-BR') : null;
const durationEn = visit ? formatDuration(visit, 'en') : null;
const durationPt = visit ? formatDuration(visit, 'pt-BR') : null;
const bestTimeEn = visit?.bestTime?.en ?? null;
const bestTimePt = visit?.bestTime?.['pt-BR'] ?? null;
const bestDayEn = visit?.bestDay?.en ?? null;
const bestDayPt = visit?.bestDay?.['pt-BR'] ?? null;
const tipsEn = visit?.tips?.en ?? null;
const tipsPt = visit?.tips?.['pt-BR'] ?? null;
const ticketNoteEn = visit?.ticket?.note?.en;
const ticketNotePt = visit?.ticket?.note?.['pt-BR'];
const ticketPromos = visit?.ticketPromos ?? [];
const avgNoteEn = visit?.avgPricePerPerson?.note?.en;
const avgNotePt = visit?.avgPricePerPerson?.note?.['pt-BR'];
const nightNoteEn = visit?.pricePerNight?.note?.en;
const nightNotePt = visit?.pricePerNight?.note?.['pt-BR'];

const hasVisitMeta =
  avgPriceEn ||
  pricePerNightEn ||
  ticketEn ||
  ticketPromos.length > 0 ||
  durationEn ||
  bestTimeEn ||
  bestDayEn ||
  tipsEn;

const photos = place.photos ?? [];
const hasPhotos = photos.length > 0;
const subs = (place.subcategories ?? []) as PlaceSubcategory[];
const subLabels = subs.map((id) => ({
  id,
  en: placeSubcategoryMeta[id]?.label.en ?? id,
  pt: placeSubcategoryMeta[id]?.label['pt-BR'] ?? id,
}));

const searchBlob = [
  place.name.en,
  place.name['pt-BR'],
  place.description.en,
  place.description['pt-BR'],
  place.address ?? '',
  place.mapsQuery ?? '',
  catEn,
  catPt,
  place.category,
  ...subLabels.map((s) => `${s.en} ${s.pt}`),
  avgPriceEn ?? '',
  pricePerNightEn ?? '',
  tipsEn ?? '',
  bestTimeEn ?? '',
  bestDayEn ?? '',
  place.favorite ? 'favorite favorito' : '',
  place.rating != null ? `rating ${place.rating}` : '',
].join(' ');

const favLabelEn = travelUi.favorite.en;
const favLabelPt = travelUi.favorite['pt-BR'];
---

<article
  class:list={[
    'travel-place-card',
    place.featured && 'is-featured',
    place.favorite && 'is-favorite',
    /* Always reserve a media header (photo or category placeholder) */
    'travel-place-card--has-photos',
    !hasPhotos && 'travel-place-card--placeholder-media',
    variant === 'list' && 'travel-place-card--list',
  ]}
  data-place-id={place.id}
  data-category={place.category}
  data-lat={String(place.lat)}
  data-lng={String(place.lng)}
  data-search={searchBlob}
  data-has-area={place.area ? 'true' : 'false'}
  data-osm-ref={visit?.osmRef ?? undefined}
  data-favorite={place.favorite ? 'true' : undefined}
  data-rating={place.rating != null ? String(place.rating) : undefined}
  data-feed-variant={variant}
  style={`--cat-color: ${catColor}`}
  tabindex="0"
>
  <div
    class="travel-place-card__media"
    {...(hasPhotos ? { 'data-photo-slider': true } : {})}
    data-photo-count={String(photos.length)}
  >
    {
      hasPhotos ? (
        <div class="travel-place-card__slides" data-photo-track>
          {photos.map((photo, i) => (
            <figure
              class:list={[
                'travel-place-card__slide',
                i === 0 && 'is-active',
              ]}
              data-photo-slide
              data-index={String(i)}
            >
              <img
                class="travel-place-card__img"
                src={photo.url}
                alt={photo.alt?.en ?? place.name.en}
                data-i18n-en={photo.alt?.en ?? place.name.en}
                data-i18n-pt={photo.alt?.['pt-BR'] ?? place.name['pt-BR']}
                data-i18n-as="alt"
                data-photo-src={photo.url}
                loading="eager"
                decoding="async"
                fetchpriority={i === 0 ? 'high' : 'low'}
                draggable="false"
              />
            </figure>
          ))}
        </div>
      ) : (
        <div class="travel-place-card__placeholder" aria-hidden="true">
          <span
            class="travel-place-card__placeholder-icon"
            set:html={catIcon}
          />
        </div>
      )
    }

    {/* Close over media (panel only — shown via .travel-place-card--panel) */}
    <button
      type="button"
      class="travel-place-card__close travel-place-card__close--on-media"
      data-place-close
      aria-label={travelUi.closePanel.en}
      data-i18n-en={travelUi.closePanel.en}
      data-i18n-pt={travelUi.closePanel['pt-BR']}
      data-i18n-as="aria-label"
      title={travelUi.closePanel.en}
      tabindex="-1"
    >
      <ion-icon name="close-outline" aria-hidden="true"></ion-icon>
    </button>

    {
      photos.length > 1 && (
        <>
          <div class="travel-place-card__dots" data-photo-dots>
            {photos.map((_, i) => (
              <button
                type="button"
                class:list={[
                  'travel-place-card__dot',
                  i === 0 && 'is-active',
                ]}
                data-photo-dot
                data-index={String(i)}
                aria-label={`Photo ${i + 1}`}
              />
            ))}
          </div>
          <button
            type="button"
            class="travel-place-card__nav travel-place-card__nav--prev"
            data-photo-prev
            aria-label="Previous photo"
          >
            <span class="material-symbols-rounded" aria-hidden="true">
              chevron_left
            </span>
          </button>
          <button
            type="button"
            class="travel-place-card__nav travel-place-card__nav--next"
            data-photo-next
            aria-label="Next photo"
          >
            <span class="material-symbols-rounded" aria-hidden="true">
              chevron_right
            </span>
          </button>
        </>
      )
    }
  </div>

  <!-- Title (same styles with/without photos) -->
  <div class="travel-place-card__title-row" data-place-title-row>
    <div class="travel-place-card__title-main">
      <h3
        class="travel-place-card__name"
        data-i18n-en={place.name.en}
        data-i18n-pt={place.name['pt-BR']}
      >
        {place.name.en}
      </h3>
    </div>
  </div>

  <!-- [category badge + favorite] then [subtags] horizontal scroll -->
  <div class="travel-place-card__tags">
    <div class="travel-place-card__tags-main">
      <span class="travel-place-card__cat" style={`--cat-color: ${catColor}`}>
        <span
          class="travel-place-card__cat-icon"
          aria-hidden="true"
          set:html={catIcon}
        />
        <span
          class="travel-place-card__cat-label"
          data-i18n-en={catEn}
          data-i18n-pt={catPt}
        >
          {catEn}
        </span>
      </span>
      {
        place.favorite && (
          <span
            class="travel-place-card__favorite"
            aria-label={favLabelEn}
            data-i18n-en={favLabelEn}
            data-i18n-pt={favLabelPt}
            data-i18n-as="aria-label"
            title={favLabelEn}
          >
            <span class="material-symbols-rounded" aria-hidden="true">
              favorite
            </span>
          </span>
        )
      }
    </div>
    {
      subLabels.length > 0 && (
        <div class="travel-place-card__subs" data-subtags-scroll>
          {subLabels.map((s) => (
            <span
              class="travel-place-card__sub"
              data-subcategory={s.id}
              data-i18n-en={s.en}
              data-i18n-pt={s.pt}
            >
              {s.en}
            </span>
          ))}
        </div>
      )
    }
  </div>

  <!-- [description] -->
  <p
    class="travel-place-card__desc"
    data-i18n-en={place.description.en}
    data-i18n-pt={place.description['pt-BR']}
  >
    {place.description.en}
  </p>

  <!--
    Two soft cards: Google · Mine (missing → outlined gray stars)
  -->
  <div class="travel-place-card__ratings">
    <StarRating
      rating={place.googleRating}
      label={ratingGoogleEn}
      labelPt={ratingGooglePt}
      icon="map"
    />
    <StarRating
      rating={place.rating}
      label={ratingMineEn}
      labelPt={ratingMinePt}
      icon="person"
    />
  </div>

  <!-- Optional live opening hours (Overpass) when osmRef is set -->
  {
    visit?.osmRef && (
      <div class="travel-place-card__live" data-live-row hidden>
        <span
          class="travel-place-card__live-pill"
          data-live-hours
          hidden
          data-open-en={v.liveOpen.en}
          data-open-pt={v.liveOpen['pt-BR']}
          data-closed-en={v.liveClosed.en}
          data-closed-pt={v.liveClosed['pt-BR']}
        ></span>
      </div>
    )
  }

  {
    hasVisitMeta && (
      <dl class="travel-place-card__meta">
        {avgPriceEn && (
          <div class="travel-place-card__meta-row">
            <dt
              data-i18n-en={v.avgPrice.en}
              data-i18n-pt={v.avgPrice['pt-BR']}
            >
              {v.avgPrice.en}
            </dt>
            <dd>
              <span class="travel-place-card__meta-value">
                {
                  avgPriceLevel != null && (
                    <PriceLevel
                      level={avgPriceLevel}
                      label={v.avgPrice.en}
                      labelPt={v.avgPrice['pt-BR']}
                    />
                  )
                }
                <span
                  data-i18n-en={avgPriceEn}
                  data-i18n-pt={avgPricePt ?? avgPriceEn}
                >
                  {avgPriceEn}
                </span>
              </span>
              {avgNoteEn && (
                <span
                  class="travel-place-card__meta-note"
                  data-i18n-en={avgNoteEn}
                  data-i18n-pt={avgNotePt ?? avgNoteEn}
                >
                  {avgNoteEn}
                </span>
              )}
            </dd>
          </div>
        )}
        {pricePerNightEn && (
          <div class="travel-place-card__meta-row">
            <dt
              data-i18n-en={v.pricePerNight.en}
              data-i18n-pt={v.pricePerNight['pt-BR']}
            >
              {v.pricePerNight.en}
            </dt>
            <dd>
              <span
                data-i18n-en={pricePerNightEn}
                data-i18n-pt={pricePerNightPt ?? pricePerNightEn}
              >
                {pricePerNightEn}
              </span>
              {nightNoteEn && (
                <span
                  class="travel-place-card__meta-note"
                  data-i18n-en={nightNoteEn}
                  data-i18n-pt={nightNotePt ?? nightNoteEn}
                >
                  {nightNoteEn}
                </span>
              )}
            </dd>
          </div>
        )}
        {ticketEn && (
          <div class="travel-place-card__meta-row">
            <dt data-i18n-en={v.ticket.en} data-i18n-pt={v.ticket['pt-BR']}>
              {v.ticket.en}
            </dt>
            <dd>
              <div class="travel-place-card__meta-value">
                <span data-i18n-en={ticketEn} data-i18n-pt={ticketPt ?? ticketEn}>
                  {ticketEn}
                </span>
                {visit?.ticketUrl && (
                  <a
                    class="travel-place-card__ticket-info"
                    href={visit.ticketUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={v.ticketLink.en}
                    data-i18n-en={v.ticketLink.en}
                    data-i18n-pt={v.ticketLink['pt-BR']}
                    data-i18n-as="aria-label"
                    title={v.ticketLink.en}
                  >
                    <span class="material-symbols-rounded" aria-hidden="true">
                      info
                    </span>
                  </a>
                )}
              </div>
              {ticketNoteEn && (
                <span
                  class="travel-place-card__meta-note"
                  data-i18n-en={ticketNoteEn}
                  data-i18n-pt={ticketNotePt ?? ticketNoteEn}
                >
                  {ticketNoteEn}
                </span>
              )}
              {ticketPromos.length > 0 && (
                <ul class="travel-place-card__ticket-promos">
                  {ticketPromos.map((promo) => {
                    const en = formatTicketPromo(promo, 'en');
                    const pt = formatTicketPromo(promo, 'pt-BR');
                    return (
                      <li
                        class:list={[
                          'travel-place-card__ticket-promo',
                          `travel-place-card__ticket-promo--${promo.kind}`,
                        ]}
                        data-promo-kind={promo.kind}
                      >
                        <span
                          class="material-symbols-rounded travel-place-card__ticket-promo-icon"
                          aria-hidden="true"
                        >
                          sell
                        </span>
                        <span data-i18n-en={en} data-i18n-pt={pt}>
                          {en}
                        </span>
                      </li>
                    );
                  })}
                </ul>
              )}
            </dd>
          </div>
        )}
        {durationEn && (
          <div class="travel-place-card__meta-row">
            <dt
              data-i18n-en={v.duration.en}
              data-i18n-pt={v.duration['pt-BR']}
            >
              {v.duration.en}
            </dt>
            <dd>
              <span data-i18n-en={durationEn} data-i18n-pt={durationPt ?? durationEn}>
                {durationEn}
              </span>
            </dd>
          </div>
        )}
        {bestTimeEn && (
          <div class="travel-place-card__meta-row">
            <dt
              data-i18n-en={v.bestTime.en}
              data-i18n-pt={v.bestTime['pt-BR']}
            >
              {v.bestTime.en}
            </dt>
            <dd>
              <span data-i18n-en={bestTimeEn} data-i18n-pt={bestTimePt ?? bestTimeEn}>
                {bestTimeEn}
              </span>
            </dd>
          </div>
        )}
        {bestDayEn && (
          <div class="travel-place-card__meta-row">
            <dt data-i18n-en={v.bestDay.en} data-i18n-pt={v.bestDay['pt-BR']}>
              {v.bestDay.en}
            </dt>
            <dd>
              <span data-i18n-en={bestDayEn} data-i18n-pt={bestDayPt ?? bestDayEn}>
                {bestDayEn}
              </span>
            </dd>
          </div>
        )}
        {tipsEn && (
          <div class="travel-place-card__meta-row travel-place-card__meta-row--tips">
            <dt data-i18n-en={v.tips.en} data-i18n-pt={v.tips['pt-BR']}>
              {v.tips.en}
            </dt>
            <dd>
              {/*
                Newlines in tips render via white-space: pre-line.
                Attributes encode \n as the two-char sequence "\\n" so HTML
                attr normalization does not collapse breaks; travel-i18n
                decodes on locale switch.
              */}
              <span
                class="travel-place-card__tips-text"
                data-i18n-en={tipsEn.replace(/\n/g, '\\n')}
                data-i18n-pt={(tipsPt ?? tipsEn).replace(/\n/g, '\\n')}
              >
                {tipsEn}
              </span>
            </dd>
          </div>
        )}
      </dl>
    )
  }

  <!--
    Address: label + value row with maps icon inline.
    Whole value row (address + icon) opens Google Maps.
  -->
  <div class="travel-place-card__maps-row">
    <span
      class="travel-place-card__maps-label"
      data-i18n-en={travelUi.address.en}
      data-i18n-pt={travelUi.address['pt-BR']}
    >
      {travelUi.address.en}
    </span>
    <a
      class="travel-place-card__maps-link"
      href={mapsHref}
      target="_blank"
      rel="noopener noreferrer"
      data-cursor="block"
      aria-label={travelUi.openInMaps.en}
      data-i18n-en={travelUi.openInMaps.en}
      data-i18n-pt={travelUi.openInMaps['pt-BR']}
      data-i18n-as="aria-label"
      title={travelUi.openInMaps.en}
    >
      {
        place.address ? (
          <span class="travel-place-card__address">{place.address}</span>
        ) : (
          <span class="travel-place-card__address travel-place-card__address--empty">
            —
          </span>
        )
      }
      <span
        class="travel-place-card__maps-icon"
        aria-hidden="true"
        set:html={mapsIcon}
      />
    </a>
  </div>

  <!-- Multi-stop route planner (city map page) -->
  <button
    type="button"
    class="travel-place-card__route-add"
    data-route-add
    data-place-id={place.id}
    data-cursor="block"
    aria-pressed="false"
    data-i18n-en={travelUi.addToRoute.en}
    data-i18n-pt={travelUi.addToRoute['pt-BR']}
    data-i18n-as="aria-label"
    aria-label={travelUi.addToRoute.en}
    title={travelUi.addToRoute.en}
  >
    <span class="material-symbols-rounded" aria-hidden="true">route</span>
    <span
      class="travel-place-card__route-add-label"
      data-route-add-label
      data-i18n-en={travelUi.addToRoute.en}
      data-i18n-pt={travelUi.addToRoute['pt-BR']}
    >
      {travelUi.addToRoute.en}
    </span>
  </button>
</article>
