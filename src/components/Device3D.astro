---
/**
 * Progressive-enhancement 3D device mock.
 *
 * Primary path: WebGL GLB (canvas). The flat Cosmic Orange bezel is only a
 * permanent fallback (no WebGL / load fail / reduced-motion static) — it is
 * hidden while the model loads so users never see orange frame → 3D crossfade.
 */
interface Props {
  /** GLB path (default: local iPhone 15 Pro Max ready mesh) */
  model?: string;
  /** App UI on the display (image or video) */
  screen: string;
  /** Accessible description (also used on poster) */
  alt: string;
  /**
   * Optional single poster image. When omitted, builds Cosmic Orange bezel + screen.
   */
  poster?: string;
  /** Load abort in ms (default 8000) */
  loadTimeout?: number;
  /** Skip WebGL when prefers-reduced-motion (default true) */
  staticOnReduce?: boolean;
  class?: string;
}

const {
  model = '/devices/three/iphone-ready.glb',
  screen,
  alt,
  poster,
  loadTimeout = 8000,
  staticOnReduce = true,
  class: className = '',
} = Astro.props;

/** Official-ish bezel from device-frames-media (iPhone 17 Pro Cosmic Orange) */
const BEZEL = {
  frame: '/devices/iphone-17-pro-cosmic-orange/frame.png',
  frameW: 1406,
  frameH: 2822,
  screen: { x: 100, y: 100, w: 1206, h: 2622 },
};

const screenLeft = `${(BEZEL.screen.x / BEZEL.frameW) * 100}%`;
const screenTop = `${(BEZEL.screen.y / BEZEL.frameH) * 100}%`;
const screenWidth = `${(BEZEL.screen.w / BEZEL.frameW) * 100}%`;
const screenHeight = `${(BEZEL.screen.h / BEZEL.frameH) * 100}%`;
---

<div
  class:list={['device-3d', className]}
  data-device-3d
  data-model={model}
  data-screen={screen}
  data-load-timeout={String(loadTimeout)}
  data-static-on-reduce={staticOnReduce ? '' : undefined}
  role="img"
  aria-label={alt}
>
  {/* Poster: always in DOM for LCP / no-JS / WebGL failure */}
  <div class="device-3d__poster">
    {
      poster ? (
        <img
          class="device-3d__poster-img"
          src={poster}
          alt=""
          loading="eager"
          decoding="async"
          draggable="false"
        />
      ) : (
        <div
          class="device-3d__bezel"
          style={`--bezel-ratio: ${BEZEL.frameW} / ${BEZEL.frameH}; --screen-l: ${screenLeft}; --screen-t: ${screenTop}; --screen-w: ${screenWidth}; --screen-h: ${screenHeight};`}
        >
          <div class="device-3d__bezel-rig">
            <img
              class="device-3d__bezel-ui"
              src={screen}
              alt=""
              loading="eager"
              decoding="async"
              draggable="false"
            />
            <img
              class="device-3d__bezel-frame"
              src={BEZEL.frame}
              alt=""
              aria-hidden="true"
              loading="eager"
              decoding="async"
              draggable="false"
            />
          </div>
        </div>
      )
    }
  </div>

  {/* Enhanced layer — hidden until ready */}
  <canvas class="device-3d__canvas" data-device-3d-canvas hidden aria-hidden="true"></canvas>
</div>

{/* No-JS: flat bezel is the only view of the device */}
<noscript>
  <style>
    .device-3d__poster {
      opacity: 1 !important;
    }
  </style>
</noscript>

<style>
  .device-3d {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 0;
    display: grid;
    place-items: center;
    /* Clip bottom of the large phone so only the upper half reads in the card */
    overflow: hidden;
    touch-action: pan-y;
    /* Neutral ambient (matches titanium GLB, not Cosmic Orange bezel) */
    background:
      radial-gradient(ellipse 65% 55% at 50% 48%, rgba(180, 190, 210, 0.1) 0%, transparent 62%),
      transparent;
  }

  .device-3d__poster {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    z-index: 1;
    /*
     * Hidden by default so the Cosmic Orange bezel never flashes under the GLB.
     * Shown only on `.is-fallback` (no WebGL / load fail / reduced-motion static)
     * or via <noscript> above.
     */
    opacity: 0;
    transition: opacity 320ms var(--ease-smooth, cubic-bezier(0.44, 0, 0.56, 1));
    pointer-events: none;
  }

  .device-3d.is-fallback .device-3d__poster {
    opacity: 1;
  }

  .device-3d__poster-img {
    display: block;
    width: auto;
    height: auto;
    max-width: 72%;
    max-height: 88%;
    object-fit: contain;
  }

  /*
   * Bezel poster: oversized + shifted so only upper half shows (matches WebGL crop).
   * --device-rx/ry/rz are a one-shot snapshot of the 3D intro pose (set in device-three.ts)
   * so loading / WebGL-fail fallback matches the first frame of the model.
   */
  .device-3d__bezel {
    width: min(78%, 340px);
    max-height: none;
    aspect-ratio: var(--bezel-ratio);
    perspective: 1000px;
    transform: translateY(22%);
  }

  .device-3d__bezel-rig {
    position: relative;
    width: 100%;
    height: 100%;
    /* Defaults ≈ intro pose near top-of-page hero before JS runs */
    transform: rotateX(var(--device-rx, 3.5deg)) rotateY(var(--device-ry, -32deg))
      rotateZ(var(--device-rz, 0deg)) scale(1.35);
    transform-style: preserve-3d;
    filter: drop-shadow(0 18px 28px rgba(0, 0, 0, 0.45));
  }

  .device-3d__bezel-ui {
    position: absolute;
    left: var(--screen-l);
    top: var(--screen-t);
    width: var(--screen-w);
    height: var(--screen-h);
    object-fit: cover;
    object-position: top center;
    border-radius: 11% / 5%;
    background: #000;
    z-index: 0;
  }

  .device-3d__bezel-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: fill;
    z-index: 1;
    pointer-events: none;
    user-select: none;
  }

  .device-3d__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    opacity: 0;
    transition: opacity 480ms var(--ease-smooth, cubic-bezier(0.44, 0, 0.56, 1));
    display: block;
  }

  .device-3d.is-ready .device-3d__canvas {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .device-3d__poster,
    .device-3d__canvas {
      transition: none;
    }

    /* Match REDUCED_POSE in device-three.ts (rx: 8, ry: -14) */
    .device-3d__bezel-rig {
      transform: rotateX(var(--device-rx, 8deg)) rotateY(var(--device-ry, -14deg))
        rotateZ(var(--device-rz, 0deg)) scale(1.35);
    }
  }
</style>

<script>
  import { bootDevice3D } from '../scripts/device-three';

  const boot = () => bootDevice3D();
  boot();
  document.addEventListener('astro:page-load', boot);
  // bfcache restore (back/forward) — re-run entrance
  window.addEventListener('pageshow', (e) => {
    if (e.persisted) boot();
  });
</script>
