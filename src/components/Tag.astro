---
interface Props {
  label: string;
  tone?: 'default' | 'accent' | 'soon';
  /**
   * `solid` — case-study meta (muted border).
   * `reveal` — hidden until project-card hover.
   * `chip` — always the card-badge glass look (filters, static chips).
   */
  variant?: 'reveal' | 'solid' | 'chip';
  /** Filter active / selected state (chip only) */
  pressed?: boolean;
  /** Optional leading solid SVG (e.g. category icon matching map pins) */
  iconHtml?: string;
}

const {
  label,
  tone = 'default',
  variant = 'solid',
  pressed = false,
  iconHtml,
} = Astro.props;
---

<span
  class:list={[
    'tag',
    `tag--${tone}`,
    `tag--${variant}`,
    pressed && 'is-pressed',
    iconHtml && 'tag--has-icon',
  ]}
>
  <span class="tag__glass" aria-hidden="true"></span>
  {
    iconHtml && (
      <span class="tag__icon" aria-hidden="true" set:html={iconHtml} />
    )
  }
  <span class="tag__label">{label}</span>
</span>

<style>
  /*
   * Default = solid / always visible (case studies, static UI).
   * Only `.tag--reveal` starts invisible and appears on card hover.
   */
  .tag {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    padding: 6px 12px;
    border-radius: 50px;
    isolation: isolate;
    overflow: hidden;
    color: #ffffff;
    border: 1px solid var(--color-text-muted);
    background-color: rgba(0, 0, 0, 0.01);
  }

  .tag--has-icon {
    gap: 6px;
    padding-left: 10px;
  }

  .tag__glass {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    pointer-events: none;
    background-color: transparent;
    backdrop-filter: none;
  }

  .tag__icon {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 14px;
    height: 14px;
    color: inherit;
    opacity: 0.92;
  }

  .tag__icon :global(svg),
  .tag__icon :global(ion-icon),
  .tag__icon :global(.material-symbols-rounded) {
    display: block;
    width: 14px;
    height: 14px;
    font-size: 14px;
    line-height: 1;
    color: inherit;
    font-variation-settings:
      'FILL' 1,
      'wght' 500,
      'GRAD' 0,
      'opsz' 20;
  }

  .tag__label {
    position: relative;
    z-index: 1;
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 12px;
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: 1px;
    white-space: nowrap;
  }

  .tag--accent {
    color: var(--color-accent);
    border-color: rgba(0, 143, 255, 0.4);
  }

  .tag--soon {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.16);
  }

  /*
   * Chip — filter badges.
   * Rest: muted glass (card-tag style).
   * Pressed: solid accent fill so selected ≠ unselected is obvious.
   */
  .tag--chip {
    color: rgba(255, 255, 255, 0.72);
    border-color: rgba(255, 255, 255, 0.16);
    background-color: transparent;
    text-transform: uppercase;
    transition:
      color 0.28s cubic-bezier(0.44, 0, 0.56, 1),
      border-color 0.28s cubic-bezier(0.44, 0, 0.56, 1);
  }

  .tag--chip .tag__glass {
    background-color: rgba(12, 12, 16, 0.35);
    backdrop-filter: blur(14px) saturate(160%);
    transition:
      background-color 0.28s cubic-bezier(0.44, 0, 0.56, 1),
      backdrop-filter 0.28s cubic-bezier(0.44, 0, 0.56, 1);
  }

  .tag--chip.is-pressed,
  .tag--chip.tag--accent {
    color: #ffffff;
    border-color: rgba(0, 143, 255, 0.55);
  }

  .tag--chip.is-pressed .tag__glass,
  .tag--chip.tag--accent .tag__glass {
    background-color: rgba(0, 143, 255, 0.28);
    backdrop-filter: blur(14px) saturate(180%);
  }

  /* —— Reveal (homepage cards only) —— */
  .tag--reveal {
    color: transparent;
    border-color: transparent;
    background-color: transparent;
    transition:
      color 0.38s cubic-bezier(0.44, 0, 0.56, 1),
      border-color 0.38s cubic-bezier(0.44, 0, 0.56, 1);
  }

  .tag--reveal .tag__glass {
    background-color: transparent;
    backdrop-filter: none;
    transition:
      background-color 0.38s cubic-bezier(0.44, 0, 0.56, 1),
      backdrop-filter 0.38s cubic-bezier(0.44, 0, 0.56, 1);
  }

  /* Appear on card hover / magnetic / focus */
  :global(.project-card-shell:hover) .tag--reveal,
  :global(.project-card-shell:focus-within) .tag--reveal,
  :global(.project-card-shell.is-magnetic) .tag--reveal {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.16);
  }

  :global(.project-card-shell:hover) .tag--reveal .tag__glass,
  :global(.project-card-shell:focus-within) .tag--reveal .tag__glass,
  :global(.project-card-shell.is-magnetic) .tag--reveal .tag__glass {
    background-color: rgba(12, 12, 16, 0.45);
    backdrop-filter: blur(14px) saturate(160%);
  }

  :global(.project-card-shell:hover) .tag--reveal.tag--accent,
  :global(.project-card-shell:focus-within) .tag--reveal.tag--accent,
  :global(.project-card-shell.is-magnetic) .tag--reveal.tag--accent {
    color: #008fff;
    border-color: rgba(0, 143, 255, 0.4);
  }

  :global(.project-card-shell:hover) .tag--reveal.tag--accent .tag__glass,
  :global(.project-card-shell:focus-within) .tag--reveal.tag--accent .tag__glass,
  :global(.project-card-shell.is-magnetic) .tag--reveal.tag--accent .tag__glass {
    background-color: rgba(0, 28, 56, 0.5);
  }

  /* Touch / small screens: reveal tags always on */
  @media (max-width: 768px) {
    .tag--reveal {
      color: #ffffff;
      border-color: rgba(255, 255, 255, 0.16);
    }

    .tag--reveal .tag__glass {
      background-color: rgba(12, 12, 16, 0.45);
      backdrop-filter: blur(14px) saturate(160%);
    }

    .tag--reveal.tag--accent {
      color: #008fff;
      border-color: rgba(0, 143, 255, 0.4);
    }

    .tag--reveal.tag--accent .tag__glass {
      background-color: rgba(0, 28, 56, 0.5);
    }

    /* SOON: solid white + black label (not glass) */
    .tag--reveal.tag--soon {
      color: #0a0a0a;
      border-color: #ffffff;
      background-color: #ffffff;
    }

    .tag--reveal.tag--soon .tag__glass {
      background-color: #ffffff;
      backdrop-filter: none;
    }
  }
</style>
