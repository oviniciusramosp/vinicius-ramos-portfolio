---
/**
 * Full-content article dialog.
 * Open via [data-article-open="{id}"] matching dialog id (e.g. article-foo).
 * Close sits inset top-right over the scrollable content; date sits under the title.
 */
import OptimizedImg from './OptimizedImg.astro';

interface Props {
  id: string;
  date: string;
  title: string;
  image?: string;
  imageAlt?: string;
  content: string[];
}

const { id, date, title, image, imageAlt = '', content } = Astro.props;
---

<dialog
  class="article-modal"
  id={id}
  data-article-modal
  aria-labelledby={`${id}-title`}
>
  <div class="article-modal__panel">
    <button
      type="button"
      class="article-modal__close"
      data-article-close
      data-magnetic
      data-cursor="block"
      aria-label="Close"
    >
      <span class="article-modal__close-visual" data-magnetic-visual>
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
          <path
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-width="1.75"
            d="M5 5l10 10M15 5 5 15"
          />
        </svg>
      </span>
    </button>

    <div class="article-modal__body">
      {
        image && (
          <figure class="article-modal__figure">
            <OptimizedImg
              class="article-modal__image"
              src={image}
              alt={imageAlt}
              preset="full"
              loading="lazy"
              decoding="async"
              objectFit="cover"
            />
          </figure>
        )
      }
      <header class="article-modal__header">
        <h2 class="article-modal__title" id={`${id}-title`}>{title}</h2>
        <p class="article-modal__date">{date}</p>
      </header>
      <div class="article-modal__content">
        {content.map((paragraph) => <p class="article-modal__p">{paragraph}</p>)}
      </div>
    </div>
  </div>
</dialog>

<style>
  .article-modal {
    width: min(720px, calc(100vw - 32px));
    max-height: min(860px, calc(100vh - 48px));
    margin: auto;
    padding: 0;
    border: none;
    border-radius: 16px;
    background: var(--color-surface, #131219);
    color: var(--color-text, #fff);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.08),
      0 24px 80px rgba(0, 0, 0, 0.55);
    overflow: hidden;
  }

  .article-modal::backdrop {
    background: rgba(0, 0, 0, 0.72);
    backdrop-filter: blur(8px);
  }

  .article-modal__panel {
    position: relative;
    display: flex;
    flex-direction: column;
    max-height: min(860px, calc(100vh - 48px));
    min-height: 0;
  }

  /* Inset close — top-right over content, not a separate bar */
  .article-modal__close {
    appearance: none;
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    margin: 0;
    padding: 0;
    border: none;
    border-radius: 40px;
    background: transparent;
    color: #fff;
    cursor: pointer;
  }

  .article-modal__close-visual {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    will-change: transform;
    transition: background-color 200ms cubic-bezier(0.44, 0, 0.56, 1);
  }

  .article-modal__close:hover .article-modal__close-visual,
  .article-modal__close.is-magnetic .article-modal__close-visual {
    background: rgba(255, 255, 255, 0.16);
  }

  .article-modal__body {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    padding: 28px 28px 40px;
    /* room so title doesn’t sit under the close control */
    padding-right: 64px;
    -webkit-overflow-scrolling: touch;
  }

  .article-modal__figure {
    margin: 0 0 24px;
    border-radius: 12px;
    overflow: hidden;
    background: #0a0a0c;
  }

  .article-modal__image {
    display: block;
    width: 100%;
    height: auto;
    max-height: 280px;
  }

  .article-modal__image :global(img) {
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
    max-height: 280px;
    object-fit: cover;
    object-position: center;
  }

  .article-modal__header {
    display: grid;
    gap: 10px;
    margin: 0 0 20px;
  }

  .article-modal__title {
    margin: 0;
    font-family: var(--font-display, 'Blatant Bold', sans-serif);
    font-size: clamp(24px, 4vw, 32px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--color-text, #fff);
  }

  .article-modal__date {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 400;
    line-height: 1.3;
    color: var(--color-accent, #008fff);
  }

  .article-modal__content {
    display: flex;
    flex-direction: column;
    gap: 1.1em;
  }

  .article-modal__p {
    margin: 0;
    font-family: var(--font-body, Inter, system-ui, sans-serif);
    font-size: 15px;
    font-weight: 400;
    line-height: 1.7;
    color: var(--color-text-soft, rgba(255, 255, 255, 0.75));
  }

  @media (max-width: 734px) {
    .article-modal {
      width: calc(100vw - 16px);
      max-height: calc(100vh - 24px);
      border-radius: 12px;
    }

    .article-modal__panel {
      max-height: calc(100vh - 24px);
    }

    .article-modal__close {
      top: 12px;
      right: 12px;
    }

    .article-modal__body {
      padding: 20px 18px 32px;
      padding-right: 56px;
    }

    .article-modal__image,
    .article-modal__image :global(img) {
      max-height: 200px;
    }
  }
</style>

<script>
  import { initMagneticButtons } from '../scripts/magnetic';

  function openArticleModal(dialog: HTMLDialogElement) {
    if (!dialog.open) {
      dialog.showModal();
    }
    initMagneticButtons(dialog);
  }

  function closeArticleModal(dialog: HTMLDialogElement) {
    dialog.close();
  }

  function bindArticleModals() {
    document.querySelectorAll<HTMLElement>('[data-article-open]').forEach((trigger) => {
      if (trigger.dataset.articleBound === 'true') return;
      trigger.dataset.articleBound = 'true';

      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        const id = trigger.dataset.articleOpen;
        if (!id) return;
        const dialog = document.getElementById(id);
        if (!(dialog instanceof HTMLDialogElement)) return;
        openArticleModal(dialog);
      });
    });

    document.querySelectorAll<HTMLDialogElement>('[data-article-modal]').forEach((dialog) => {
      if (dialog.dataset.articleBound === 'true') return;
      dialog.dataset.articleBound = 'true';

      dialog.querySelectorAll<HTMLElement>('[data-article-close]').forEach((btn) => {
        btn.addEventListener('click', () => closeArticleModal(dialog));
      });

      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) closeArticleModal(dialog);
      });
    });
  }

  bindArticleModals();
  document.addEventListener('astro:page-load', bindArticleModals);
</script>
