---
import type { Project } from '../data/projects';
import ProjectCard from './ProjectCard.astro';
import Tag from './Tag.astro';

interface Props {
  projects: Project[];
  /** Unique filter tags (order preserved). Empty = no toolbar. */
  filterTags?: string[];
}

const { projects, filterTags = [] } = Astro.props;
const showFilter = filterTags.length > 0;
---

<section class="bento" data-bento-grid aria-label="Selected work">
  {
    showFilter && (
      <div
        class="bento__toolbar"
        data-bento-toolbar
        role="group"
        aria-label="Filter projects by category. Select multiple categories."
      >
        <button
          type="button"
          class="bento__chip is-active"
          data-bento-filter=""
          aria-pressed="true"
          data-magnetic
          data-magnetic-range="6"
        >
          <Tag label="ALL" variant="chip" pressed />
        </button>
        {filterTags.map((tag) => (
          <button
            type="button"
            class="bento__chip"
            data-bento-filter={tag}
            aria-pressed="false"
            data-magnetic
            data-magnetic-range="6"
          >
            <Tag label={tag} variant="chip" />
          </button>
        ))}
      </div>
    )
  }

  <p class="bento__status sr-only" data-bento-status aria-live="polite" />

  <div class="project-grid">
    {
      projects.map((project) => (
        <div
          class:list={['project-grid__cell', `is-${project.size}`]}
          data-bento-cell
          data-size={project.size}
          data-priority={String(project.priority ?? 0)}
          data-tags={project.tags.join('|')}
          data-slug={project.slug}
        >
          <ProjectCard project={project} />
        </div>
      ))
    }
  </div>
</section>

<style>
  /* Live: .framer-ucwi3m — same site shell as nav / case pages */
  .bento {
    width: 100%;
    max-width: var(--shell-max);
    margin-inline: auto;
    /* Query container for row-height calc (cqi must resolve on a parent) */
    container-type: inline-size;
    container-name: bento;
  }

  .bento__toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding: 0 16px 16px;
  }

  /* Hit shell only — visual is Tag chip (same glass badge as card categories) */
  .bento__chip {
    appearance: none;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    cursor: pointer;
    border-radius: 50px;
    line-height: 0;
  }

  .bento__chip:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .bento__chip:hover :global(.tag--chip:not(.is-pressed)) {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.28);
  }

  .bento__chip:hover :global(.tag--chip:not(.is-pressed) .tag__glass) {
    background-color: rgba(18, 18, 24, 0.55);
  }

  .bento__chip:hover :global(.tag--chip.is-pressed .tag__glass) {
    background-color: rgba(0, 143, 255, 0.36);
  }

  /*
   * Dense bento: row height tracks column width so 1×1 cells never exceed
   * --bento-max-aspect (width/height). Fixed 220px rows got too wide on
   * MacBook Pro / shell-max viewports and over-cropped cover images.
   * Filter reassigns is-lg / is-tall / is-sm via the 2-row packer.
   */
  .project-grid {
    --bento-cols: 5;
    --bento-gap: 8px;
    --bento-pad-x: 16px;
    /* 1×1 cell width ÷ height ceiling (slightly landscape, not panoramic) */
    --bento-max-aspect: 1.2;
    /* Floor so medium widths stay dense before the aspect clamp kicks in */
    --bento-row-min: 200px;

    display: grid;
    grid-template-columns: repeat(var(--bento-cols), minmax(0, 1fr));
    /*
     * 100cqi from .bento. Subtract grid pad + gaps → column width,
     * then row = col / max-aspect so 1×1 never exceeds that ratio.
     */
    grid-auto-rows: max(
      var(--bento-row-min),
      calc(
        (
            100cqi - 2 * var(--bento-pad-x) - (var(--bento-cols) - 1) *
              var(--bento-gap)
          ) / var(--bento-cols) / var(--bento-max-aspect)
      )
    );
    grid-auto-flow: dense;
    gap: var(--bento-gap);
    padding: 0 var(--bento-pad-x) 16px;
    width: 100%;
  }

  .project-grid__cell {
    min-width: 0;
    min-height: 0;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-card);
    will-change: transform, opacity;
  }

  .project-grid__cell[hidden] {
    display: none !important;
  }

  .project-grid__cell :global(.project-card-shell),
  .project-grid__cell :global(.project-card) {
    height: 100%;
    min-height: 0;
  }

  .project-grid__cell :global(.project-card) {
    min-height: 100%;
  }

  .is-lg {
    grid-column: span 2;
    grid-row: span 2;
  }

  /* 2×3 feature tile (HP Printables) */
  .is-xl {
    grid-column: span 2;
    grid-row: span 3;
  }

  .is-tall {
    grid-column: span 1;
    grid-row: span 2;
  }

  .is-wide {
    grid-column: span 2;
    grid-row: span 1;
  }

  .is-sm,
  .is-md {
    grid-column: span 1;
    grid-row: span 1;
  }

  @media (max-width: 1100px) {
    .project-grid {
      --bento-cols: 3;
      --bento-row-min: 200px;
    }

    .is-lg {
      grid-column: span 2;
      grid-row: span 2;
    }

    .is-xl {
      grid-column: span 2;
      grid-row: span 3;
    }

    .is-wide {
      grid-column: span 2;
      grid-row: span 1;
    }

    .is-tall {
      grid-column: span 1;
      grid-row: span 2;
    }
  }

  /*
   * Mobile: every card same size (1×1). Multi-row spans (lg/tall/xl)
   * were overlapping neighbors when min-height fought fixed tracks.
   */
  @media (max-width: 720px) {
    .bento__toolbar {
      padding: 0 12px 12px;
      gap: 6px;
    }

    .project-grid {
      --bento-cols: 1;
      --bento-gap: 12px;
      --bento-pad-x: 12px;
      /* Fixed mobile recipe — title + tags need height more than aspect clamp */
      grid-auto-rows: min(300px, 78vw);
      grid-auto-flow: row;
      padding: 0 var(--bento-pad-x) 12px;
    }

    .is-lg,
    .is-xl,
    .is-wide,
    .is-tall,
    .is-sm,
    .is-md {
      grid-column: span 1;
      grid-row: span 1;
      min-height: 0;
      height: 100%;
    }
  }
</style>

<script>
  import { initBentoFilter } from '../scripts/bento-filter';

  const boot = () => initBentoFilter();
  boot();
  document.addEventListener('astro:page-load', boot);
</script>
