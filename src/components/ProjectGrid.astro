---
import type { Project } from '../data/projects';
import ProjectCard from './ProjectCard.astro';
import Tag from './Tag.astro';

interface Props {
  projects: Project[];
  /** Unique filter tags (order preserved). Empty = no toolbar. */
  filterTags?: string[];
}

const { projects, filterTags = [] } = Astro.props;
const showFilter = filterTags.length > 0;
---

<section class="bento" data-bento-grid aria-label="Selected work">
  {
    showFilter && (
      <div
        class="bento__toolbar"
        data-bento-toolbar
        role="group"
        aria-label="Filter projects by category. Select multiple categories."
      >
        <button
          type="button"
          class="bento__chip is-active"
          data-bento-filter=""
          aria-pressed="true"
          data-magnetic
          data-magnetic-range="6"
        >
          <Tag label="ALL" variant="chip" pressed />
        </button>
        {filterTags.map((tag) => (
          <button
            type="button"
            class="bento__chip"
            data-bento-filter={tag}
            aria-pressed="false"
            data-magnetic
            data-magnetic-range="6"
          >
            <Tag label={tag} variant="chip" />
          </button>
        ))}
      </div>
    )
  }

  <p class="bento__status sr-only" data-bento-status aria-live="polite" />

  <div class="project-grid">
    {
      projects.map((project) => (
        <div
          class:list={['project-grid__cell', `is-${project.size}`]}
          data-bento-cell
          data-size={project.size}
          data-priority={String(project.priority ?? 0)}
          data-tags={project.tags.join('|')}
          data-slug={project.slug}
        >
          <ProjectCard project={project} />
        </div>
      ))
    }
  </div>
</section>

<style>
  /* Live: .framer-ucwi3m — same site shell as nav / case pages */
  .bento {
    width: 100%;
    max-width: var(--shell-max);
    margin-inline: auto;
  }

  .bento__toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding: 0 16px 16px;
  }

  /* Hit shell only — visual is Tag chip (same glass badge as card categories) */
  .bento__chip {
    appearance: none;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    cursor: pointer;
    border-radius: 50px;
    line-height: 0;
  }

  .bento__chip:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .bento__chip:hover :global(.tag--chip:not(.is-pressed)) {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.28);
  }

  .bento__chip:hover :global(.tag--chip:not(.is-pressed) .tag__glass) {
    background-color: rgba(18, 18, 24, 0.55);
  }

  .bento__chip:hover :global(.tag--chip.is-pressed .tag__glass) {
    background-color: rgba(0, 143, 255, 0.36);
  }

  /*
   * Dense bento: fixed row tracks + spans.
   * Filter reassigns is-lg / is-tall / is-sm via the 2-row packer.
   */
  .project-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    grid-auto-rows: 220px;
    grid-auto-flow: dense;
    gap: 8px;
    padding: 0 16px 16px;
    width: 100%;
  }

  .project-grid__cell {
    min-width: 0;
    min-height: 0;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-card);
    will-change: transform, opacity;
  }

  .project-grid__cell[hidden] {
    display: none !important;
  }

  .project-grid__cell :global(.project-card-shell),
  .project-grid__cell :global(.project-card) {
    height: 100%;
    min-height: 0;
  }

  .project-grid__cell :global(.project-card) {
    min-height: 100%;
  }

  .is-lg {
    grid-column: span 2;
    grid-row: span 2;
  }

  /* 2×3 feature tile (HP Printables) */
  .is-xl {
    grid-column: span 2;
    grid-row: span 3;
  }

  .is-tall {
    grid-column: span 1;
    grid-row: span 2;
  }

  .is-wide {
    grid-column: span 2;
    grid-row: span 1;
  }

  .is-sm,
  .is-md {
    grid-column: span 1;
    grid-row: span 1;
  }

  @media (max-width: 1100px) {
    .project-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-rows: 200px;
    }

    .is-lg {
      grid-column: span 2;
      grid-row: span 2;
    }

    .is-xl {
      grid-column: span 2;
      grid-row: span 3;
    }

    .is-wide {
      grid-column: span 2;
      grid-row: span 1;
    }

    .is-tall {
      grid-column: span 1;
      grid-row: span 2;
    }
  }

  @media (max-width: 720px) {
    .bento__toolbar {
      padding: 0 12px 12px;
      gap: 6px;
    }

    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 180px;
      padding: 0 12px 12px;
      gap: 8px;
    }

    .is-lg,
    .is-xl,
    .is-wide {
      grid-column: span 2;
      grid-row: span 1;
    }

    .is-tall {
      grid-column: span 1;
      grid-row: span 2;
    }

    .is-lg {
      grid-row: span 2;
    }

    .is-xl {
      grid-row: span 3;
    }
  }

  @media (max-width: 480px) {
    .project-grid {
      grid-template-columns: 1fr;
      grid-auto-rows: 220px;
      gap: 10px;
    }

    .is-lg,
    .is-xl,
    .is-wide,
    .is-tall,
    .is-sm,
    .is-md {
      grid-column: span 1;
      grid-row: span 1;
    }

    .is-lg,
    .is-xl,
    .is-tall {
      min-height: 260px;
    }

    .is-xl {
      min-height: 320px;
    }
  }
</style>

<script>
  import { initBentoFilter } from '../scripts/bento-filter';

  const boot = () => initBentoFilter();
  boot();
  document.addEventListener('astro:page-load', boot);
</script>
