---
/**
 * Horizontal scroll gallery — close recreation of Apple’s #incentive-gallery
 * (macbook-neo “Why Apple is the best place to buy Mac”).
 *
 * Structure:
 *   .gallery.scroll-gallery
 *     .scroll-container
 *       .item-container > ul.card-set > li.gallery-item
 *         .card.tile.tile-rounded.card-hover
 *           .feature-card-content
 *           button.card-control > .tile-button-wrapper > .tile-button (+ icon)
 *     .scroll-gallery-paddlenav.paddlenav.paddlenav-alpha
 */
import { preventOrphans, preventOrphansHtml } from '../utils/prevent-orphans';

export type ScrollGalleryItem = {
  id?: string;
  /** Optional for `social` (image-first) cards — used as accessible name */
  label?: string;
  /** Optional for `social` cards */
  headline?: string;
  body?: string;
  /** Optional — omit for quote/testimonial cards */
  image?: string;
  imageAlt?: string;
  /**
   * CSS object-position for the card image (default: bottom center for feature art).
   * e.g. 'center', 'bottom center', 'center top'
   */
  imageObjectPosition?: string;
  /** Scale art inside the frame (1 = 100%). e.g. 0.8 */
  imageScale?: number;
  /**
   * Quote cards only: portrait shown top-right (header row).
   * Distinct from `image` (product feature art).
   */
  avatar?: string;
  href?: string;
  /**
   * Opens `#id` ArticleModal (or any dialog with matching id) via
   * [data-article-open]. Prefer this over href for in-page content.
   */
  modalId?: string;
  /** Accessible label for the + control / modal trigger */
  actionLabel?: string;
  /**
   * `feature` — Apple product card (image + compact copy).
   * `quote` — testimonial: role + Blatant name + optional avatar · hairline · body.
   * `article` — feature layout with quote-style date + Blatant title.
   * `social` — image-first portrait card (educational posts / Stories); no + chrome.
   */
  kind?: 'feature' | 'quote' | 'article' | 'social';
};

interface Props {
  title?: string;
  cta?: { label: string; href: string };
  items: ScrollGalleryItem[];
  short?: boolean;
  theme?: 'light' | 'dark';
  entrance?: boolean;
  id?: string;
  class?: string;
  /** Accessible name when there is no visible title (e.g. Testimonials) */
  ariaLabel?: string;
}

const {
  title,
  cta,
  items,
  short = true,
  theme = 'light',
  entrance = true,
  id = 'incentive-gallery',
  class: className = '',
  ariaLabel,
} = Astro.props;

const labelledBy = `${id}-heading`;
const galleryName =
  title?.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim() ||
  ariaLabel ||
  'gallery';
const showHeader = Boolean(title || cta);
const hasQuoteItems = items.some((item) => item.kind === 'quote');
const hasArticleItems = items.some((item) => item.kind === 'article');
const hasSocialItems = items.some((item) => item.kind === 'social');

/** Glue last words so card copy never orphans a single word on the last line */
function prepItem(item: ScrollGalleryItem): ScrollGalleryItem {
  /** Quotes are plain text; feature/article headlines may include light HTML */
  const plain = item.kind === 'quote';
  return {
    ...item,
    label: item.label ? preventOrphans(item.label) : item.label,
    headline: item.headline
      ? plain
        ? preventOrphans(item.headline)
        : preventOrphansHtml(item.headline)
      : item.headline,
    body: item.body
      ? plain
        ? preventOrphans(item.body)
        : preventOrphansHtml(item.body)
      : item.body,
  };
}

const displayItems = items.map(prepItem);
---

<section
  class:list={[
    'section-incentive',
    'scroll-gallery-section',
    'background-alt',
    theme === 'dark' ? 'theme-dark' : 'theme-light',
    hasQuoteItems && 'scroll-gallery-section--quotes',
    hasArticleItems && 'scroll-gallery-section--articles',
    hasSocialItems && 'scroll-gallery-section--social',
    className,
  ]}
  data-scroll-gallery-section
  data-theme={theme}
  aria-label={ariaLabel}
>
  {
    showHeader && (
      <header class="section-header viewport-content">
        {
          title ? (
            <h2
              class="section-header-headline"
              id={labelledBy}
              set:html={title.replace(/\n/g, '<br />')}
            />
          ) : null
        }
        {
          cta && (
            <div class="section-header-cta-list-wrapper">
              <a class="section-header-cta" href={cta.href}>
                <span class="icon-copy">{cta.label}</span>
                <ion-icon
                  name="chevron-forward-outline"
                  class="section-header-cta-chevron"
                  aria-hidden="true"
                />
              </a>
            </div>
          )
        }
      </header>
    )
  }

  <div
    id={id}
    class:list={[
      'gallery',
      'gallery-gallery',
      'scroll-gallery',
      'feature-card-gallery',
      short && 'short',
    ]}
    data-scroll-gallery
    data-analytics-gallery-id={galleryName}
    aria-roledescription="carousel"
  >
    <div class="scroll-container" tabindex="-1" data-scroll-container>
      <div class="item-container">
        <ul
          class="card-set grid card-set-full-bleed"
          role="list"
          aria-labelledby={title ? labelledBy : undefined}
        >
          {
            displayItems.map((item, index) => {
              const isQuote = item.kind === 'quote';
              const isArticle = item.kind === 'article';
              const isSocial = item.kind === 'social';
              const actionLabel =
                item.actionLabel ??
                (item.label ? `Learn more about ${item.label}` : item.imageAlt ?? 'Open');
              const headlineText = (item.headline ?? '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
              return (
                <li
                  id={item.id}
                  data-ac-gallery-item
                  data-gallery-index={String(index)}
                  role="listitem"
                  class:list={[
                    'card-container',
                    'feature-card',
                    'gallery-item',
                    isQuote && 'gallery-item--quote',
                    isArticle && 'gallery-item--article',
                    isSocial && 'gallery-item--social',
                    entrance && 'is-entrance',
                  ]}
                  style={entrance ? `--stagger: ${index}` : undefined}
                >
                  <div
                    class:list={[
                      'card',
                      'tile',
                      'tile-rounded',
                      !isQuote && 'card-hover',
                      isQuote && 'card--quote',
                      isSocial && 'card--social',
                    ]}
                  >
                    <div
                      class:list={[
                        'feature-card-content',
                        item.image && 'image-inline',
                        isQuote && 'feature-card-content--quote',
                        isSocial && 'feature-card-content--social',
                      ]}
                    >
                      {
                        !isSocial && (
                          <div class="feature-card-copy-container feature-card-copy">
                            {
                              isQuote ? (
                                <>
                                  {/*
                                    Quote card layout (portfolio):
                                      [role]           [avatar?]
                                      [name · Blatant] [avatar?]
                                      ─────────────────────────
                                      quote body
                                  */}
                                  <header class="feature-card-quote-header">
                                    <div class="feature-card-quote-identity">
                                      <p class="feature-card-quote-role">{item.label}</p>
                                      <h3 class="feature-card-quote-author">{item.headline}</h3>
                                    </div>
                                    {item.avatar && (
                                      <img
                                        class="feature-card-quote-avatar"
                                        src={item.avatar}
                                        alt={item.headline}
                                        width="48"
                                        height="48"
                                        loading="lazy"
                                        decoding="async"
                                        draggable="false"
                                      />
                                    )}
                                  </header>
                                  <div class="feature-card-quote-divider" aria-hidden="true" />
                                  <p class="feature-card-quote-text">{item.body}</p>
                                </>
                              ) : (
                                <>
                                  <h3
                                    class:list={[
                                      'feature-card-label',
                                      'typography-feature-card-label',
                                      isArticle && 'feature-card-label--article',
                                    ]}
                                  >
                                    {item.label}
                                  </h3>
                                  <div class="feature-card-copy-stack">
                                    <p
                                      class:list={[
                                        'feature-card-headline',
                                        'typography-feature-card-headline',
                                        isArticle && 'feature-card-headline--article',
                                      ]}
                                      set:html={item.headline}
                                    />
                                    {item.body && (
                                      <p
                                        class="feature-card-body typography-feature-card-body"
                                        set:html={item.body}
                                      />
                                    )}
                                  </div>
                                </>
                              )
                            }
                          </div>
                        )
                      }
                      {
                        item.image && (
                          <figure
                            class:list={[
                              'feature-card-image-container',
                              !isSocial &&
                                item.imageObjectPosition === 'center' &&
                                'feature-card-image-container--center',
                              isSocial && 'feature-card-image-container--social',
                            ]}
                          >
                            <img
                              class:list={[
                                'feature-card-image',
                                isSocial && 'feature-card-image--social',
                              ]}
                              src={item.image}
                              alt={item.imageAlt ?? item.label ?? ''}
                              loading="lazy"
                              decoding="async"
                              draggable="false"
                              style={[
                                item.imageObjectPosition &&
                                  `object-position: ${item.imageObjectPosition}`,
                                item.imageScale != null &&
                                  item.imageScale !== 1 &&
                                  `transform: scale(${item.imageScale}); transform-origin: center`,
                              ]
                                .filter(Boolean)
                                .join('; ') || undefined}
                            />
                          </figure>
                        )
                      }
                    </div>

                    {
                      /* Articles: full-card hit target only (no + / chevron chrome) */
                      !isQuote &&
                        !isSocial &&
                        (isArticle && item.href && !item.modalId ? (
                          <a
                            class="card-control card-control--bare"
                            data-card-control
                            href={item.href}
                            aria-label={actionLabel}
                            data-transition-label={headlineText}
                          ></a>
                        ) : !isArticle ? (
                          item.href && !item.modalId ? (
                            <a
                              class="card-control"
                              data-card-control
                              href={item.href}
                              aria-label={actionLabel}
                              data-transition-label={headlineText}
                            >
                              <div class="tile-button-wrapper">
                                <span
                                  class:list={[
                                    'tile-button',
                                    'tile-button-high-contrast',
                                    theme === 'dark' ? 'theme-dark' : 'theme-light',
                                  ]}
                                >
                                  <svg
                                    class="icon-control icon-control-plus tile-icon"
                                    xmlns="http://www.w3.org/2000/svg"
                                    viewBox="0 0 36 36"
                                    aria-hidden="true"
                                  >
                                    <path d="m24 16.5h-4.5v-4.5c0-.8286-.6719-1.5-1.5-1.5s-1.5.6714-1.5 1.5v4.5h-4.5c-.8281 0-1.5.6714-1.5 1.5s.6719 1.5 1.5 1.5h4.5v4.5c0 .8286.6719 1.5 1.5 1.5s1.5-.6714 1.5-1.5v-4.5h4.5c.8281 0 1.5-.6714 1.5-1.5s-.6719-1.5-1.5-1.5z" />
                                  </svg>
                                </span>
                              </div>
                            </a>
                          ) : (
                            <button
                              type="button"
                              class="card-control"
                              data-card-control
                              aria-label={actionLabel}
                              tabindex="0"
                              data-article-open={item.modalId}
                            >
                              {item.href ? (
                                <span class="card-control-href" data-href={item.href} hidden />
                              ) : null}
                              <div class="tile-button-wrapper">
                                <span
                                  class:list={[
                                    'tile-button',
                                    'tile-button-high-contrast',
                                    theme === 'dark' ? 'theme-dark' : 'theme-light',
                                  ]}
                                >
                                  <svg
                                    class="icon-control icon-control-plus tile-icon"
                                    xmlns="http://www.w3.org/2000/svg"
                                    viewBox="0 0 36 36"
                                    aria-hidden="true"
                                  >
                                    <path d="m24 16.5h-4.5v-4.5c0-.8286-.6719-1.5-1.5-1.5s-1.5.6714-1.5 1.5v4.5h-4.5c-.8281 0-1.5.6714-1.5 1.5s.6719 1.5 1.5 1.5h4.5v4.5c0 .8286.6719 1.5 1.5 1.5s1.5-.6714 1.5-1.5v-4.5h4.5c.8281 0 1.5-.6714 1.5-1.5s-.6719-1.5-1.5-1.5z" />
                                  </svg>
                                </span>
                              </div>
                            </button>
                          )
                        ) : null)
                    }
                  </div>
                </li>
              );
            })
          }
        </ul>
      </div>
    </div>

    <!--
      Apple: .scroll-gallery-paddlenav.paddlenav.paddlenav-alpha
      Starts without [hidden]; .hide only when no overflow (JS).
      Position uses static-position absolute (after scroll-container).
    -->
    <div
      class="scroll-gallery-paddlenav paddlenav paddlenav-alpha"
      data-gallery-paddlenav
      data-analytics-gallery-interaction-type="paddlenav"
    >
      <ul>
        <li class="left-item">
          <button
            type="button"
            class="paddlenav-arrow paddlenav-arrow-previous disabled"
            aria-label={`Previous item in ${galleryName}`}
            data-paddlenav="prev"
            data-magnetic
            data-cursor="block"
            disabled
          >
            <span class="paddlenav-arrow__visual" data-magnetic-visual>
              {/* Same stroke chevrons as DeckSlider / case arrows */}
              <svg width="40" height="40" viewBox="0 0 40 40" aria-hidden="true">
                <path
                  fill="none"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M22.5 12.5 15 20l7.5 7.5"
                />
              </svg>
            </span>
          </button>
        </li>
        <li class="right-item">
          <button
            type="button"
            class="paddlenav-arrow paddlenav-arrow-next"
            aria-label={`Next item in ${galleryName}`}
            data-paddlenav="next"
            data-magnetic
            data-cursor="block"
          >
            <span class="paddlenav-arrow__visual" data-magnetic-visual>
              <svg width="40" height="40" viewBox="0 0 40 40" aria-hidden="true">
                <path
                  fill="none"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17.5 12.5 25 20l-7.5 7.5"
                />
              </svg>
            </span>
          </button>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  /*
   * Layout + tokens mapped from Apple overview.built.css
   * (scroll-gallery, paddlenav-alpha, card-hover, tile-button).
   */
  .scroll-gallery-section {
    /* Content measure (Apple ~980–1024) */
    --global-content-max-width: 980px;
    --sg-content-width: 87.5%;
    --feature-card-width: 372px;
    --feature-card-min-height: 387px;
    --feature-card-copy-padding: 32px;
    --feature-card-gap: 20px;
    --sk-tile-border-radius: 28px;
    --sk-tile-background: #ffffff;
    --feature-card-copy-color: #1d1d1f;
    --feature-card-body-color: #6e6e73;
    --sg-section-bg: #f5f5f7;
    --card-element-scale: 1.02;
    /* paddlenav-alpha (light) */
    --sk-paddlenav-diameter: 36px;
    --sk-paddlenav-arrow-color: rgba(0, 0, 0, 0.56);
    --sk-paddlenav-arrow-color-hover: rgba(0, 0, 0, 0.64);
    --sk-paddlenav-arrow-color-active: rgba(0, 0, 0, 0.64);
    --sk-paddlenav-background: rgba(210, 210, 215, 0.64);
    --sk-paddlenav-background-hover: rgba(223, 223, 227, 0.7);
    --sk-paddlenav-background-active: rgba(193, 193, 198, 0.65);
    --staggered-translate-y: 40px;
    --sg-ease: cubic-bezier(0.28, 0.11, 0.32, 1);
    --card-hover-ease: cubic-bezier(0, 0, 0.5, 1);
    position: relative;
    z-index: 1;
    width: 100%;
    padding: 80px 0 56px;
    background: var(--sg-section-bg);
    color: var(--feature-card-copy-color);
    /* allow card scale + paddlenav */
    overflow: visible;
  }

  .scroll-gallery-section.theme-dark {
    --sg-section-bg: #000000;
    --sk-tile-background: #161617;
    --feature-card-copy-color: hsla(0, 0%, 100%, 0.92);
    --feature-card-body-color: hsla(0, 0%, 100%, 0.56);
    --sk-paddlenav-arrow-color: rgba(255, 255, 255, 0.8);
    --sk-paddlenav-arrow-color-hover: rgb(255, 255, 255);
    --sk-paddlenav-arrow-color-active: rgb(255, 255, 255);
    --sk-paddlenav-background: rgba(66, 66, 69, 0.72);
    --sk-paddlenav-background-hover: rgba(73, 73, 76, 0.73);
    --sk-paddlenav-background-active: rgba(57, 57, 60, 0.74);
  }

  @media (max-width: 1068px) {
    .scroll-gallery-section {
      --feature-card-width: 344px;
      --feature-card-min-height: 356px;
      --feature-card-copy-padding: 28px;
      --sk-tile-border-radius: 22px;
    }
  }

  @media (max-width: 734px) {
    .scroll-gallery-section {
      --feature-card-width: 260px;
      --feature-card-min-height: 255px;
      --feature-card-copy-padding: 24px;
      --feature-card-gap: 12px;
      --sk-tile-border-radius: 18px;
      padding-block: 48px 40px;
    }

    /* Articles gallery: ~30% taller than base mobile (255 → 337) */
    .scroll-gallery-section--articles {
      --feature-card-min-height: 337px;
    }
  }

  .scroll-gallery:not(.short) {
    --feature-card-min-height: 680px;
  }

  @media (max-width: 1068px) {
    .scroll-gallery:not(.short) {
      --feature-card-min-height: 628px;
    }
  }

  @media (max-width: 734px) {
    .scroll-gallery:not(.short) {
      --feature-card-min-height: 480px;
    }
  }

  /* —— Header —— */
  .section-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px 24px;
    width: min(var(--global-content-max-width), var(--sg-content-width));
    margin: 0 auto 40px;
  }

  .section-header-headline {
    margin: 0;
    max-width: 12em;
    font-family:
      'SF Pro Display',
      'SF Pro Text',
      -apple-system,
      BlinkMacSystemFont,
      'Helvetica Neue',
      Helvetica,
      Arial,
      sans-serif;
    font-size: clamp(28px, 4.2vw, 48px);
    font-weight: 600;
    line-height: 1.08349;
    letter-spacing: -0.003em;
    color: var(--feature-card-copy-color);
  }

  .section-header-cta {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    font-family:
      'SF Pro Text',
      -apple-system,
      BlinkMacSystemFont,
      'Helvetica Neue',
      Helvetica,
      Arial,
      sans-serif;
    font-size: 17px;
    font-weight: 400;
    line-height: 1.235;
    color: #06c;
    text-decoration: none;
    white-space: nowrap;
  }

  .theme-dark .section-header-cta {
    color: #2997ff;
  }

  .section-header-cta:hover {
    text-decoration: underline;
  }

  .section-header-cta-chevron {
    display: inline-block;
    width: 1em;
    height: 1em;
    font-size: 1.05em;
    margin-inline-start: 2px;
    vertical-align: -0.12em;
    color: currentColor;
    pointer-events: none;
  }

  /* —— Gallery shell —— */
  .scroll-gallery {
    --paddlenav-height: 44px;
    --paddlenavs-width: 90px;
    --paddlenav-padding: 24px;
    --responsive-content-width: 87.5%;
    --responsive-content-max-width: var(--global-content-max-width);
    --responsive-content-clamped-width: min(
      var(--responsive-content-max-width),
      var(--responsive-content-width)
    );
    --responsive-gutter-width: calc(50% - var(--responsive-content-clamped-width) / 2);
    position: relative;
    margin-top: 0;
  }

  .scroll-container {
    position: relative;
    overflow-x: auto;
    /* note: overflow-x:auto forces overflow-y to auto — pad for scale hover */
    scrollbar-width: none;
    scroll-snap-type: x mandatory;
    scroll-padding: var(--responsive-gutter-width);
    padding: 20px 0 28px;
    margin: -12px 0 0;
    -webkit-overflow-scrolling: touch;
    cursor: grab;
  }

  .scroll-container.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    user-select: none;
  }

  .scroll-container::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
  }

  .item-container {
    /* fit-content so scrollWidth grows with cards (critical for paddlenav) */
    display: block;
    width: max-content;
    min-width: 100%;
    padding: 0 var(--responsive-gutter-width);
    box-sizing: border-box;
  }

  .card-set {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: stretch;
    width: max-content;
    gap: var(--feature-card-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gallery-item {
    scroll-snap-align: start;
    flex: 0 0 var(--feature-card-width);
    width: var(--feature-card-width);
    min-width: var(--feature-card-width);
    max-width: var(--feature-card-width);
    list-style: none;
    /* scale hover must not clip */
    overflow: visible;
  }

  .gallery-item:last-child {
    scroll-snap-align: start end;
  }

  /* Quote / testimonial cards — portfolio layout, all visible (no dim) */
  .gallery-item--quote {
    /* ~2/3 of prior 600px / 85–72vw → more vertical cards */
    --quote-card-width: min(57vw, 400px);
    flex: 0 0 var(--quote-card-width);
    width: var(--quote-card-width);
    min-width: var(--quote-card-width);
    max-width: var(--quote-card-width);
    /* Stretch row (card-set align-items: stretch) → equal-height cards */
    display: flex;
    flex-direction: column;
    align-self: stretch;
  }

  /* Educational social posts — portrait image-first cards */
  .gallery-item--social {
    --social-card-width: min(52vw, 280px);
    flex: 0 0 var(--social-card-width);
    width: var(--social-card-width);
    min-width: var(--social-card-width);
    max-width: var(--social-card-width);
  }

  @media (min-width: 810px) {
    .gallery-item--quote {
      --quote-card-width: min(48vw, 400px);
    }

    .gallery-item--social {
      --social-card-width: min(32vw, 300px);
    }
  }

  .scroll-gallery-section--social {
    --feature-card-min-height: 0;
    padding-block: 16px 24px;
  }

  /*
   * Must beat `.feature-card .card { height: var(--feature-card-min-height) }`
   * (0 for social) — otherwise aspect-ratio never resolves and cards collapse
   * to 0 height (broken crypto-bros educational posts slider).
   */
  .feature-card .card.card--social {
    position: relative;
    min-height: 0;
    height: auto;
    aspect-ratio: 0.75;
    background: var(--color-surface, #131219);
  }

  .feature-card-content--social {
    position: relative;
